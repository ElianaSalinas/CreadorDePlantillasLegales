  file_change {
    absolute_path_uri: "file:///src/core/sampleData.ts"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "    clauses: [],\n    rules: [],\n    versions: [],\n  },\n];"
      replacement_content: "    clauses: [],\n    rules: [],\n    versions: [],\n  },\n];\n\nexport const INITIAL_GENERATED_DOCUMENTS = [\n  {\n    id: \'doc_alquiler_bella_vista_2026\',\n    templateId: \'tpl_alquiler_residencial_rd\',\n    templateName: \'Contrato de Alquiler Residencial (RD)\',\n    title: \'Contrato de Alquiler - Apto 402 Bella Vista (Marcos Cabrera / Juan P\303\251rez)\',\n    createdAt: \'2026-08-14T15:30:00Z\',\n    format: \'DOCX\' as const,\n    status: \'NOTARIADO\' as const,\n    author: \'Lic. Stephania Montero (Notaria P\303\272blica \342\200\242 CARD 14092)\',\n    valuesSnapshot: {\n      propietario_nombre: \'Marcos Miguel Cabrera D\303\255az\',\n      propietario_nacionalidad: \'dominicana\',\n      propietario_cedula: \'001-0894561-2\',\n      propietario_direccion: \'Calle Los Prados No. 45, Ensanche Bella Vista, Santo Domingo, D.N.\',\n      inquilino_nombre: \'Ing. Juan Carlos P\303\251rez Alm\303\241nzar\',\n      inquilino_nacionalidad: \'dominicana\',\n      inquilino_cedula: \'001-1498321-7\',\n      inquilino_direccion: \'Av. Sarasota No. 102, Edif. Torre del Parque, Apto 402, Santo Domingo, D.N.\',\n      inmueble_direccion: \'Calle Las Palmas No. 12, Apto 402, Bella Vista, Distrito Nacional\',\n      renta_mensual_monto: \'RD$ 45,000.00\',\n      renta_mensual_letras: \'CUARENTA Y CINCO MIL PESOS DOMINICANOS CON 00/100\',\n      dias_gracia: 5,\n      duracion_meses: 12,\n      fecha_inicio: \'01 de septiembre de 2026\',\n      fecha_fin: \'31 de agosto de 2027\',\n      dias_preaviso_terminacion: 60,\n      deposito_garantia_monto: \'RD$ 90,000.00\',\n      deposito_garantia_letras: \'NOVENTA MIL PESOS DOMINICANOS CON 00/100\',\n      meses_deposito: 2,\n      mantenimiento_monto: \'RD$ 4,500.00\',\n      mantenimiento_letras: \'CUATRO MIL QUINIENTOS PESOS DOMINICANOS CON 00/100\',\n      porcentaje_mora: 5,\n      distrito_judicial: \'Distrito Nacional\',\n      ciudad_firma: \'Santo Domingo, Distrito Nacional\',\n      fecha_firma_notarial: \'a los catorce (14) d\303\255as del mes de agosto del a\303\261o dos mil veintis\303\251is (2026)\',\n    },\n    renderedContent: `CONTRATO DE ARRENDAMIENTO DE VIVIENDA URBANA\n\nENTRE:\n\nDe una parte, Marcos Miguel Cabrera D\303\255az, de nacionalidad dominicana, mayor de edad, titular de la C\303\251dula de Identidad y Electoral No. 001-0894561-2, domiciliado y residente en Calle Los Prados No. 45, Ensanche Bella Vista, Santo Domingo, D.N., a quien en lo que sigue del presente contrato se denominar\303\241 EL PROPIETARIO o LA PRIMERA PARTE;\n\nY de la otra parte, Ing. Juan Carlos P\303\251rez Alm\303\241nzar, de nacionalidad dominicana, mayor de edad, titular de la C\303\251dula de Identidad y Electoral No. 001-1498321-7, domiciliado y residente en Av. Sarasota No. 102, Edif. Torre del Parque, Apto 402, Santo Domingo, D.N., a quien en lo sucesivo se denominar\303\241 EL INQUILINO o LA SEGUNDA PARTE.\n\nSE HA CONVENIDO Y PACTADO LO SIGUIENTE:\n\nPRIMERO: OBJETO DEL CONTRATO: EL PROPIETARIO concede en calidad de alquiler a EL INQUILINO, quien acepta conforme, el inmueble ubicado en: Calle Las Palmas No. 12, Apto 402, Bella Vista, Distrito Nacional, el cual ser\303\241 destinado exclusivamente para vivienda familiar del inquilino y sus dependientes directos.\n\nSEGUNDO: PRECIO DEL ALQUILER: El precio mensual del arrendamiento pactado libremente entre las partes es de RD$ 45,000.00 (CUARENTA Y CINCO MIL PESOS DOMINICANOS CON 00/100), pagaderos por mensualidades adelantadas dentro de los primeros 5 d\303\255as de cada mes mediante transferencia bancaria o pago directo.\n\nTERCERO: VIGENCIA Y T\303\211RMINO: El presente contrato tendr\303\241 una duraci\303\263n de 12 meses, iniciando en fecha 01 de septiembre de 2026 y finalizando en fecha 31 de agosto de 2027, renovable por mutuo acuerdo escrito entre las partes con no menos de 60 d\303\255as de anticipaci\303\263n.\n\nCUARTO: DE LOS DEP\303\223SITOS DE GARANT\303\215A: EL INQUILINO entrega en este acto a EL PROPIETARIO la suma de RD$ 90,000.00 (NOVENTA MIL PESOS DOMINICANOS CON 00/100), equivalente a 2 meses de dep\303\263sito de garant\303\255a, el cual ser\303\241 retenido como fianza para responder por da\303\261os a la propiedad o incumplimientos de pago de servicios seg\303\272n las disposiciones de la Ley No. 4314 de la Rep\303\272blica Dominicana. Dicho monto no podr\303\241 ser imputado al pago de mensualidades corrientes.\n\nQUINTO: CUOTA DE MANTENIMIENTO: La cuota mensual ordinaria de mantenimiento del condominio asciende a la suma de RD$ 4,500.00 (CUATRO MIL QUINIENTOS PESOS DOMINICANOS CON 00/100), la cual correr\303\241 por cuenta de EL INQUILINO y deber\303\241 ser cancelada puntualmente junto con la renta mensual para el sostenimiento de las \303\241reas comunes conforme a la Ley No. 5038 de Condominios.\n\nSEXTO: DE LA MORA EN EL PAGO: Las partes convienen expresamente que la falta de pago de la mensualidad convenida dentro de los primeros 5 d\303\255as de cada mes generar\303\241 un recargo moratorio mensual del 5% calculado sobre el monto adeudado, sin necesidad de requerimiento o intimaci\303\263n judicial previa.\n\nS\303\211PTIMO: DE LA JURISDICCI\303\223N COMPETENTE: Para la ejecuci\303\263n del presente contrato y de todas sus consecuencias legales, las partes eligen domicilio en las direcciones indicadas al encabezado y convienen expresamente someter cualquier diferendo o litis a la jurisdicci\303\263n y competencia territorial de los Tribunales Ordinarios de la Rep\303\272blica Dominicana correspondientes al Distrito Nacional, con renuncia expresa a cualquier otro fuero que pudiera corresponderles.\n\nHECHO Y FIRMADO en dos (2) originales de un mismo tenor y efecto, en Santo Domingo, Distrito Nacional, Rep\303\272blica Dominicana, a los catorce (14) d\303\255as del mes de agosto del a\303\261o dos mil veintis\303\251is (2026).\n\n\n________________________________________\nMarcos Miguel Cabrera D\303\255az\nEL PROPIETARIO\nC\303\251dula: 001-0894561-2\n\n\n________________________________________\nIng. Juan Carlos P\303\251rez Alm\303\241nzar\nEL INQUILINO\nC\303\251dula: 001-1498321-7\n\n\nACTO DE LEGALIZACI\303\223N DE FIRMAS (LEGALIZACI\303\223N NOTARIAL)\nEn la ciudad de Santo Domingo, Distrito Nacional, Capital de la Rep\303\272blica Dominicana, a los catorce (14) d\303\255as del mes de agosto del a\303\261o dos mil veintis\303\251is (2026), por ante m\303\255, LIC. STEPHANIA MONTERO, Notario P\303\272blico de los del N\303\272mero del Distrito Nacional, Matr\303\255cula del Colegio de Notarios No. 14092, COMPARECIERON libre y voluntariamente los se\303\261ores MARCOS MIGUEL CABRERA D\303\215AZ e ING. JUAN CARLOS P\303\211REZ ALM\303\201NZAR, de generales constantes precedentemente, a quienes doy fe conocer, y me declararon bajo la fe del juramento que las firmas estampadas en el presente contrato fueron puestas por ellos de sus propios pu\303\261os y letras, por lo que debe d\303\241rseles entera fe y cr\303\251dito. DOY FE.`,\n  },\n  {\n    id: \'doc_pagare_notarial_2026\',\n    templateId: \'tpl_pagare_notarial_rd\',\n    templateName: \'Pagar\303\251 Notarial con Garant\303\255a Aut\303\251ntica\',\n    title: \'Pagar\303\251 Notarial - Pr\303\251stamo Comercial Inversiones Quisqueya SRL (RD$ 2,500,000.00)\',\n    createdAt: \'2026-08-12T10:15:00Z\',\n    format: \'PDF\' as const,\n    status: \'EMITIDO\' as const,\n    author: \'Lic. Stephania Montero (Notaria P\303\272blica \342\200\242 CARD 14092)\',\n    valuesSnapshot: {\n      deudor_nombre: \'Inversiones Quisqueya SRL (Rep. por Ing. Roberto Santana)\',\n      deudor_cedula: \'001-0549821-3\',\n      deudor_direccion: \'Av. Winston Churchill No. 71, Torre Empresarial, Santo Domingo\',\n      acreedor_nombre: \'Banco Corporativo Dominicano S.A.\',\n      acreedor_rnc: \'1-01-84932-1\',\n      monto_capital_numero: \'RD$ 2,500,000.00\',\n      monto_capital_letras: \'DOS MILLONES QUINIENTOS MIL PESOS DOMINICANOS CON 00/100\',\n      tasa_interes_anual: 14.5,\n      plazo_meses: 36,\n      cuota_mensual: \'RD$ 86,120.45\',\n      fecha_primer_pago: \'15 de septiembre de 2026\',\n      garantia_descripcion: \'Hipoteca en primer rango sobre el inmueble matr\303\255cula No. 30894812, ubicado en Piantini, D.N.\',\n      ciudad_notaria: \'Santo Domingo, Distrito Nacional\',\n    },\n    renderedContent: `PAGAR\303\211 NOTARIAL CON FUERZA EJECUTORIA\n(Ley No. 140-15 del Notariado Dominicano y Arts. 545 y siguientes del C\303\263digo de Procedimiento Civil)\n\nACTO N\303\232MERO: 184/2026\n\nEn la ciudad de Santo Domingo, Distrito Nacional, a los doce (12) d\303\255as del mes de agosto del a\303\261o dos mil veintis\303\251is (2026);\n\nPOR ANTE M\303\215, LIC. STEPHANIA MONTERO, dominicana, mayor de edad, Abogada, Notario P\303\272blico de los del N\303\272mero del Distrito Nacional, con estudio profesional abierto en la Av. Abraham Lincoln No. 1002, Torre Ejecutiva, Suite 604, Distrito Nacional, titular de la C\303\251dula de Identidad y Electoral No. 001-1827364-9, colegiada en el Colegio Dominicano de Notarios bajo la Matr\303\255cula No. 14092;\n\nCOMPARECI\303\223 LIBRE Y VOLUNTARIAMENTE:\n\nDe una parte, la entidad comercial INVERSIONES QUISQUEYA SRL, sociedad organizada y existente de conformidad con las leyes de la Rep\303\272blica Dominicana, titular del RNC No. 1-31-09876-5, con su domicilio social principal en la Av. Winston Churchill No. 71, Torre Empresarial, debidamente representada por su Gerente General, el ING. ROBERTO SANTANA, dominicano, mayor de edad, titular de la C\303\251dula de Identidad y Electoral No. 001-0549821-3, quien en lo sucesivo se denominar\303\241 LA PARTE DEUDORA;\n\nY declara LA PARTE DEUDORA que mediante el presente acto aut\303\251ntico SE RECONOCE DEUDORA PURA Y SIMPLE, por la v\303\255a notarial y con renuncia a toda excepci\303\263n, a favor de BANCO CORPORATIVO DOMINICANO S.A. (EL ACREEDOR), por la suma l\303\255quida, cierta y exigible de RD$ 2,500,000.00 (DOS MILLONES QUINIENTOS MIL PESOS DOMINICANOS CON 00/100), suma que recibi\303\263 a su entera satisfacci\303\263n en calidad de pr\303\251stamo comercial.\n\nCL\303\201USULA PRIMERA: OBLIGACI\303\223N DE PAGO E INTERESES: LA PARTE DEUDORA se obliga a pagar la suma antes indicada en un plazo de treinta y seis (36) meses, devengando un inter\303\251s anual fijo del catorce punto cinco por ciento (14.5%) sobre saldos insolutos, pagadero en cuotas mensuales y consecutivas de RD$ 86,120.45, pagaderas los d\303\255as quince (15) de cada mes, iniciando el 15 de septiembre de 2026.\n\nCL\303\201USULA SEGUNDA: FUERZA EJECUTORIA NOTARIAL: Por el presente acto, de conformidad con lo establecido en el Art\303\255culo 545 del C\303\263digo de Procedimiento Civil y el Art\303\255culo 51 de la Ley 140-15, el presente acto notarial TIENE FUERZA EJECUTORIA PLENA y servir\303\241 como t\303\255tulo aut\303\251ntico suficiente para trabar cualquier embargo ejecutivo, inmobiliario o retentivo sin necesidad de previa sentencia judicial.\n\nDOY FE Y CERTIFICO haber le\303\255do \303\255ntegramente este acto a los comparecientes, quienes lo aprueban y firman conmigo y ante m\303\255, Notario que certifico.`,\n  },\n  {\n    id: \'doc_poder_especial_2026\',\n    templateId: \'tpl_poder_especial_rd\',\n    templateName: \'Poder Especial Notarial Inmobiliario\',\n    title: \'Poder Especial Notarial - Traspaso T\303\255tulo Registro No. 3409 (Carlos Medina a Lic. Rafael Cruz)\',\n    createdAt: \'2026-08-10T11:00:00Z\',\n    format: \'DOCX\' as const,\n    status: \'BORRADOR\' as const,\n    author: \'Lic. Stephania Montero (Notaria P\303\272blica \342\200\242 CARD 14092)\',\n    valuesSnapshot: {\n      poderdante_nombre: \'Carlos Manuel Medina G\303\263mez\',\n      poderdante_cedula: \'001-0983214-0\',\n      poderdante_direccion: \'Calle Restauraci\303\263n No. 88, Santiago de los Caballeros\',\n      apoderado_nombre: \'Lic. Rafael Emilio Cruz Castillo\',\n      apoderado_cedula: \'001-1239874-5\',\n      apoderado_direccion: \'Av. 27 de Febrero No. 340, Santo Domingo\',\n      facultades_especificas: \'Solicitar certificaciones de IPI, pagar impuestos de transferencia inmobiliaria, retirar duplicados de t\303\255tulos de propiedad y suscribir actos de traspaso definitivo.\',\n      ciudad_firma: \'Santo Domingo\',\n      fecha_firma: \'10 de agosto de 2026\',\n    },\n    renderedContent: `PODER ESPECIAL DE REPRESENTACI\303\223N INMOBILIARIA Y TRAMITACI\303\223N DE T\303\215TULOS\n\nEn la ciudad de Santo Domingo, Rep\303\272blica Dominicana, a los diez (10) d\303\255as del mes de agosto del a\303\261o dos mil veintis\303\251is (2026);\n\nPOR CUANTO: El se\303\261or CARLOS MANUEL MEDINA G\303\223MEZ, dominicano, mayor de edad, soltero, portador de la C\303\251dula de Identidad y Electoral No. 001-0983214-0, domiciliado en Calle Restauraci\303\263n No. 88, Santiago de los Caballeros (EL PODERDANTE);\n\nCONFIERE PODER ESPECIAL, TAN AMPLIO, BASTANTE Y SUFICIENTE COMO EN DERECHO SEA MENESTER, a favor del LIC. RAFAEL EMILIO CRUZ CASTILLO, dominicano, mayor de edad, Abogado de los Tribunales de la Rep\303\272blica Dominicana, portador de la C\303\251dula No. 001-1239874-5, domiciliado en Av. 27 de Febrero No. 340, Santo Domingo (EL APODERADO), para que en su nombre y representaci\303\263n ejecute los siguientes actos:\n\n1. Tramitar ante el Registro de T\303\255tulos y la Direcci\303\263n General de Impuestos Internos (DGII) el traspaso definitivo y liquidaci\303\263n del impuesto de transferencia inmobiliaria relativo al inmueble identificado con la designaci\303\263n catastral No. 3409.\n2. Solicitar certificaciones de estado jur\303\255dico, certificaciones de IPI y retirar duplicados oficiales del due\303\261o.\n\nHECHO Y FIRMADO en la fecha arriba se\303\261alada.\n\n____________________________________\nCARLOS MANUEL MEDINA G\303\223MEZ\nPoderdante`,\n  },\n];\n"
    }
