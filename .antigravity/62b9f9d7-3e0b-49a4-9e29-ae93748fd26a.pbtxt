  file_change {
    absolute_path_uri: "file:///src/components/GoogleFormsTemplateEditor.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  Plus,\n  Trash2,\n  Copy,\n  ChevronUp,\n  ChevronDown,\n  Sparkles,\n  Layers,\n  FileText,\n  CreditCard,\n  Building,\n  Calendar,\n  ToggleLeft,\n  ToggleRight,\n  HelpCircle,\n  FolderPlus,\n  CheckCircle2,\n  BookOpen,\n  Settings,\n  Scale,\n} from \'lucide-react\';\nimport { useAppStore } from \'../store/useAppStore\';\nimport { TemplateVariable, VariableDataType } from \'../types\';\n\ninterface GoogleFormsTemplateEditorProps {\n  onInsertVariableInContent?: (tag: string) => void;\n}\n\nexport const GoogleFormsTemplateEditor: React.FC<GoogleFormsTemplateEditorProps> = ({\n  onInsertVariableInContent,\n}) => {\n  const { activeTemplate, updateTemplate, addVariable, removeVariable, updateVariable, state } =\n    useAppStore();\n\n  const [activeQuestionId, setActiveQuestionId] = useState<string | null>(null);\n\n  if (!activeTemplate) return null;\n\n  const variables = activeTemplate.variables || [];\n\n  // Group variables by category/section\n  const sections = [\n    {\n      id: \'parties\',\n      title: \'1. Comparecientes y Partes del Contrato\',\n      description: \'Nombres, C\303\251dulas JCE, RNC, calidades jur\303\255dicas y domicilios de los firmantes.\',\n      filter: (v: TemplateVariable) =>\n        v.tag.includes(\'inquilino\') ||\n        v.tag.includes(\'propietario\') ||\n        v.tag.includes(\'comprador\') ||\n        v.tag.includes(\'vendedor\') ||\n        v.tag.includes(\'arrendador\') ||\n        v.tag.includes(\'arrendatario\') ||\n        v.tag.includes(\'notario\') ||\n        v.tag.includes(\'cedula\') ||\n        v.tag.includes(\'rnc\') ||\n        v.tag.includes(\'nombre\') ||\n        v.tag.includes(\'parte\'),\n    },\n    {\n      id: \'object\',\n      title: \'2. Objeto del Contrato e Inmueble\',\n      description: \'Direcci\303\263n, designaci\303\263n catastral, linderos y especificaciones del bien.\',\n      filter: (v: TemplateVariable) =>\n        v.tag.includes(\'inmueble\') ||\n        v.tag.includes(\'direccion\') ||\n        v.tag.includes(\'matricula\') ||\n        v.tag.includes(\'catastral\') ||\n        v.tag.includes(\'destino\') ||\n        v.tag.includes(\'objeto\'),\n    },\n    {\n      id: \'financial\',\n      title: \'3. Condiciones Econ\303\263micas, Precios y Plazos\',\n      description: \'Monto del contrato, moneda, dep\303\263sito de fianza y fecha de vigencia.\',\n      filter: (v: TemplateVariable) =>\n        v.dataType === \'currency\' ||\n        v.tag.includes(\'precio\') ||\n        v.tag.includes(\'alquiler\') ||\n        v.tag.includes(\'monto\') ||\n        v.tag.includes(\'fianza\') ||\n        v.tag.includes(\'deposito\') ||\n        v.tag.includes(\'plazo\') ||\n        v.tag.includes(\'dia_pago\') ||\n        v.tag.includes(\'fecha\'),\n    },\n  ];\n\n  // Helper to create a new variable in Google Forms format\n  const handleAddQuestion = (dataType: VariableDataType = \'string\') => {\n    const count = variables.length + 1;\n    const baseTag = `nuevo_campo_${count}`;\n    const newVar: TemplateVariable = {\n      id: `var_${Date.now()}`,\n      tag: baseTag,\n      label: `Nuevo Campo ${count}`,\n      dataType,\n      required: true,\n      defaultValue: \'\',\n      currency: dataType === \'currency\' ? \'DOP\' : undefined,\n    };\n    addVariable(activeTemplate.id, newVar);\n    setActiveQuestionId(newVar.id);\n  };\n\n  const handleDuplicateQuestion = (v: TemplateVariable) => {\n    const newVar: TemplateVariable = {\n      ...v,\n      id: `var_${Date.now()}`,\n      tag: `${v.tag}_copia`,\n      label: `${v.label} (Copia)`,\n    };\n    addVariable(activeTemplate.id, newVar);\n    setActiveQuestionId(newVar.id);\n  };\n\n  const handleTypeChange = (id: string, newType: VariableDataType) => {\n    updateVariable(activeTemplate.id, id, {\n      dataType: newType,\n      currency: newType === \'currency\' ? \'DOP\' : undefined,\n    });\n  };\n\n  return (\n    <div className=\"flex-1 overflow-y-auto overflow-x-hidden p-4 sm:p-6 bg-slate-100/80 max-w-4xl mx-auto w-full space-y-6\">\n      {/* Google Forms-Style Header Banner */}\n      <div className=\"bg-white rounded-xl shadow-xs border border-slate-200 overflow-hidden relative border-t-8 border-t-blue-600\">\n        <div className=\"p-6 sm:p-8 space-y-4\">\n          <div>\n            <div className=\"flex items-center space-x-2 text-xs font-semibold text-blue-600 uppercase tracking-wider\">\n              <Scale className=\"w-4 h-4\" />\n              <span>Plantilla Jur\303\255dica Asistida \342\200\242 Rep\303\272blica Dominicana</span>\n            </div>\n            <input\n              type=\"text\"\n              value={activeTemplate.name}\n              onChange={(e) => updateTemplate(activeTemplate.id, { name: e.target.value })}\n              className=\"text-2xl sm:text-3xl font-serif font-bold text-slate-900 border-b border-transparent hover:border-slate-300 focus:border-blue-600 focus:outline-none w-full mt-2 pb-1\"\n              placeholder=\"T\303\255tulo del Formulario Legal...\"\n            />\n          </div>\n\n          <textarea\n            value={activeTemplate.description || \'\'}\n            onChange={(e) => updateTemplate(activeTemplate.id, { description: e.target.value })}\n            placeholder=\"Descripci\303\263n e instrucciones para paralegales, abogados y operadores que llenar\303\241n este formulario...\"\n            rows={2}\n            className=\"w-full text-xs sm:text-sm text-slate-600 border-b border-transparent hover:border-slate-300 focus:border-blue-600 focus:outline-none resize-none\"\n          />\n\n          <div className=\"pt-2 flex flex-wrap items-center gap-3 text-xs text-slate-500 border-t border-slate-100\">\n            <span className=\"flex items-center space-x-1 font-medium text-slate-700\">\n              <Layers className=\"w-3.5 h-3.5 text-blue-600\" />\n              <span>{variables.length} Campos Definidos</span>\n            </span>\n            <span>\342\200\242</span>\n            <span className=\"flex items-center space-x-1 font-medium text-slate-700\">\n              <BookOpen className=\"w-3.5 h-3.5 text-indigo-600\" />\n              <span>{activeTemplate.clauses.length} Cl\303\241usulas Vinculadas</span>\n            </span>\n            <span>\342\200\242</span>\n            <span className=\"text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full font-semibold border border-emerald-200\">\n              Validaci\303\263n JCE / DGII Activa\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* Floating Add Question Quick Bar */}\n      <div className=\"bg-white rounded-xl p-3 shadow-xs border border-slate-200 flex flex-wrap items-center justify-between gap-2\">\n        <span className=\"text-xs font-semibold text-slate-700 flex items-center space-x-1.5 pl-2\">\n          <Plus className=\"w-4 h-4 text-blue-600\" />\n          <span>A\303\261adir Nuevo Campo al Formulario:</span>\n        </span>\n\n        <div className=\"flex items-center space-x-1.5 flex-wrap\">\n          <button\n            onClick={() => handleAddQuestion(\'string\')}\n            className=\"px-2.5 py-1 text-xs bg-slate-50 hover:bg-blue-50 text-slate-700 hover:text-blue-700 rounded-lg border border-slate-200 font-medium transition-colors\"\n          >\n            + Texto Corto\n          </button>\n          <button\n            onClick={() => handleAddQuestion(\'currency\')}\n            className=\"px-2.5 py-1 text-xs bg-slate-50 hover:bg-emerald-50 text-slate-700 hover:text-emerald-700 rounded-lg border border-slate-200 font-medium transition-colors\"\n          >\n            + Monto (RD$)\n          </button>\n          <button\n            onClick={() => handleAddQuestion(\'date\')}\n            className=\"px-2.5 py-1 text-xs bg-slate-50 hover:bg-purple-50 text-slate-700 hover:text-purple-700 rounded-lg border border-slate-200 font-medium transition-colors\"\n          >\n            + Fecha\n          </button>\n          <button\n            onClick={() => handleAddQuestion(\'boolean\')}\n            className=\"px-2.5 py-1 text-xs bg-slate-50 hover:bg-amber-50 text-slate-700 hover:text-amber-700 rounded-lg border border-slate-200 font-medium transition-colors\"\n          >\n            + Opci\303\263n S\303\255/No\n          </button>\n        </div>\n      </div>\n\n      {/* Question Cards (Google Forms Style) */}\n      <div className=\"space-y-4\">\n        {variables.length === 0 ? (\n          <div className=\"bg-white rounded-xl p-12 text-center border border-dashed border-slate-300\">\n            <Layers className=\"w-12 h-12 text-slate-300 mx-auto mb-3\" />\n            <h3 className=\"text-sm font-semibold text-slate-800\">No hay campos en el formulario</h3>\n            <p className=\"text-xs text-slate-500 mt-1 max-w-md mx-auto\">\n              Comienza agregando las preguntas y campos requeridos para estructurar este contrato legal.\n            </p>\n            <button\n              onClick={() => handleAddQuestion(\'string\')}\n              className=\"mt-4 px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold rounded-lg shadow-sm transition-colors\"\n            >\n              + Agregar primer campo\n            </button>\n          </div>\n        ) : (\n          variables.map((v, index) => {\n            const isActive = activeQuestionId === v.id;\n\n            return (\n              <div\n                key={v.id}\n                onClick={() => setActiveQuestionId(v.id)}\n                className={`bg-white rounded-xl shadow-xs border transition-all duration-150 overflow-hidden relative ${\n                  isActive\n                    ? \'border-blue-500 ring-2 ring-blue-100 shadow-md\'\n                    : \'border-slate-200 hover:border-slate-300\'\n                }`}\n              >\n                {/* Active Indicator on Left */}\n                {isActive && <div className=\"absolute left-0 top-0 bottom-0 w-1.5 bg-blue-600\" />}\n\n                <div className=\"p-5 sm:p-6 space-y-4\">\n                  {/* Top Row: Question Title + Type Dropdown */}\n                  <div className=\"grid grid-cols-1 sm:grid-cols-12 gap-3 items-start\">\n                    <div className=\"sm:col-span-8\">\n                      <div className=\"flex items-center space-x-2\">\n                        <span className=\"text-xs font-mono font-bold text-slate-400\">#{index + 1}</span>\n                        <input\n                          type=\"text\"\n                          value={v.label}\n                          onChange={(e) => updateVariable(activeTemplate.id, v.id, { label: e.target.value })}\n                          placeholder=\"T\303\255tulo del Campo / Pregunta (ej. Nombre del Arrendador)...\"\n                          className=\"w-full text-sm font-semibold text-slate-800 bg-slate-50/50 hover:bg-slate-50 focus:bg-white border-b-2 border-slate-200 focus:border-blue-600 focus:outline-none p-2 rounded-t transition-colors\"\n                        />\n                      </div>\n                    </div>\n\n                    <div className=\"sm:col-span-4\">\n                      <select\n                        value={v.dataType}\n                        onChange={(e) => handleTypeChange(v.id, e.target.value as VariableDataType)}\n                        className=\"w-full text-xs font-medium text-slate-700 bg-slate-50 border border-slate-300 rounded-lg p-2.5 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                      >\n                        <option value=\"string\">\360\237\223\235 Texto Corto / Nombre</option>\n                        <option value=\"currency\">\360\237\222\260 Monto Monetario (RD$/USD)</option>\n                        <option value=\"date\">\360\237\223\205 Fecha Notarial</option>\n                        <option value=\"boolean\">\360\237\224\230 Casilla de Opci\303\263n (S\303\255 / No)</option>\n                        <option value=\"integer\">\360\237\224\242 N\303\272mero Entero</option>\n                        <option value=\"percentage\">\360\237\223\212 Porcentaje (%)</option>\n                      </select>\n                    </div>\n                  </div>\n\n                  {/* Tag & Technical Settings */}\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 bg-slate-50/70 p-3 rounded-lg border border-slate-100\">\n                    <div>\n                      <label className=\"block text-[11px] font-semibold text-slate-500 uppercase tracking-wider mb-1\">\n                        Etiqueta en Contrato:\n                      </label>\n                      <div className=\"flex items-center space-x-1.5\">\n                        <span className=\"text-xs font-mono text-blue-600 bg-blue-50 px-2.5 py-1.5 rounded border border-blue-200 font-bold\">\n                          {`{{${v.tag}}}`}\n                        </span>\n                        <input\n                          type=\"text\"\n                          value={v.tag}\n                          onChange={(e) => updateVariable(activeTemplate.id, v.id, { tag: e.target.value })}\n                          className=\"text-xs font-mono text-slate-700 bg-white border border-slate-200 rounded px-2 py-1.5 focus:outline-none focus:border-blue-500 flex-1\"\n                          placeholder=\"tag_snake_case\"\n                        />\n                      </div>\n                    </div>\n\n                    <div>\n                      <label className=\"block text-[11px] font-semibold text-slate-500 uppercase tracking-wider mb-1\">\n                        Valor Sugerido / Ejemplo:\n                      </label>\n                      <input\n                        type=\"text\"\n                        value={v.defaultValue || \'\'}\n                        onChange={(e) =>\n                          updateVariable(activeTemplate.id, v.id, { defaultValue: e.target.value })\n                        }\n                        placeholder=\"Ej. Juan Carlos P\303\251rez...\"\n                        className=\"w-full text-xs text-slate-700 bg-white border border-slate-200 rounded px-2 py-1.5 focus:outline-none focus:border-blue-500\"\n                      />\n                    </div>\n                  </div>\n\n                  {/* Derived Configuration (e.g. Montos en letras) */}\n                  {v.derivedConfig && (\n                    <div className=\"p-2.5 bg-purple-50 rounded-lg border border-purple-200 flex items-center justify-between text-xs text-purple-900\">\n                      <span className=\"flex items-center space-x-1.5 font-medium\">\n                        <Sparkles className=\"w-3.5 h-3.5 text-purple-600\" />\n                        <span>F\303\263rmula Autom\303\241tica: {v.derivedConfig.type}</span>\n                      </span>\n                      <span className=\"text-[10px] bg-purple-200/80 px-2 py-0.5 rounded font-mono font-semibold\">\n                        Basado en: {v.derivedConfig.sourceVariableTag}\n                      </span>\n                    </div>\n                  )}\n\n                  {/* Bottom Actions Row (Google Forms style: Copy, Trash, Required toggle) */}\n                  <div className=\"pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3\">\n                    <div className=\"flex items-center space-x-3 text-xs text-slate-500\">\n                      {v.dataType === \'currency\' && (\n                        <select\n                          value={v.currency || \'DOP\'}\n                          onChange={(e) =>\n                            updateVariable(activeTemplate.id, v.id, {\n                              currency: e.target.value as \'DOP\' | \'USD\' | \'EUR\',\n                            })\n                          }\n                          className=\"text-xs border border-slate-200 rounded px-2 py-1 bg-white font-semibold text-slate-700\"\n                        >\n                          <option value=\"DOP\">Pesos Dominicanos (RD$)</option>\n                          <option value=\"USD\">D\303\263lares Estadounidenses (US$)</option>\n                          <option value=\"EUR\">Euros (\342\202\254)</option>\n                        </select>\n                      )}\n\n                      {v.tag.toLowerCase().includes(\'cedula\') && (\n                        <span className=\"text-[11px] text-emerald-700 font-semibold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200\">\n                          \342\234\223 Validador JCE M\303\263dulo 10 Activo\n                        </span>\n                      )}\n                      {v.tag.toLowerCase().includes(\'rnc\') && (\n                        <span className=\"text-[11px] text-blue-700 font-semibold bg-blue-50 px-2 py-0.5 rounded border border-blue-200\">\n                          \342\234\223 Validador RNC DGII Activo\n                        </span>\n                      )}\n                    </div>\n\n                    <div className=\"flex items-center space-x-4\">\n                      {/* Duplicate */}\n                      <button\n                        onClick={() => handleDuplicateQuestion(v)}\n                        className=\"p-1.5 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition-colors\"\n                        title=\"Duplicar Campo\"\n                      >\n                        <Copy className=\"w-4 h-4\" />\n                      </button>\n\n                      {/* Delete */}\n                      <button\n                        onClick={() => removeVariable(activeTemplate.id, v.id)}\n                        className=\"p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors\"\n                        title=\"Eliminar Campo\"\n                      >\n                        <Trash2 className=\"w-4 h-4\" />\n                      </button>\n\n                      <div className=\"h-4 w-px bg-slate-200\" />\n\n                      {/* Required Toggle */}\n                      <label className=\"flex items-center space-x-2 text-xs font-semibold text-slate-700 cursor-pointer select-none\">\n                        <span>Obligatorio</span>\n                        <input\n                          type=\"checkbox\"\n                          checked={v.required}\n                          onChange={(e) =>\n                            updateVariable(activeTemplate.id, v.id, { required: e.target.checked })\n                          }\n                          className=\"w-4 h-4 text-blue-600 rounded border-slate-300 focus:ring-blue-500 cursor-pointer\"\n                        />\n                      </label>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            );\n          })\n        )}\n      </div>\n\n      {/* Floating Bottom Add Button */}\n      <div className=\"sticky bottom-4 flex justify-center z-10\">\n        <button\n          onClick={() => handleAddQuestion(\'string\')}\n          className=\"flex items-center space-x-2 px-6 py-3 bg-blue-600 hover:bg-blue-500 text-white rounded-full shadow-lg hover:shadow-xl font-semibold text-xs transition-all transform hover:scale-105\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          <span>A\303\261adir Nuevo Campo al Formulario</span>\n        </button>\n      </div>\n    </div>\n  );\n};\n"
