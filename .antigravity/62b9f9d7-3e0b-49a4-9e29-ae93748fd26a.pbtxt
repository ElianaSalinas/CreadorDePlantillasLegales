  file_change {
    absolute_path_uri: "file:///src/components/DocumentsVault.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  History,\n  Download,\n  Printer,\n  FileText,\n  Search,\n  Trash2,\n  Eye,\n  Calendar,\n  Layers,\n  ChevronRight,\n} from \'lucide-react\';\nimport { useAppStore } from \'../store/useAppStore\';\nimport { GeneratedDocument } from \'../types\';\nimport { generateDocxBlob, generatePdfBlob } from \'../core/exportEngine\';\n\nexport const DocumentsVault: React.FC = () => {\n  const { state, setView } = useAppStore();\n\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [selectedDoc, setSelectedDoc] = useState<GeneratedDocument | null>(\n    state.generatedDocuments[0] || null\n  );\n\n  const filteredDocs = state.generatedDocuments.filter(\n    (d) =>\n      d.title.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      d.templateName.toLowerCase().includes(searchQuery.toLowerCase())\n  );\n\n  const handleDownloadDocx = async (doc: GeneratedDocument) => {\n    const blob = await generateDocxBlob(doc.title, doc.renderedContent);\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\'a\');\n    a.href = url;\n    a.download = `${doc.title.replace(/[^a-zA-Z0-9_-]/g, \'_\')}.docx`;\n    a.click();\n    URL.revokeObjectURL(url);\n  };\n\n  const handleDownloadPdf = (doc: GeneratedDocument) => {\n    const blob = generatePdfBlob(doc.title, doc.renderedContent);\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\'a\');\n    a.href = url;\n    a.download = `${doc.title.replace(/[^a-zA-Z0-9_-]/g, \'_\')}.pdf`;\n    a.click();\n    URL.revokeObjectURL(url);\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6\">\n      {/* Top Banner */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-6 rounded-2xl shadow-xs border border-slate-200\">\n        <div>\n          <div className=\"flex items-center space-x-2\">\n            <span className=\"text-xs font-semibold text-blue-600 uppercase tracking-wider bg-blue-50 px-2.5 py-0.5 rounded-md border border-blue-100\">\n              Historial de Documentos Generados (US-52..US-55)\n            </span>\n            <span className=\"text-xs text-slate-400 font-mono\">\n              Total: {state.generatedDocuments.length}\n            </span>\n          </div>\n          <h1 className=\"text-2xl font-bold text-slate-900 font-serif mt-1\">B\303\263veda de Documentos Legales</h1>\n          <p className=\"text-slate-500 text-xs mt-1\">\n            Hist\303\263rico inmutable de contratos redactados con snapshot de respuestas y descargas en DOCX y PDF.\n          </p>\n        </div>\n\n        <button\n          onClick={() => setView(\'TEMPLATES\')}\n          className=\"px-4 py-2.5 rounded-lg text-xs font-semibold bg-blue-600 hover:bg-blue-500 text-white shadow-sm transition-all\"\n        >\n          Generar Nuevo Contrato\n        </button>\n      </div>\n\n      {state.generatedDocuments.length === 0 ? (\n        <div className=\"bg-white rounded-xl p-12 text-center border border-slate-200\">\n          <History className=\"w-12 h-12 text-slate-300 mx-auto mb-3\" />\n          <h3 className=\"text-base font-semibold text-slate-800\">No hay documentos generados todav\303\255a</h3>\n          <p className=\"text-xs text-slate-500 max-w-sm mx-auto mt-1\">\n            Selecciona una plantilla y completa el formulario para emitir tu primer contrato legal con validaci\303\263n dominicana.\n          </p>\n          <button\n            onClick={() => setView(\'TEMPLATES\')}\n            className=\"mt-4 px-4 py-2 rounded-lg text-xs font-semibold bg-blue-600 hover:bg-blue-500 text-white\"\n          >\n            Explorar Plantillas\n          </button>\n        </div>\n      ) : (\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n          {/* Documents List */}\n          <div className=\"lg:col-span-5 bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden\">\n            <div className=\"p-3 bg-slate-50 border-b border-slate-200\">\n              <div className=\"relative\">\n                <Search className=\"w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" />\n                <input\n                  type=\"text\"\n                  placeholder=\"Buscar en historial...\"\n                  value={searchQuery}\n                  onChange={(e) => setSearchQuery(e.target.value)}\n                  className=\"w-full pl-8 pr-3 py-1.5 text-xs rounded-lg border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                />\n              </div>\n            </div>\n\n            <div className=\"divide-y divide-slate-100 max-h-[600px] overflow-y-auto\">\n              {filteredDocs.map((doc) => {\n                const isSelected = selectedDoc?.id === doc.id;\n\n                return (\n                  <button\n                    key={doc.id}\n                    onClick={() => setSelectedDoc(doc)}\n                    className={`w-full text-left p-4 transition-colors flex items-center justify-between ${\n                      isSelected ? \'bg-blue-50/60 border-l-4 border-blue-600\' : \'hover:bg-slate-50\'\n                    }`}\n                  >\n                    <div className=\"space-y-1\">\n                      <h4 className=\"font-serif font-bold text-xs text-slate-900 line-clamp-1\">{doc.title}</h4>\n                      <p className=\"text-[11px] text-slate-500\">Plantilla: {doc.templateName}</p>\n                      <div className=\"flex items-center space-x-2 text-[10px] text-slate-400\">\n                        <Calendar className=\"w-3 h-3\" />\n                        <span>{new Date(doc.createdAt).toLocaleString()}</span>\n                      </div>\n                    </div>\n\n                    <ChevronRight className=\"w-4 h-4 text-slate-300\" />\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Document Preview & Snapshot */}\n          <div className=\"lg:col-span-7 bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden\">\n            {selectedDoc ? (\n              <div>\n                {/* Header Actions */}\n                <div className=\"p-4 bg-slate-50 border-b border-slate-200 flex flex-wrap items-center justify-between gap-3\">\n                  <div>\n                    <h3 className=\"font-serif font-bold text-sm text-slate-900\">{selectedDoc.title}</h3>\n                    <span className=\"text-[11px] text-slate-500\">\n                      Emitido el {new Date(selectedDoc.createdAt).toLocaleString()} por {selectedDoc.author}\n                    </span>\n                  </div>\n\n                  <div className=\"flex items-center space-x-2\">\n                    <button\n                      onClick={() => handleDownloadDocx(selectedDoc)}\n                      className=\"flex items-center space-x-1 px-3 py-1.5 rounded-lg text-xs font-semibold bg-blue-600 hover:bg-blue-500 text-white shadow-xs\"\n                    >\n                      <Download className=\"w-3.5 h-3.5\" />\n                      <span>DOCX</span>\n                    </button>\n\n                    <button\n                      onClick={() => handleDownloadPdf(selectedDoc)}\n                      className=\"flex items-center space-x-1 px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-900 hover:bg-slate-800 text-white shadow-xs\"\n                    >\n                      <Printer className=\"w-3.5 h-3.5\" />\n                      <span>PDF</span>\n                    </button>\n                  </div>\n                </div>\n\n                {/* Content View */}\n                <div className=\"p-6 max-h-[550px] overflow-y-auto font-serif text-xs leading-relaxed text-slate-800 whitespace-pre-wrap selection:bg-blue-100 border-b border-slate-100\">\n                  {selectedDoc.renderedContent}\n                </div>\n\n                {/* Captured variables snapshot table */}\n                <div className=\"p-4 bg-slate-50/50\">\n                  <div className=\"text-xs font-bold text-slate-700 uppercase tracking-wider mb-2 flex items-center space-x-1.5\">\n                    <Layers className=\"w-3.5 h-3.5 text-blue-600\" />\n                    <span>Snapshot de Variables Capturadas</span>\n                  </div>\n\n                  <div className=\"grid grid-cols-2 gap-2 text-xs\">\n                    {Object.entries(selectedDoc.valuesSnapshot).map(([k, v]) => (\n                      <div key={k} className=\"p-2 bg-white rounded border border-slate-200\">\n                        <span className=\"block font-mono text-[10px] text-slate-400\">{`{{${k}}}`}</span>\n                        <span className=\"font-semibold text-slate-800 truncate block\">{String(v)}</span>\n                      </div>\n                    ))}\n                  </div>\n                </div>\n              </div>\n            ) : (\n              <div className=\"p-12 text-center text-slate-400 text-xs\">\n                Selecciona un documento de la lista para ver su vista previa.\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
