  file_change {
    absolute_path_uri: "file:///src/components/PricingPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  Check,\n  CreditCard,\n  Lock,\n  ShieldCheck,\n  Scale,\n  Sparkles,\n  ArrowRight,\n  FileText,\n  Building2,\n  Zap,\n  CheckCircle2,\n} from \'lucide-react\';\nimport { useAppStore } from \'../store/useAppStore\';\n\nexport const PricingPage: React.FC = () => {\n  const { setView } = useAppStore();\n  const [selectedPlan, setSelectedPlan] = useState<\'single\' | \'pro\' | \'enterprise\'>(\'pro\');\n  const [formData, setFormData] = useState({\n    firstName: \'Stephania\',\n    lastName: \'Montero\',\n    email: \'stephaniamontero84@gmail.com\',\n    cardNumber: \'\342\200\242\342\200\242\342\200\242\342\200\242 \342\200\242\342\200\242\342\200\242\342\200\242 \342\200\242\342\200\242\342\200\242\342\200\242 4242\',\n    expiry: \'12/28\',\n    cvc: \'888\',\n    nameOnCard: \'Stephania Montero\',\n  });\n  const [isProcessing, setIsProcessing] = useState(false);\n  const [paymentSuccess, setPaymentSuccess] = useState(false);\n\n  const plans = {\n    single: {\n      name: \'Single Template\',\n      price: 49,\n      period: \'/document\',\n      docName: \'Non-Disclosure Agreement (Mutual)\',\n      docType: \'Single Template Purchase\',\n    },\n    pro: {\n      name: \'Professional\',\n      price: 199,\n      period: \'/month\',\n      docName: \'Suscripci\303\263n Ilimitada SAVE Professional\',\n      docType: \'Plan Mensual Completo\',\n    },\n    enterprise: {\n      name: \'Enterprise\',\n      price: 499,\n      period: \'/month\',\n      docName: \'SAVE Enterprise Custom Tier\',\n      docType: \'Plan Corporativo Personalizado\',\n    },\n  };\n\n  const handlePayment = (e: React.FormEvent) => {\n    e.preventDefault();\n    setIsProcessing(true);\n    setTimeout(() => {\n      setIsProcessing(false);\n      setPaymentSuccess(true);\n    }, 1200);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 selection:bg-emerald-100 font-sans pb-24\">\n      {/* Top Secondary Navigation Header from Design */}\n      <header className=\"border-b border-[#E8E5DF] dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 sticky top-0 z-20 backdrop-blur-sm px-6 sm:px-12 py-3.5 flex items-center justify-between\">\n        {/* Brand Logo Monogram */}\n        <div\n          onClick={() => setView(\'WELCOME\')}\n          className=\"flex items-center space-x-2.5 cursor-pointer group\"\n          id=\"btn-nav-brand-logo\"\n        >\n          <div className=\"w-7 h-7 bg-[#0D2C24] dark:bg-emerald-600 rounded flex items-center justify-center text-white font-serif font-bold text-sm shadow-2xs group-hover:bg-[#164E3E] transition-colors\">\n            S\n          </div>\n          <span className=\"font-serif font-bold text-lg tracking-wider text-[#0D2C24] dark:text-emerald-400\">\n            SAVE\n          </span>\n        </div>\n\n        {/* Center Nav Links */}\n        <nav className=\"hidden md:flex items-center space-x-8 text-xs font-medium text-slate-600 dark:text-slate-300\">\n          <button\n            onClick={() => setView(\'TEMPLATES\')}\n            className=\"hover:text-[#0D2C24] dark:hover:text-emerald-400 transition-colors cursor-pointer\"\n            id=\"nav-link-templates\"\n          >\n            Templates\n          </button>\n          <button\n            onClick={() => setView(\'PRICING\')}\n            className=\"text-[#0D2C24] dark:text-emerald-400 font-bold border-b-2 border-[#0D2C24] dark:border-emerald-400 pb-0.5\"\n            id=\"nav-link-pricing\"\n          >\n            Pricing\n          </button>\n          <button\n            onClick={() => setView(\'WELCOME\')}\n            className=\"hover:text-[#0D2C24] dark:hover:text-emerald-400 transition-colors cursor-pointer\"\n            id=\"nav-link-how-it-works\"\n          >\n            How it works\n          </button>\n          <button\n            onClick={() => setView(\'DOCUMENTS\')}\n            className=\"hover:text-[#0D2C24] dark:hover:text-emerald-400 transition-colors cursor-pointer\"\n            id=\"nav-link-contracts\"\n          >\n            B\303\263veda de Contratos\n          </button>\n        </nav>\n\n        {/* Right Actions */}\n        <div className=\"flex items-center space-x-3\">\n          <button\n            onClick={() => setView(\'TEMPLATES\')}\n            className=\"text-xs font-semibold text-slate-700 dark:text-slate-200 hover:text-[#0D2C24] px-3 py-1.5 transition-colors cursor-pointer\"\n            id=\"btn-nav-login\"\n          >\n            Login\n          </button>\n          <button\n            onClick={() => setView(\'TEMPLATES\')}\n            className=\"bg-[#0D2C24] hover:bg-[#164E3E] text-white text-xs font-semibold px-4 py-2 rounded-lg shadow-xs transition-colors cursor-pointer flex items-center space-x-1.5\"\n            id=\"btn-nav-get-started\"\n          >\n            <span>Get Started</span>\n          </button>\n        </div>\n      </header>\n\n      {/* Main Container */}\n      <main className=\"max-w-6xl mx-auto px-4 sm:px-6 pt-12 sm:pt-16\">\n        {/* Title Header Section */}\n        <div className=\"text-center max-w-3xl mx-auto mb-14\">\n          <h1 className=\"text-3xl sm:text-5xl font-serif text-[#0D2C24] dark:text-slate-100 font-bold tracking-tight mb-4 leading-tight\">\n            Transparent pricing for modern legal teams.\n          </h1>\n          <p className=\"text-sm sm:text-base text-slate-600 dark:text-slate-300 font-sans leading-relaxed\">\n            Choose the plan that fits your volume. Upgrade or downgrade at any time with complete flexibility.\n          </p>\n        </div>\n\n        {/* 3 Pricing Cards Grid */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch mb-20\">\n          {/* Card 1: Single Template */}\n          <div\n            onClick={() => setSelectedPlan(\'single\')}\n            className={`rounded-2xl p-7 sm:p-8 flex flex-col justify-between transition-all duration-200 cursor-pointer ${\n              selectedPlan === \'single\'\n                ? \'bg-white dark:bg-slate-900 border-2 border-[#0D2C24] dark:border-emerald-500 shadow-lg\'\n                : \'bg-white dark:bg-slate-900 border border-[#E8E5DF] dark:border-slate-800 hover:border-slate-300 shadow-xs\'\n            }`}\n            id=\"card-plan-single\"\n          >\n            <div>\n              {/* Pill badge */}\n              <div className=\"inline-block px-3 py-1 rounded-full bg-[#F5F2ED] dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-[11px] font-medium mb-5\">\n                Pay as you go\n              </div>\n\n              <h3 className=\"font-serif text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mb-3\">\n                Single Template\n              </h3>\n\n              {/* Price */}\n              <div className=\"flex items-baseline space-x-1 mb-4\">\n                <span className=\"font-serif text-4xl sm:text-5xl font-bold text-slate-900 dark:text-white\">\n                  $49\n                </span>\n                <span className=\"text-xs text-slate-500 font-sans\">/document</span>\n              </div>\n\n              <p className=\"text-xs sm:text-sm text-slate-600 dark:text-slate-400 mb-6 leading-relaxed\">\n                Perfect for one-off agreements and occasional needs.\n              </p>\n\n              {/* Features List */}\n              <ul className=\"space-y-3 mb-8 text-xs text-slate-700 dark:text-slate-300\">\n                <li className=\"flex items-center space-x-2.5\">\n                  <div className=\"w-4 h-4 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center shrink-0\">\n                    <Check className=\"w-3 h-3 text-slate-700 dark:text-slate-300 stroke-[2.5]\" />\n                  </div>\n                  <span>Access to single selected template</span>\n                </li>\n                <li className=\"flex items-center space-x-2.5\">\n                  <div className=\"w-4 h-4 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center shrink-0\">\n                    <Check className=\"w-3 h-3 text-slate-700 dark:text-slate-300 stroke-[2.5]\" />\n                  </div>\n                  <span>Basic editor features</span>\n                </li>\n                <li className=\"flex items-center space-x-2.5\">\n                  <div className=\"w-4 h-4 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center shrink-0\">\n                    <Check className=\"w-3 h-3 text-slate-700 dark:text-slate-300 stroke-[2.5]\" />\n                  </div>\n                  <span>Export to PDF & Word</span>\n                </li>\n              </ul>\n            </div>\n\n            <button\n              onClick={(e) => {\n                e.stopPropagation();\n                setSelectedPlan(\'single\');\n              }}\n              className={`w-full py-2.5 px-4 rounded-lg text-xs font-semibold border transition-all cursor-pointer ${\n                selectedPlan === \'single\'\n                  ? \'bg-[#0D2C24] text-white border-[#0D2C24]\'\n                  : \'bg-white dark:bg-slate-900 border-[#D1CCC4] dark:border-slate-700 text-slate-800 dark:text-slate-200 hover:bg-slate-50\'\n              }`}\n              id=\"btn-select-single-plan\"\n            >\n              {selectedPlan === \'single\' ? \'Plan Seleccionado\' : \'Select Plan\'}\n            </button>\n          </div>\n\n          {/* Card 2: Professional (Featured Most Popular - Deep Forest Green) */}\n          <div\n            onClick={() => setSelectedPlan(\'pro\')}\n            className=\"relative rounded-2xl p-7 sm:p-8 flex flex-col justify-between bg-[#0D2C24] text-white shadow-xl border border-[#164E3E] transform lg:-translate-y-2 cursor-pointer\"\n            id=\"card-plan-pro\"\n          >\n            {/* Floating Most Popular Badge */}\n            <div className=\"absolute -top-3.5 left-1/2 -translate-x-1/2 px-3.5 py-0.5 rounded-full bg-[#FDE8B5] text-[#0D2C24] text-[11px] font-bold tracking-wide shadow-xs whitespace-nowrap\">\n              Most Popular\n            </div>\n\n            <div>\n              <div className=\"h-4\"></div>\n              <h3 className=\"font-serif text-xl sm:text-2xl font-bold text-white mb-3\">\n                Professional\n              </h3>\n\n              {/* Price */}\n              <div className=\"flex items-baseline space-x-1 mb-4\">\n                <span className=\"font-serif text-4xl sm:text-5xl font-bold text-white\">\n                  $199\n                </span>\n                <span className=\"text-xs text-emerald-200/70 font-sans\">/month</span>\n              </div>\n\n              <p className=\"text-xs sm:text-sm text-emerald-100/80 mb-6 leading-relaxed\">\n                For growing businesses needing regular legal coverage.\n              </p>\n\n              {/* Features List with Gold Checkmarks */}\n              <ul className=\"space-y-3 mb-8 text-xs text-emerald-50\">\n                <li className=\"flex items-center space-x-2.5\">\n                  <div className=\"w-4 h-4 rounded-full bg-[#164E3E] flex items-center justify-center shrink-0\">\n                    <Check className=\"w-3 h-3 text-[#FDE8B5] stroke-[2.5]\" />\n                  </div>\n                  <span>Unlimited access to all templates</span>\n                </li>\n                <li className=\"flex items-center space-x-2.5\">\n                  <div className=\"w-4 h-4 rounded-full bg-[#164E3E] flex items-center justify-center shrink-0\">\n                    <Check className=\"w-3 h-3 text-[#FDE8B5] stroke-[2.5]\" />\n                  </div>\n                  <span>Advanced collaborative editor</span>\n                </li>\n                <li className=\"flex items-center space-x-2.5\">\n                  <div className=\"w-4 h-4 rounded-full bg-[#164E3E] flex items-center justify-center shrink-0\">\n                    <Check className=\"w-3 h-3 text-[#FDE8B5] stroke-[2.5]\" />\n                  </div>\n                  <span>E-signature integration</span>\n                </li>\n                <li className=\"flex items-center space-x-2.5\">\n                  <div className=\"w-4 h-4 rounded-full bg-[#164E3E] flex items-center justify-center shrink-0\">\n                    <Check className=\"w-3 h-3 text-[#FDE8B5] stroke-[2.5]\" />\n                  </div>\n                  <span>Priority support</span>\n                </li>\n              </ul>\n            </div>\n\n            <button\n              onClick={(e) => {\n                e.stopPropagation();\n                setSelectedPlan(\'pro\');\n              }}\n              className=\"w-full py-2.5 px-4 rounded-lg text-xs font-bold bg-[#FDE8B5] hover:bg-[#FCE19F] text-[#0D2C24] transition-colors shadow-sm cursor-pointer\"\n              id=\"btn-select-pro-plan\"\n            >\n              Start 14-Day Trial\n            </button>\n          </div>\n\n          {/* Card 3: Enterprise */}\n          <div\n            onClick={() => setSelectedPlan(\'enterprise\')}\n            className={`rounded-2xl p-7 sm:p-8 flex flex-col justify-between transition-all duration-200 cursor-pointer ${\n              selectedPlan === \'enterprise\'\n                ? \'bg-white dark:bg-slate-900 border-2 border-[#0D2C24] dark:border-emerald-500 shadow-lg\'\n                : \'bg-white dark:bg-slate-900 border border-[#E8E5DF] dark:border-slate-800 hover:border-slate-300 shadow-xs\'\n            }`}\n            id=\"card-plan-enterprise\"\n          >\n            <div>\n              <div className=\"text-slate-500 text-xs font-medium mb-1\">Enterprise</div>\n              <h3 className=\"font-serif text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mb-4\">\n                Custom\n              </h3>\n\n              <p className=\"text-xs sm:text-sm text-slate-600 dark:text-slate-400 mb-6 leading-relaxed\">\n                Tailored solutions for large organizations and law firms.\n              </p>\n\n              {/* Features List */}\n              <ul className=\"space-y-3 mb-8 text-xs text-slate-700 dark:text-slate-300\">\n                <li className=\"flex items-center space-x-2.5\">\n                  <div className=\"w-4 h-4 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center shrink-0\">\n                    <Check className=\"w-3 h-3 text-slate-700 dark:text-slate-300 stroke-[2.5]\" />\n                  </div>\n                  <span>Everything in Professional</span>\n                </li>\n                <li className=\"flex items-center space-x-2.5\">\n                  <div className=\"w-4 h-4 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center shrink-0\">\n                    <Check className=\"w-3 h-3 text-slate-700 dark:text-slate-300 stroke-[2.5]\" />\n                  </div>\n                  <span>Custom template ingestion</span>\n                </li>\n                <li className=\"flex items-center space-x-2.5\">\n                  <div className=\"w-4 h-4 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center shrink-0\">\n                    <Check className=\"w-3 h-3 text-slate-700 dark:text-slate-300 stroke-[2.5]\" />\n                  </div>\n                  <span>Dedicated account manager</span>\n                </li>\n                <li className=\"flex items-center space-x-2.5\">\n                  <div className=\"w-4 h-4 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center shrink-0\">\n                    <Check className=\"w-3 h-3 text-slate-700 dark:text-slate-300 stroke-[2.5]\" />\n                  </div>\n                  <span>SSO & Advanced Security</span>\n                </li>\n              </ul>\n            </div>\n\n            <button\n              onClick={(e) => {\n                e.stopPropagation();\n                setSelectedPlan(\'enterprise\');\n              }}\n              className=\"w-full py-2.5 px-4 rounded-lg text-xs font-semibold bg-white dark:bg-slate-900 border border-[#D1CCC4] dark:border-slate-700 text-slate-800 dark:text-slate-200 hover:bg-slate-50 transition-colors cursor-pointer\"\n              id=\"btn-select-enterprise-plan\"\n            >\n              Contact Sales\n            </button>\n          </div>\n        </div>\n\n        {/* Section 2: Secure Checkout Area */}\n        <div className=\"pt-8 border-t border-[#E8E5DF] dark:border-slate-800\">\n          <h2 className=\"font-serif text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white mb-8\">\n            Secure Checkout\n          </h2>\n\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n            {/* Left 8 Cols: Checkout Form */}\n            <div className=\"lg:col-span-8 bg-white dark:bg-slate-900 rounded-2xl border border-[#E8E5DF] dark:border-slate-800 p-6 sm:p-8 shadow-xs\">\n              <form onSubmit={handlePayment} className=\"space-y-8\">\n                {/* 1. Contact Information */}\n                <div>\n                  <div className=\"flex items-center space-x-3 mb-4\">\n                    <div className=\"w-5 h-5 rounded-full bg-[#0D2C24] dark:bg-emerald-600 text-white text-[11px] font-bold flex items-center justify-center\">\n                      1\n                    </div>\n                    <h3 className=\"font-serif text-lg font-bold text-slate-900 dark:text-white\">\n                      Contact Information\n                    </h3>\n                  </div>\n\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4\">\n                    <div>\n                      <input\n                        type=\"text\"\n                        placeholder=\"First Name\"\n                        value={formData.firstName}\n                        onChange={(e) => setFormData({ ...formData, firstName: e.target.value })}\n                        required\n                        className=\"w-full px-3.5 py-2.5 text-xs bg-white dark:bg-slate-800 border border-[#E8E5DF] dark:border-slate-700 rounded-lg text-slate-900 dark:text-slate-100 focus:outline-none focus:border-[#0D2C24] focus:ring-1 focus:ring-[#0D2C24]\"\n                        id=\"input-checkout-firstname\"\n                      />\n                    </div>\n                    <div>\n                      <input\n                        type=\"text\"\n                        placeholder=\"Last Name\"\n                        value={formData.lastName}\n                        onChange={(e) => setFormData({ ...formData, lastName: e.target.value })}\n                        required\n                        className=\"w-full px-3.5 py-2.5 text-xs bg-white dark:bg-slate-800 border border-[#E8E5DF] dark:border-slate-700 rounded-lg text-slate-900 dark:text-slate-100 focus:outline-none focus:border-[#0D2C24] focus:ring-1 focus:ring-[#0D2C24]\"\n                        id=\"input-checkout-lastname\"\n                      />\n                    </div>\n                  </div>\n\n                  <div>\n                    <input\n                      type=\"email\"\n                      placeholder=\"Email Address\"\n                      value={formData.email}\n                      onChange={(e) => setFormData({ ...formData, email: e.target.value })}\n                      required\n                      className=\"w-full px-3.5 py-2.5 text-xs bg-white dark:bg-slate-800 border border-[#E8E5DF] dark:border-slate-700 rounded-lg text-slate-900 dark:text-slate-100 focus:outline-none focus:border-[#0D2C24] focus:ring-1 focus:ring-[#0D2C24]\"\n                      id=\"input-checkout-email\"\n                    />\n                  </div>\n                </div>\n\n                {/* 2. Payment Details */}\n                <div>\n                  <div className=\"flex items-center space-x-3 mb-4\">\n                    <div className=\"w-5 h-5 rounded-full bg-[#0D2C24] dark:bg-emerald-600 text-white text-[11px] font-bold flex items-center justify-center\">\n                      2\n                    </div>\n                    <h3 className=\"font-serif text-lg font-bold text-slate-900 dark:text-white\">\n                      Payment Details\n                    </h3>\n                  </div>\n\n                  {/* Credit Card Container Box */}\n                  <div className=\"bg-[#F5F2ED] dark:bg-slate-800/80 rounded-xl p-4 sm:p-5 border border-[#E8E5DF] dark:border-slate-700 space-y-3.5\">\n                    <div className=\"flex items-center justify-between mb-1\">\n                      <span className=\"text-xs font-semibold text-slate-700 dark:text-slate-300\">\n                        Credit Card\n                      </span>\n                      <div className=\"flex items-center space-x-1.5 text-[10px] font-bold text-slate-500\">\n                        <span className=\"px-1.5 py-0.5 bg-white dark:bg-slate-700 rounded border border-slate-200 dark:border-slate-600\">\n                          VISA\n                        </span>\n                        <span className=\"px-1.5 py-0.5 bg-white dark:bg-slate-700 rounded border border-slate-200 dark:border-slate-600\">\n                          MC\n                        </span>\n                      </div>\n                    </div>\n\n                    {/* Card Number */}\n                    <div className=\"relative\">\n                      <input\n                        type=\"text\"\n                        placeholder=\"Card Number\"\n                        value={formData.cardNumber}\n                        onChange={(e) => setFormData({ ...formData, cardNumber: e.target.value })}\n                        required\n                        className=\"w-full px-3.5 py-2.5 text-xs bg-white dark:bg-slate-800 border border-[#E8E5DF] dark:border-slate-700 rounded-lg text-slate-900 dark:text-slate-100 pr-10 focus:outline-none focus:border-[#0D2C24]\"\n                        id=\"input-card-number\"\n                      />\n                      <CreditCard className=\"w-4 h-4 text-slate-400 absolute right-3.5 top-3\" />\n                    </div>\n\n                    {/* Expiry and CVC */}\n                    <div className=\"grid grid-cols-2 gap-3\">\n                      <div>\n                        <input\n                          type=\"text\"\n                          placeholder=\"Expiry (MM/YY)\"\n                          value={formData.expiry}\n                          onChange={(e) => setFormData({ ...formData, expiry: e.target.value })}\n                          required\n                          className=\"w-full px-3.5 py-2.5 text-xs bg-white dark:bg-slate-800 border border-[#E8E5DF] dark:border-slate-700 rounded-lg text-slate-900 dark:text-slate-100 focus:outline-none focus:border-[#0D2C24]\"\n                          id=\"input-card-expiry\"\n                        />\n                      </div>\n                      <div className=\"relative\">\n                        <input\n                          type=\"text\"\n                          placeholder=\"CVC\"\n                          value={formData.cvc}\n                          onChange={(e) => setFormData({ ...formData, cvc: e.target.value })}\n                          required\n                          className=\"w-full px-3.5 py-2.5 text-xs bg-white dark:bg-slate-800 border border-[#E8E5DF] dark:border-slate-700 rounded-lg text-slate-900 dark:text-slate-100 focus:outline-none focus:border-[#0D2C24]\"\n                          id=\"input-card-cvc\"\n                        />\n                        <span className=\"text-[10px] text-slate-400 absolute right-3 top-3 cursor-help\">\n                          ?\n                        </span>\n                      </div>\n                    </div>\n\n                    {/* Name on Card */}\n                    <div>\n                      <input\n                        type=\"text\"\n                        placeholder=\"Name on Card\"\n                        value={formData.nameOnCard}\n                        onChange={(e) => setFormData({ ...formData, nameOnCard: e.target.value })}\n                        required\n                        className=\"w-full px-3.5 py-2.5 text-xs bg-white dark:bg-slate-800 border border-[#E8E5DF] dark:border-slate-700 rounded-lg text-slate-900 dark:text-slate-100 focus:outline-none focus:border-[#0D2C24]\"\n                        id=\"input-card-name\"\n                      />\n                    </div>\n                  </div>\n\n                  {/* Encryption notice */}\n                  <div className=\"flex items-center space-x-2 text-[11px] text-slate-500 dark:text-slate-400 mt-3\">\n                    <Lock className=\"w-3.5 h-3.5 shrink-0 text-slate-400\" />\n                    <span>\n                      Your payment information is encrypted and securely processed. We do not store your full credit card details.\n                    </span>\n                  </div>\n                </div>\n\n                {/* Submit Button */}\n                <button\n                  type=\"submit\"\n                  disabled={isProcessing}\n                  className=\"w-full py-3.5 px-6 rounded-xl bg-[#0D2C24] hover:bg-[#164E3E] text-white text-sm font-bold flex items-center justify-center space-x-2 shadow-md transition-colors cursor-pointer\"\n                  id=\"btn-checkout-submit\"\n                >\n                  {isProcessing ? (\n                    <div className=\"flex items-center space-x-2\">\n                      <div className=\"w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin\"></div>\n                      <span>Procesando pago seguro...</span>\n                    </div>\n                  ) : (\n                    <>\n                      <span>Pay ${plans[selectedPlan].price}.00</span>\n                      <ArrowRight className=\"w-4 h-4\" />\n                    </>\n                  )}\n                </button>\n              </form>\n\n              {/* Success Notification Modal */}\n              {paymentSuccess && (\n                <div className=\"mt-4 p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 text-emerald-900 dark:text-emerald-200 flex items-center justify-between\">\n                  <div className=\"flex items-center space-x-3\">\n                    <CheckCircle2 className=\"w-5 h-5 text-emerald-600 shrink-0\" />\n                    <div className=\"text-xs\">\n                      <span className=\"font-bold block\">\302\241Pago Aprobado con \303\211xito!</span>\n                      <span>Plan {plans[selectedPlan].name} activado para {formData.email}.</span>\n                    </div>\n                  </div>\n                  <button\n                    onClick={() => setView(\'TEMPLATES\')}\n                    className=\"px-3 py-1.5 bg-[#0D2C24] text-white text-xs font-semibold rounded-lg hover:bg-[#164E3E]\"\n                  >\n                    Comenzar\n                  </button>\n                </div>\n              )}\n            </div>\n\n            {/* Right 4 Cols: Order Summary */}\n            <div className=\"lg:col-span-4 bg-[#FAFAF8] dark:bg-slate-900 rounded-2xl border border-[#E8E5DF] dark:border-slate-800 p-6 sm:p-7 shadow-xs\">\n              <h3 className=\"font-serif text-lg font-bold text-slate-900 dark:text-white mb-6\">\n                Order Summary\n              </h3>\n\n              {/* Selected Item Box */}\n              <div className=\"flex items-start space-x-3.5 pb-6 border-b border-[#E8E5DF] dark:border-slate-800\">\n                <div className=\"w-10 h-12 bg-[#F5F2ED] dark:bg-slate-800 border border-[#E8E5DF] dark:border-slate-700 rounded-lg flex items-center justify-center shrink-0\">\n                  <FileText className=\"w-5 h-5 text-slate-600 dark:text-slate-300\" />\n                </div>\n                <div>\n                  <div className=\"text-xs font-bold text-slate-900 dark:text-white leading-tight\">\n                    {plans[selectedPlan].docName}\n                  </div>\n                  <div className=\"text-[11px] text-slate-500 dark:text-slate-400 mt-0.5\">\n                    {plans[selectedPlan].docType}\n                  </div>\n                </div>\n              </div>\n\n              {/* Subtotal & Taxes */}\n              <div className=\"py-4 border-b border-[#E8E5DF] dark:border-slate-800 space-y-2 text-xs\">\n                <div className=\"flex items-center justify-between text-slate-600 dark:text-slate-400\">\n                  <span>Subtotal</span>\n                  <span className=\"font-mono text-slate-800 dark:text-slate-200\">\n                    ${plans[selectedPlan].price}.00\n                  </span>\n                </div>\n                <div className=\"flex items-center justify-between text-slate-600 dark:text-slate-400\">\n                  <span>Taxes (Calculated at next step)</span>\n                  <span className=\"font-mono text-slate-800 dark:text-slate-200\">$0.00</span>\n                </div>\n              </div>\n\n              {/* Total */}\n              <div className=\"flex items-baseline justify-between py-6\">\n                <span className=\"font-serif text-base font-bold text-slate-900 dark:text-white\">\n                  Total\n                </span>\n                <span className=\"font-serif text-3xl font-bold text-slate-900 dark:text-white\">\n                  ${plans[selectedPlan].price}.00\n                </span>\n              </div>\n\n              {/* Trust Badges 3 Column */}\n              <div className=\"grid grid-cols-3 gap-2 pt-4 border-t border-[#E8E5DF] dark:border-slate-800 text-center\">\n                <div className=\"p-2 rounded-lg bg-white dark:bg-slate-800/60 border border-[#E8E5DF] dark:border-slate-700/60 flex flex-col items-center justify-center\">\n                  <ShieldCheck className=\"w-4 h-4 text-slate-700 dark:text-slate-300 mb-1\" />\n                  <span className=\"text-[9px] font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400\">\n                    256-BIT SSL\n                  </span>\n                </div>\n                <div className=\"p-2 rounded-lg bg-white dark:bg-slate-800/60 border border-[#E8E5DF] dark:border-slate-700/60 flex flex-col items-center justify-center\">\n                  <CreditCard className=\"w-4 h-4 text-slate-700 dark:text-slate-300 mb-1\" />\n                  <span className=\"text-[9px] font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400\">\n                    SECURE STRIPE\n                  </span>\n                </div>\n                <div className=\"p-2 rounded-lg bg-white dark:bg-slate-800/60 border border-[#E8E5DF] dark:border-slate-700/60 flex flex-col items-center justify-center\">\n                  <Scale className=\"w-4 h-4 text-slate-700 dark:text-slate-300 mb-1\" />\n                  <span className=\"text-[9px] font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400\">\n                    LEGAL GRADE\n                  </span>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </main>\n\n      {/* Footer Area from Design */}\n      <footer className=\"mt-24 border-t border-[#E8E5DF] dark:border-slate-800 bg-[#FAFAF8] dark:bg-slate-900/60 py-12 px-6 sm:px-12\">\n        <div className=\"max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-8 items-start\">\n          {/* Col 1: Brand & Copyright */}\n          <div className=\"md:col-span-6 space-y-3\">\n            <div className=\"flex items-center space-x-2.5\">\n              <div className=\"w-6 h-6 bg-[#0D2C24] dark:bg-emerald-600 rounded flex items-center justify-center text-white font-serif font-bold text-xs\">\n                S\n              </div>\n              <span className=\"font-serif font-bold text-base tracking-wider text-[#0D2C24] dark:text-emerald-400\">\n                SAVE\n              </span>\n            </div>\n            <p className=\"text-xs text-slate-500 dark:text-slate-400 max-w-sm leading-relaxed\">\n              \302\251 2024 SAVE Legal Technologies. All rights reserved. Providing modern legal solutions with high-velocity efficiency.\n            </p>\n          </div>\n\n          {/* Col 2: Legal Links */}\n          <div className=\"md:col-span-3 space-y-2\">\n            <div className=\"text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-2\">\n              Legal\n            </div>\n            <ul className=\"space-y-1.5 text-xs text-slate-600 dark:text-slate-400\">\n              <li><a href=\"#privacy\" className=\"hover:text-[#0D2C24]\">Privacy Policy</a></li>\n              <li><a href=\"#terms\" className=\"hover:text-[#0D2C24]\">Terms of Service</a></li>\n              <li><a href=\"#cookie\" className=\"hover:text-[#0D2C24]\">Cookie Policy</a></li>\n            </ul>\n          </div>\n\n          {/* Col 3: Social Links */}\n          <div className=\"md:col-span-3 space-y-2\">\n            <div className=\"text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-2\">\n              Social\n            </div>\n            <ul className=\"space-y-1.5 text-xs text-slate-600 dark:text-slate-400\">\n              <li><a href=\"#linkedin\" className=\"hover:text-[#0D2C24]\">LinkedIn</a></li>\n              <li><a href=\"#twitter\" className=\"hover:text-[#0D2C24]\">Twitter</a></li>\n              <li><a href=\"#facebook\" className=\"hover:text-[#0D2C24]\">Facebook</a></li>\n            </ul>\n          </div>\n        </div>\n      </footer>\n    </div>\n  );\n};\n"
