        lines {
          text: "    id: \'tpl_venta_inmueble_rd\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    name: \'Contrato de Promesa de Venta Inmobiliaria (RD)\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    description: \'Acuerdo de compraventa de inmueble con designaci\303\263n catastral, certificado de t\303\255tulo y pago escalonado.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    category: \'Inmobiliario\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    jurisdiction: \'Rep\303\272blica Dominicana\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    version: \'1.0\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    status: \'PUBLISHED\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    author: \'Dpto. Legal Inmobiliario\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    createdAt: \'2026-08-12T14:00:00Z\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    updatedAt: \'2026-08-14T11:00:00Z\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    content: `CONTRATO DE PROMESA DE COMPRAVENTA DE INMUEBLE"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "ENTRE:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "De una parte, {{vendedor_nombre}}, dominicano, mayor de edad, C\303\251dula No. {{vendedor_cedula}}, domiciliado en {{vendedor_direccion}}, en lo sucesivo EL VENDEDOR;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "Y de la otra parte, {{comprador_nombre}}, dominicano, mayor de edad, C\303\251dula No. {{comprador_cedula}}, domiciliado en {{comprador_direccion}}, en lo sucesivo EL COMPRADOR."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "HAN CONVENIDO:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "PRIMERO: EL VENDEDOR promete y se obliga a vender a EL COMPRADOR, quien acepta, el siguiente inmueble: {{inmueble_descripcion}}, amparado por el Certificado de T\303\255tulo Matr\303\255cula No. {{matricula_titulo}}, Parcela No. {{parcela_numero}}, Distrito Catastral No. {{distrito_catastral}}, {{ciudad_inmueble}}, Rep\303\272blica Dominicana."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "SEGUNDO: El precio total pactado de la venta es de {{precio_venta_monto}} ({{precio_venta_letras}}), el cual ser\303\241 cancelado seg\303\272n el calendario de pagos acordado."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "{{#clause:clausula_competencia_tribunales}}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "TERCERO: JURISDICCI\303\223N: Para todo lo relativo a la ejecuci\303\263n del presente contrato, las partes atribuyen competencia a los Tribunales de la Rep\303\272blica Dominicana correspondientes al {{distrito_judicial}}."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "{{/clause:clausula_competencia_tribunales}}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "FIRMADO en {{ciudad_firma}}, Rep\303\272blica Dominicana, a los {{fecha_firma}}.`,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
