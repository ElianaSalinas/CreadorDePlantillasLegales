      replacement_content: "import { LegalClause } from \'../types\';\n\nexport const DEFAULT_DOMINICAN_CLAUSES: LegalClause[] = [\n  {\n    id: \'clausula_deposito_garantia\',\n    title: \'Cl\303\241usula de Dep\303\263sito de Garant\303\255a Notarial\',\n    category: \'Garant\303\255a\',\n    version: \'1.2\',\n    isProtected: true,\n    isActiveDefault: true,\n    description: \'Establece la fianza de dep\303\263sito retenida seg\303\272n la Ley 4314 de Alquileres de RD\',\n    variablesReferenced: [\'deposito_garantia_monto\', \'deposito_garantia_letras\', \'meses_deposito\'],\n    content: `DE LOS DEP\303\223SITOS DE GARANT\303\215A: EL INQUILINO entrega en este acto a EL PROPIETARIO la suma de {{deposito_garantia_monto}} ({{deposito_garantia_letras}}), equivalente a {{meses_deposito}} meses de dep\303\263sito de garant\303\255a, el cual ser\303\241 retenido como fianza para responder por da\303\261os a la propiedad o incumplimientos de pago de servicios seg\303\272n las disposiciones de la Ley No. 4314 de la Rep\303\272blica Dominicana. Dicho monto no podr\303\241 ser imputado al pago de mensualidades corrientes.`,\n  },\n  {\n    id: \'clausula_mora_penalidades\',\n    title: \'Cl\303\241usula de Intereses Moratorios y Penalidad\',\n    category: \'Mora y Penalidades\',\n    version: \'2.0\',\n    isProtected: true,\n    isActiveDefault: true,\n    description: \'Penalidad porcentual por retraso en el pago mensual\',\n    variablesReferenced: [\'porcentaje_mora\', \'dias_gracia\'],\n    content: `DE LA MORA EN EL PAGO: Las partes convienen expresamente que la falta de pago de la mensualidad convenida dentro de los primeros {{dias_gracia}} d\303\255as de cada mes generar\303\241 un recargo moratorio mensual del {{porcentaje_mora}}% calculado sobre el monto adeudado, sin necesidad de requerimiento o intimaci\303\263n judicial previa.`,\n  },\n  {\n    id: \'clausula_mantenimiento_condominio\',\n    title: \'Cl\303\241usula de Cuota de Mantenimiento y Condominio\',\n    category: \'Mantenimiento\',\n    version: \'1.0\',\n    isProtected: false,\n    isActiveDefault: false,\n    conditionVariableId: \'incluye_mantenimiento\',\n    conditionExpectedValue: true,\n    description: \'Obligaciones del r\303\251gimen de condominio bajo Ley 5038\',\n    variablesReferenced: [\'mantenimiento_monto\', \'mantenimiento_letras\'],\n    content: `DEL MANTENIMIENTO DEL CONDOMINIO: La cuota mensual ordinaria de mantenimiento del condominio asciende a la suma de {{mantenimiento_monto}} ({{mantenimiento_letras}}), la cual correr\303\241 por cuenta de EL INQUILINO y deber\303\241 ser cancelada puntualmente junto con la renta mensual para el sostenimiento de las \303\241reas comunes conforme a la Ley No. 5038 de Condominios.`,\n  },\n  {\n    id: \'clausula_competencia_tribunales\',\n    title: \'Cl\303\241usula de Elecci\303\263n de Domicilio y Jurisdicci\303\263n (RD)\',\n    category: \'Jurisdicci\303\263n\',\n    version: \'1.1\',\n    isProtected: true,\n    isActiveDefault: true,\n    description: \'Atribuci\303\263n de competencia a los tribunales del Distrito Judicial dominicano\',\n    variablesReferenced: [\'distrito_judicial\'],\n    content: `DE LA JURISDICCI\303\223N COMPETENTE: Para la ejecuci\303\263n del presente contrato y de todas sus consecuencias legales, las partes eligen domicilio en las direcciones indicadas al encabezado y convienen expresamente someter cualquier diferendo o litis a la jurisdicci\303\263n y competencia territorial de los Tribunales Ordinarios de la Rep\303\272blica Dominicana correspondientes al {{distrito_judicial}}, con renuncia expresa a cualquier otro fuero que pudiera corresponderles.`,\n  },\n  {\n    id: \'clausula_terminacion_anticipada\',\n    title: \'Cl\303\241usula de Rescisi\303\263n y Terminaci\303\263n Anticipada\',\n    category: \'Terminaci\303\263n\',\n    version: \'1.0\',\n    isProtected: true,\n    isActiveDefault: true,\n    description: \'Plazos de preaviso y penalidad por desalojo voluntario anticipado\',\n    variablesReferenced: [\'dias_preaviso_terminacion\', \'penalidad_meses_rescisi\303\263n\'],\n    content: `DE LA TERMINACI\303\223N ANTICIPADA: Si cualquiera de las partes decidiese rescindir el presente acuerdo antes del vencimiento del t\303\251rmino estipulado, deber\303\241 notificar a la otra parte por escrito con una antelaci\303\263n no menor de {{dias_preaviso_terminacion}} d\303\255as y pagar como indemnizaci\303\263n compensatoria una suma equivalente a {{penalidad_meses_rescisi\303\263n}} mensualidades de renta.`,\n  },\n  {\n    id: \'clausula_confidencialidad\',\n    title: \'Cl\303\241usula de Confidencialidad y Secreto Profesional\',\n    category: \'Confidencialidad\',\n    version: \'1.0\',\n    isProtected: false,\n    isActiveDefault: false,\n    conditionVariableId: \'requiere_confidencialidad\',\n    conditionExpectedValue: true,\n    description: \'Protecci\303\263n de secretos comerciales y datos protegidos bajo Ley 172-13 de RD\',\n    variablesReferenced: [\'plazo_confidencialidad_anos\'],\n    content: `DE LA CONFIDENCIALIDAD: Toda la informaci\303\263n t\303\251cnica, jur\303\255dica, comercial y financiera intercambiada con motivo del presente contrato tiene car\303\241cter estrictamente confidencial. Las partes se comprometen a no divulgarla a terceros durante la vigencia del acuerdo y por un per\303\255odo de {{plazo_confidencialidad_anos}} a\303\261os posteriores a su terminaci\303\263n, bajo pena de resarcimiento de da\303\261os y perjuicios conforme a la Ley No. 172-13 sobre Protecci\303\263n de Datos de la Rep\303\272blica Dominicana.`,\n  },\n];\n\n/**\n * Process conditional clauses in a template text\n * Block syntax:\n * {{#clause:clause_id}}\n * ... clause content ...\n * {{/clause:clause_id}}\n */\nexport function renderConditionalClauses(\n  content: string,\n  clauses: LegalClause[],\n  formValues: Record<string, any>\n): string {\n  if (!content) return \'\';\n\n  let processed = content;\n\n  for (const clause of clauses) {\n    const clauseTagRegex = new RegExp(\n      `\\\\{\\\\{#clause:${clause.id}\\\\}\\\\}([\\\\s\\\\S]*?)\\\\{\\\\{/clause:${clause.id}\\\\}\\\\}`,\n      \'g\'\n    );\n\n    let isIncluded = true;\n\n    if (clause.conditionVariableId) {\n      const actualVal = formValues[clause.conditionVariableId];\n      if (clause.conditionExpectedValue !== undefined) {\n        isIncluded = actualVal === clause.conditionExpectedValue;\n      } else {\n        isIncluded = Boolean(actualVal);\n      }\n    }\n\n    if (isIncluded) {\n      // Keep clause inner content\n      processed = processed.replace(clauseTagRegex, (_match, inner) => inner.trim());\n    } else {\n      // Strip out the conditional clause\n      processed = processed.replace(clauseTagRegex, \'\');\n    }\n  }\n\n  // Also support generic {{#if variable}}...{{/if}}\n  processed = processed.replace(/\\{\\{#if\\s+([a-z0-9_]+)\\}\\}([\\s\\S]*?)\\{\\{\\/if\\}\\}/gi, (match, varName, inner) => {\n    const val = formValues[varName.toLowerCase()];\n    if (val && val !== \'false\' && val !== 0 && val !== \'0\') {\n      return inner.trim();\n    }\n    return \'\';\n  });\n\n  return processed;\n}\n"
    }
