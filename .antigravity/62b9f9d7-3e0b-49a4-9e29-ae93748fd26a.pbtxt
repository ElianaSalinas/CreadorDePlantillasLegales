        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export const INITIAL_TEMPLATES: LegalTemplate[] = ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    id: \'tpl_alquiler_residencial_rd\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    name: \'Contrato de Alquiler Residencial (RD)\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    description: \'Contrato est\303\241ndar de arrendamiento de vivienda bajo la Ley No. 4314 de Inquilinato y el C\303\263digo Civil Dominicano.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    category: \'Inmobiliario\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    jurisdiction: \'Rep\303\272blica Dominicana\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    version: \'2.0\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    status: \'PUBLISHED\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    author: \'Lic. Stephania Montero (Notaria P\303\272blica)\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    createdAt: \'2026-08-10T09:00:00Z\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    updatedAt: \'2026-08-15T05:30:00Z\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    content: `CONTRATO DE ARRENDAMIENTO DE VIVIENDA URBANA"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "ENTRE:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "De una parte, {{propietario_nombre}}, de nacionalidad {{propietario_nacionalidad}}, mayor de edad, titular de la C\303\251dula de Identidad y Electoral No. {{propietario_cedula}}, domiciliado y residente en {{propietario_direccion}}, a quien en lo que sigue del presente contrato se denominar\303\241 EL PROPIETARIO o LA PRIMERA PARTE;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Y de la otra parte, {{inquilino_nombre}}, de nacionalidad {{inquilino_nacionalidad}}, mayor de edad, titular de la C\303\251dula de Identidad y Electoral No. {{inquilino_cedula}}, domiciliado y residente en {{inquilino_direccion}}, a quien en lo sucesivo se denominar\303\241 EL INQUILINO o LA SEGUNDA PARTE."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "SE HA CONVENIDO Y PACTADO LO SIGUIENTE:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "PRIMERO: OBJETO DEL CONTRATO: EL PROPIETARIO concede en calidad de alquiler a EL INQUILINO, quien acepta conforme, el inmueble ubicado en: {{inmueble_direccion}}, el cual ser\303\241 destinado exclusivamente para vivienda familiar del inquilino y sus dependientes directos."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "SEGUNDO: PRECIO DEL ALQUILER: El precio mensual del arrendamiento pactado libremente entre las partes es de {{renta_mensual_monto}} ({{renta_mensual_letras}}), pagaderos por mensualidades adelantadas dentro de los primeros {{dias_gracia}} d\303\255as de cada mes mediante transferencia bancaria o pago directo."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "TERCERO: VIGENCIA Y T\303\211RMINO: El presente contrato tendr\303\241 una duraci\303\263n de {{duracion_meses}} meses, iniciando en fecha {{fecha_inicio}} y finalizando en fecha {{fecha_fin}}, renovable por mutuo acuerdo escrito entre las partes con no menos de {{dias_preaviso_terminacion}} d\303\255as de anticipaci\303\263n."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "{{#clause:clausula_deposito_garantia}}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "CUARTO: DE LOS DEP\303\223SITOS DE GARANT\303\215A: EL INQUILINO entrega en este acto a EL PROPIETARIO la suma de {{deposito_garantia_monto}} ({{deposito_garantia_letras}}), equivalente a {{meses_deposito}} meses de dep\303\263sito de garant\303\255a, el cual ser\303\241 retenido como fianza para responder por da\303\261os a la propiedad o incumplimientos de pago de servicios seg\303\272n las disposiciones de la Ley No. 4314 de la Rep\303\272blica Dominicana. Dicho monto no podr\303\241 ser imputado al pago de mensualidades corrientes."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "{{/clause:clausula_deposito_garantia}}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "{{#clause:clausula_mantenimiento_condominio}}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "QUINTO: CUOTA DE MANTENIMIENTO: La cuota mensual ordinaria de mantenimiento del condominio asciende a la suma de {{mantenimiento_monto}} ({{mantenimiento_letras}}), la cual correr\303\241 por cuenta de EL INQUILINO y deber\303\241 ser cancelada puntualmente junto con la renta mensual para el sostenimiento de las \303\241reas comunes conforme a la Ley No. 5038 de Condominios."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "{{/clause:clausula_mantenimiento_condominio}}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "{{#clause:clausula_mora_penalidades}}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "SEXTO: DE LA MORA EN EL PAGO: Las partes convienen expresamente que la falta de pago de la mensualidad convenida dentro de los primeros {{dias_gracia}} d\303\255as de cada mes generar\303\241 un recargo moratorio mensual del {{porcentaje_mora}}% calculado sobre el monto adeudado, sin necesidad de requerimiento o intimaci\303\263n judicial previa."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "{{/clause:clausula_mora_penalidades}}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "{{#clause:clausula_competencia_tribunales}}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "S\303\211PTIMO: DE LA JURISDICCI\303\223N COMPETENTE: Para la ejecuci\303\263n del presente contrato y de todas sus consecuencias legales, las partes eligen domicilio en las direcciones indicadas al encabezado y convienen expresamente someter cualquier diferendo o litis a la jurisdicci\303\263n y competencia territorial de los Tribunales Ordinarios de la Rep\303\272blica Dominicana correspondientes al {{distrito_judicial}}, con renuncia expresa a cualquier otro fuero que pudiera corresponderles."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "{{/clause:clausula_competencia_tribunales}}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "HECHO Y FIRMADO en dos (2) originales de un mismo tenor y efecto, en {{ciudad_firma}}, Rep\303\272blica Dominicana, {{fecha_firma_notarial}}."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "________________________________________"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "{{propietario_nombre}}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "EL PROPIETARIO"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "C\303\251dula: {{propietario_cedula}}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
