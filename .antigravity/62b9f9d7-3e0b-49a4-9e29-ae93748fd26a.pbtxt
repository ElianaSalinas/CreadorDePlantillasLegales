  file_change {
    absolute_path_uri: "file:///src/components/VersionModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { History, RotateCcw, Plus, X, Calendar, User, CheckCircle2 } from \'lucide-react\';\nimport { useAppStore } from \'../store/useAppStore\';\n\ninterface VersionModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const VersionModal: React.FC<VersionModalProps> = ({ isOpen, onClose }) => {\n  const { activeTemplate, saveVersion, restoreVersion } = useAppStore();\n  const [description, setDescription] = useState(\'\');\n  const [isSavingNew, setIsSavingNew] = useState(false);\n\n  if (!isOpen || !activeTemplate) return null;\n\n  const versions = activeTemplate.versions || [];\n\n  const handleSaveSnapshot = (e: React.FormEvent) => {\n    e.preventDefault();\n    saveVersion(activeTemplate.id, description);\n    setDescription(\'\');\n    setIsSavingNew(false);\n  };\n\n  const handleRestore = (versionNumber: string) => {\n    if (confirm(`\302\277Restaurar la plantilla al estado de la versi\303\263n v${versionNumber}?`)) {\n      restoreVersion(activeTemplate.id, versionNumber);\n      onClose();\n    }\n  };\n\n  return (\n    <div className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 z-50\">\n      <div className=\"bg-white rounded-2xl max-w-xl w-full p-6 shadow-2xl border border-slate-200 max-h-[90vh] overflow-y-auto space-y-4\">\n        <div className=\"flex items-center justify-between pb-3 border-b border-slate-100\">\n          <div className=\"flex items-center space-x-2\">\n            <div className=\"w-8 h-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center\">\n              <History className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h3 className=\"font-serif font-bold text-base text-slate-900\">Historial de Versiones (US-51)</h3>\n              <p className=\"text-xs text-slate-500\">Versi\303\263n actual: v{activeTemplate.version}</p>\n            </div>\n          </div>\n\n          <button onClick={onClose} className=\"text-slate-400 hover:text-slate-600\">\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Create new snapshot */}\n        {!isSavingNew ? (\n          <button\n            onClick={() => setIsSavingNew(true)}\n            className=\"w-full py-2.5 px-4 rounded-xl border-2 border-dashed border-slate-300 hover:border-blue-500 text-xs font-semibold text-slate-700 hover:text-blue-600 flex items-center justify-center space-x-2 transition-colors\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            <span>Crear Snapshot de Nueva Versi\303\263n</span>\n          </button>\n        ) : (\n          <form onSubmit={handleSaveSnapshot} className=\"bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-3 text-xs\">\n            <label className=\"block font-semibold text-slate-700\">Descripci\303\263n del Cambio o Novedades</label>\n            <input\n              type=\"text\"\n              required\n              value={description}\n              onChange={(e) => setDescription(e.target.value)}\n              placeholder=\"ej. Se agregaron cl\303\241usulas notariales de mora y fianza\"\n              className=\"w-full px-3 py-2 bg-white border border-slate-200 rounded-lg focus:outline-none\"\n            />\n            <div className=\"flex justify-end space-x-2\">\n              <button\n                type=\"button\"\n                onClick={() => setIsSavingNew(false)}\n                className=\"px-3 py-1.5 rounded-md bg-slate-200 text-slate-700\"\n              >\n                Cancelar\n              </button>\n              <button\n                type=\"submit\"\n                className=\"px-3 py-1.5 rounded-md bg-blue-600 hover:bg-blue-500 text-white font-semibold\"\n              >\n                Guardar Versi\303\263n\n              </button>\n            </div>\n          </form>\n        )}\n\n        {/* Versions list */}\n        <div className=\"divide-y divide-slate-100 max-h-72 overflow-y-auto\">\n          {versions.length === 0 ? (\n            <p className=\"text-xs text-slate-400 text-center py-6\">No hay versiones previas registradas.</p>\n          ) : (\n            versions.map((ver) => {\n              const isCurrent = ver.version === activeTemplate.version;\n\n              return (\n                <div key={ver.version} className=\"py-3 flex items-center justify-between gap-3\">\n                  <div>\n                    <div className=\"flex items-center space-x-2\">\n                      <span className=\"font-mono font-bold text-xs text-blue-700 bg-blue-50 px-2 py-0.5 rounded\">\n                        v{ver.version}\n                      </span>\n                      {isCurrent && (\n                        <span className=\"text-[10px] bg-emerald-50 text-emerald-700 border border-emerald-200 px-1.5 py-0.5 rounded font-semibold\">\n                          Actual\n                        </span>\n                      )}\n                      <span className=\"text-xs font-medium text-slate-800\">{ver.description}</span>\n                    </div>\n\n                    <div className=\"flex items-center space-x-3 text-[11px] text-slate-400 mt-1\">\n                      <span className=\"flex items-center space-x-1\">\n                        <Calendar className=\"w-3 h-3\" />\n                        <span>{new Date(ver.createdAt).toLocaleString()}</span>\n                      </span>\n                      <span className=\"flex items-center space-x-1\">\n                        <User className=\"w-3 h-3\" />\n                        <span>{ver.createdBy}</span>\n                      </span>\n                    </div>\n                  </div>\n\n                  {!isCurrent && (\n                    <button\n                      onClick={() => handleRestore(ver.version)}\n                      className=\"px-2.5 py-1 text-xs font-semibold rounded bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center space-x-1\"\n                    >\n                      <RotateCcw className=\"w-3 h-3\" />\n                      <span>Restaurar</span>\n                    </button>\n                  )}\n                </div>\n              );\n            })\n          )}\n        </div>\n\n        <div className=\"flex justify-end pt-2 border-t border-slate-100\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-2 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700\"\n          >\n            Cerrar\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
