        }
        lines {
          text: "export function enteroALetras(n: number): string {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (n === 0) return \'CERO\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (n < 0) return \'MENOS \' + enteroALetras(Math.abs(n));"
