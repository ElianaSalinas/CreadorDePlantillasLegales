  file_change {
    absolute_path_uri: "file:///src/components/HealthCheckModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport {\n  ShieldCheck,\n  CheckCircle2,\n  AlertTriangle,\n  XCircle,\n  X,\n  Layers,\n  BookOpen,\n  GitBranch,\n  ArrowRight,\n  Sparkles,\n} from \'lucide-react\';\nimport { useAppStore } from \'../store/useAppStore\';\nimport { runTemplateHealthCheck } from \'../core/healthCheck\';\n\ninterface HealthCheckModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const HealthCheckModal: React.FC<HealthCheckModalProps> = ({ isOpen, onClose }) => {\n  const { activeTemplate, setView, changeTemplateStatus } = useAppStore();\n\n  if (!isOpen || !activeTemplate) return null;\n\n  const health = runTemplateHealthCheck(activeTemplate);\n\n  return (\n    <div className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 z-50\">\n      <div className=\"bg-white rounded-2xl max-w-2xl w-full p-6 shadow-2xl border border-slate-200 max-h-[90vh] overflow-y-auto space-y-5\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between pb-4 border-b border-slate-100\">\n          <div className=\"flex items-center space-x-3\">\n            <div\n              className={`w-10 h-10 rounded-xl flex items-center justify-center ${\n                health.status === \'HEALTHY\'\n                  ? \'bg-emerald-50 text-emerald-600\'\n                  : health.status === \'WARNING\'\n                  ? \'bg-amber-50 text-amber-600\'\n                  : \'bg-rose-50 text-rose-600\'\n              }`}\n            >\n              <ShieldCheck className=\"w-6 h-6\" />\n            </div>\n            <div>\n              <h3 className=\"font-serif font-bold text-lg text-slate-900\">\n                Diagn\303\263stico de Salud de Plantilla (Health Check)\n              </h3>\n              <p className=\"text-xs text-slate-500\">\n                Auditor\303\255a estructural estricta bajo US-56..US-60 y Reglas de Negocio RN-067..RN-071\n              </p>\n            </div>\n          </div>\n\n          <button onClick={onClose} className=\"text-slate-400 hover:text-slate-600\">\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Score & Publication Readiness Card */}\n        <div\n          className={`p-5 rounded-xl border flex items-center justify-between ${\n            health.status === \'HEALTHY\'\n              ? \'bg-emerald-50/50 border-emerald-200\'\n              : health.status === \'WARNING\'\n              ? \'bg-amber-50/50 border-amber-200\'\n              : \'bg-rose-50/50 border-rose-200\'\n          }`}\n        >\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"text-2xl font-bold font-serif text-slate-900\">{health.score} / 100</span>\n              <span\n                className={`text-xs px-2.5 py-0.5 rounded-full font-bold uppercase ${\n                  health.status === \'HEALTHY\'\n                    ? \'bg-emerald-100 text-emerald-800\'\n                    : health.status === \'WARNING\'\n                    ? \'bg-amber-100 text-amber-800\'\n                    : \'bg-rose-100 text-rose-800\'\n                }`}\n              >\n                {health.status}\n              </span>\n            </div>\n            <p className=\"text-xs text-slate-600 mt-1\">\n              {health.canPublish\n                ? \'La plantilla cumple con todos los requisitos estructurales para publicaci\303\263n.\'\n                : \'La publicaci\303\263n est\303\241 bloqueada hasta resolver todos los errores cr\303\255ticos.\'}\n            </p>\n          </div>\n\n          {health.canPublish && activeTemplate.status !== \'PUBLISHED\' && (\n            <button\n              onClick={() => {\n                changeTemplateStatus(activeTemplate.id, \'PUBLISHED\');\n                onClose();\n              }}\n              className=\"px-4 py-2 rounded-lg text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white shadow-sm\"\n            >\n              Publicar Plantilla\n            </button>\n          )}\n        </div>\n\n        {/* Breakdown Items */}\n        <div className=\"space-y-3 text-xs\">\n          {/* 1. Missing Variable References (Errors) */}\n          {health.missingVariableReferences.length > 0 && (\n            <div className=\"p-3.5 bg-rose-50 border border-rose-200 rounded-xl space-y-1.5\">\n              <div className=\"flex items-center space-x-2 text-rose-800 font-bold\">\n                <XCircle className=\"w-4 h-4 text-rose-600\" />\n                <span>Variables no declaradas en el diccionario ({health.missingVariableReferences.length})</span>\n              </div>\n              <p className=\"text-rose-700 text-[11px]\">\n                Aparecen etiquetas {`{{tag}}`} en el texto pero no est\303\241n registradas en la lista de variables:\n              </p>\n              <div className=\"flex flex-wrap gap-1 pt-1\">\n                {health.missingVariableReferences.map((tag) => (\n                  <span key={tag} className=\"font-mono bg-white text-rose-700 px-2 py-0.5 rounded border border-rose-200 font-medium\">\n                    {`{{${tag}}}`}\n                  </span>\n                ))}\n              </div>\n            </div>\n          )}\n\n          {/* 2. Missing Clause References (Errors) */}\n          {health.missingClauseReferences.length > 0 && (\n            <div className=\"p-3.5 bg-rose-50 border border-rose-200 rounded-xl space-y-1.5\">\n              <div className=\"flex items-center space-x-2 text-rose-800 font-bold\">\n                <XCircle className=\"w-4 h-4 text-rose-600\" />\n                <span>Cl\303\241usulas inexistentes referenciadas ({health.missingClauseReferences.length})</span>\n              </div>\n              <div className=\"flex flex-wrap gap-1\">\n                {health.missingClauseReferences.map((cId) => (\n                  <span key={cId} className=\"font-mono bg-white text-rose-700 px-2 py-0.5 rounded border border-rose-200\">\n                    {cId}\n                  </span>\n                ))}\n              </div>\n            </div>\n          )}\n\n          {/* 3. Circular Dependencies (Errors) */}\n          {health.circularDependencies.length > 0 && (\n            <div className=\"p-3.5 bg-rose-50 border border-rose-200 rounded-xl space-y-1.5\">\n              <div className=\"flex items-center space-x-2 text-rose-800 font-bold\">\n                <XCircle className=\"w-4 h-4 text-rose-600\" />\n                <span>Dependencias Circulares Detectadas</span>\n              </div>\n              <ul className=\"list-disc list-inside text-rose-700 text-[11px] space-y-1\">\n                {health.circularDependencies.map((dep, i) => (\n                  <li key={i}>{dep}</li>\n                ))}\n              </ul>\n            </div>\n          )}\n\n          {/* 4. Orphan Variables (Warnings) */}\n          {health.orphanVariables.length > 0 && (\n            <div className=\"p-3.5 bg-amber-50 border border-amber-200 rounded-xl space-y-1.5\">\n              <div className=\"flex items-center space-x-2 text-amber-800 font-bold\">\n                <AlertTriangle className=\"w-4 h-4 text-amber-600\" />\n                <span>Variables hu\303\251rfanas ({health.orphanVariables.length})</span>\n              </div>\n              <p className=\"text-amber-700 text-[11px]\">\n                Est\303\241n declaradas en el diccionario pero nunca se invocan en el texto del contrato:\n              </p>\n              <div className=\"flex flex-wrap gap-1 pt-1\">\n                {health.orphanVariables.map((tag) => (\n                  <span key={tag} className=\"font-mono bg-white text-amber-700 px-2 py-0.5 rounded border border-amber-200 font-medium\">\n                    {`{{${tag}}}`}\n                  </span>\n                ))}\n              </div>\n            </div>\n          )}\n\n          {/* All Good */}\n          {health.status === \'HEALTHY\' && (\n            <div className=\"p-4 bg-emerald-50 border border-emerald-200 rounded-xl text-emerald-800 flex items-center space-x-3\">\n              <CheckCircle2 className=\"w-5 h-5 text-emerald-600 shrink-0\" />\n              <div>\n                <div className=\"font-bold\">Estructura Impecable</div>\n                <div className=\"text-[11px] text-emerald-700\">\n                  Todas las variables, cl\303\241usulas y reglas condicionales est\303\241n sincronizadas correctamente.\n                </div>\n              </div>\n            </div>\n          )}\n        </div>\n\n        {/* Footer */}\n        <div className=\"flex justify-end pt-4 border-t border-slate-100\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-2 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700\"\n          >\n            Cerrar Diagn\303\263stico\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
