  file_change {
    absolute_path_uri: "file:///src/components/ClauseLibrary.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  BookOpen,\n  Plus,\n  Edit2,\n  Trash2,\n  CheckCircle2,\n  Layers,\n  Search,\n  Scale,\n  ShieldAlert,\n  HelpCircle,\n  X,\n  FileCheck,\n} from \'lucide-react\';\nimport { useAppStore } from \'../store/useAppStore\';\nimport { LegalClause, ClauseCategory } from \'../types\';\nimport { extractReferencedVariables } from \'../core/variableEngine\';\nimport { DEFAULT_DOMINICAN_CLAUSES } from \'../core/clauseEngine\';\n\nexport const ClauseLibrary: React.FC = () => {\n  const { activeTemplate, addClause, updateClause, deleteClause, setView } = useAppStore();\n\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'ALL\');\n  const [isCreatingNew, setIsCreatingNew] = useState(false);\n  const [editingClause, setEditingClause] = useState<LegalClause | null>(null);\n\n  // Form\n  const [formId, setFormId] = useState(\'\');\n  const [formTitle, setFormTitle] = useState(\'\');\n  const [formCategory, setFormCategory] = useState<ClauseCategory>(\'Inmobiliario\');\n  const [formContent, setFormContent] = useState(\'\');\n  const [formDescription, setFormDescription] = useState(\'\');\n\n  if (!activeTemplate) {\n    return (\n      <div className=\"max-w-4xl mx-auto py-16 text-center\">\n        <p className=\"text-slate-500\">Selecciona una plantilla para gestionar sus cl\303\241usulas jur\303\255dicas.</p>\n        <button\n          onClick={() => setView(\'TEMPLATES\')}\n          className=\"mt-4 px-4 py-2 bg-blue-600 text-white text-xs font-semibold rounded-lg\"\n        >\n          Ver Plantillas\n        </button>\n      </div>\n    );\n  }\n\n  const resetForm = () => {\n    setFormId(\'\');\n    setFormTitle(\'\');\n    setFormCategory(\'Inmobiliario\');\n    setFormContent(\'\');\n    setFormDescription(\'\');\n    setEditingClause(null);\n    setIsCreatingNew(false);\n  };\n\n  const handleOpenCreate = () => {\n    resetForm();\n    setFormId(`clausula_${Date.now()}`);\n    setIsCreatingNew(true);\n  };\n\n  const handleOpenEdit = (clause: LegalClause) => {\n    setEditingClause(clause);\n    setFormId(clause.id);\n    setFormTitle(clause.title);\n    setFormCategory(clause.category);\n    setFormContent(clause.content);\n    setFormDescription(clause.description || \'\');\n    setIsCreatingNew(true);\n  };\n\n  const handleSave = (e: React.FormEvent) => {\n    e.preventDefault();\n\n    const referencedVars = extractReferencedVariables(formContent);\n\n    const payload: LegalClause = {\n      id: formId.trim().toLowerCase().replace(/[^a-z0-9_]/g, \'_\'),\n      title: formTitle,\n      category: formCategory,\n      content: formContent,\n      description: formDescription,\n      variablesReferenced: referencedVars,\n      version: editingClause ? `${Number(editingClause.version || 1) + 1}.0` : \'1.0\',\n      isStandard: false,\n    };\n\n    if (editingClause) {\n      updateClause(activeTemplate.id, editingClause.id, payload);\n    } else {\n      addClause(activeTemplate.id, payload);\n    }\n\n    resetForm();\n  };\n\n  const handleAttachStandard = (stdClause: LegalClause) => {\n    addClause(activeTemplate.id, stdClause);\n  };\n\n  const attachedClauseIds = new Set(activeTemplate.clauses.map((c) => c.id));\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6\">\n      {/* Top Banner */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-6 rounded-2xl shadow-xs border border-slate-200\">\n        <div>\n          <div className=\"flex items-center space-x-2\">\n            <span className=\"text-xs font-semibold text-indigo-600 uppercase tracking-wider bg-indigo-50 px-2.5 py-0.5 rounded-md border border-indigo-100\">\n              Biblioteca Jur\303\255dica Modular (RN-025, RN-029)\n            </span>\n            <span className=\"text-xs text-slate-400 font-mono\">\n              Cl\303\241usulas vinculadas: {activeTemplate.clauses.length}\n            </span>\n          </div>\n          <h1 className=\"text-2xl font-bold text-slate-900 font-serif mt-1\">\n            Gesti\303\263n de Cl\303\241usulas \342\200\242 {activeTemplate.name}\n          </h1>\n          <p className=\"text-slate-500 text-xs mt-1\">\n            Las cl\303\241usulas son bloques reutilizables de redacci\303\263n legal con control condicional y numeraci\303\263n adaptativa.\n          </p>\n        </div>\n\n        <button\n          onClick={handleOpenCreate}\n          className=\"flex items-center space-x-2 px-4 py-2.5 rounded-lg text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white shadow-sm transition-all\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          <span>Crear Cl\303\241usula</span>\n        </button>\n      </div>\n\n      {/* Cl\303\241usulas Vinculadas a la Plantilla Activa */}\n      <div className=\"bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden\">\n        <div className=\"bg-slate-50/80 px-5 py-3 border-b border-slate-200 flex items-center justify-between\">\n          <span className=\"font-semibold text-xs text-slate-700 tracking-wide uppercase flex items-center space-x-2\">\n            <BookOpen className=\"w-3.5 h-3.5 text-indigo-600\" />\n            <span>Cl\303\241usulas en esta plantilla ({activeTemplate.clauses.length})</span>\n          </span>\n        </div>\n\n        <div className=\"divide-y divide-slate-100\">\n          {activeTemplate.clauses.length === 0 ? (\n            <div className=\"p-8 text-center text-slate-400 text-xs\">\n              No hay cl\303\241usulas asociadas. Agrega una cl\303\241usula est\303\241ndar o crea una personalizada.\n            </div>\n          ) : (\n            activeTemplate.clauses.map((clause) => (\n              <div key={clause.id} className=\"p-5 hover:bg-slate-50/50 transition-colors space-y-3\">\n                <div className=\"flex items-start justify-between gap-4\">\n                  <div>\n                    <div className=\"flex items-center space-x-2\">\n                      <h4 className=\"font-serif font-bold text-sm text-slate-900\">{clause.title}</h4>\n                      <span className=\"text-[10px] px-2 py-0.5 rounded bg-indigo-50 text-indigo-700 border border-indigo-100 font-medium\">\n                        {clause.category}\n                      </span>\n                      <span className=\"text-[10px] font-mono text-slate-400\">ID: {clause.id}</span>\n                    </div>\n                    {clause.description && (\n                      <p className=\"text-xs text-slate-500 mt-0.5\">{clause.description}</p>\n                    )}\n                  </div>\n\n                  <div className=\"flex items-center space-x-2\">\n                    <button\n                      onClick={() => handleOpenEdit(clause)}\n                      className=\"p-1.5 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-md transition-colors\"\n                      title=\"Editar Cl\303\241usula\"\n                    >\n                      <Edit2 className=\"w-4 h-4\" />\n                    </button>\n                    <button\n                      onClick={() => {\n                        if (confirm(`\302\277Desvincular la cl\303\241usula \"${clause.title}\" de la plantilla?`)) {\n                          deleteClause(activeTemplate.id, clause.id);\n                        }\n                      }}\n                      className=\"p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-md transition-colors\"\n                      title=\"Desvincular Cl\303\241usula\"\n                    >\n                      <Trash2 className=\"w-4 h-4\" />\n                    </button>\n                  </div>\n                </div>\n\n                {/* Content preview */}\n                <div className=\"bg-slate-50 p-3 rounded-lg border border-slate-100 text-xs font-serif leading-relaxed text-slate-700 whitespace-pre-wrap\">\n                  {clause.content}\n                </div>\n\n                {/* Referenced variables chips */}\n                {clause.variablesReferenced && clause.variablesReferenced.length > 0 && (\n                  <div className=\"flex items-center space-x-2 text-[11px] text-slate-500\">\n                    <span>Variables requeridas:</span>\n                    <div className=\"flex flex-wrap gap-1\">\n                      {clause.variablesReferenced.map((v) => (\n                        <span key={v} className=\"bg-blue-50 text-blue-700 px-1.5 py-0.5 rounded font-mono text-[10px]\">\n                          {`{{${v}}}`}\n                        </span>\n                      ))}\n                    </div>\n                  </div>\n                )}\n              </div>\n            ))\n          )}\n        </div>\n      </div>\n\n      {/* Repositorio de Cl\303\241usulas Est\303\241ndar de Rep\303\272blica Dominicana */}\n      <div className=\"bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden\">\n        <div className=\"bg-slate-50/80 px-5 py-3 border-b border-slate-200 flex items-center justify-between\">\n          <span className=\"font-semibold text-xs text-slate-700 tracking-wide uppercase flex items-center space-x-2\">\n            <Scale className=\"w-3.5 h-3.5 text-indigo-600\" />\n            <span>Biblioteca Est\303\241ndar de Cl\303\241usulas Notariales Dominicanas</span>\n          </span>\n          <span className=\"text-[11px] text-slate-500\">Leyes 4314, 5038, 140-15</span>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 p-5\">\n          {DEFAULT_DOMINICAN_CLAUSES.map((std) => {\n            const isAttached = attachedClauseIds.has(std.id);\n\n            return (\n              <div\n                key={std.id}\n                className={`p-4 rounded-xl border transition-all ${\n                  isAttached\n                    ? \'bg-indigo-50/20 border-indigo-200\'\n                    : \'bg-white border-slate-200 hover:border-slate-300\'\n                }`}\n              >\n                <div className=\"flex items-start justify-between gap-2\">\n                  <div>\n                    <h5 className=\"font-serif font-bold text-xs text-slate-900\">{std.title}</h5>\n                    <span className=\"text-[10px] text-indigo-600 font-medium\">{std.category}</span>\n                  </div>\n\n                  {isAttached ? (\n                    <span className=\"text-[10px] font-semibold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 flex items-center space-x-1\">\n                      <CheckCircle2 className=\"w-3 h-3\" />\n                      <span>Vinculada</span>\n                    </span>\n                  ) : (\n                    <button\n                      onClick={() => handleAttachStandard(std)}\n                      className=\"px-2.5 py-1 text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg transition-colors flex items-center space-x-1\"\n                    >\n                      <Plus className=\"w-3 h-3\" />\n                      <span>Vincular</span>\n                    </button>\n                  )}\n                </div>\n\n                <p className=\"text-xs text-slate-600 mt-2 line-clamp-3 leading-relaxed font-serif\">\n                  {std.content}\n                </p>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* Create / Edit Modal */}\n      {isCreatingNew && (\n        <div className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 z-50\">\n          <div className=\"bg-white rounded-2xl max-w-2xl w-full p-6 shadow-2xl border border-slate-200 max-h-[90vh] overflow-y-auto\">\n            <div className=\"flex items-center justify-between pb-4 border-b border-slate-100\">\n              <h3 className=\"font-serif font-bold text-lg text-slate-900\">\n                {editingClause ? \'Editar Cl\303\241usula Jur\303\255dica\' : \'Nueva Cl\303\241usula Legal\'}\n              </h3>\n              <button onClick={resetForm} className=\"text-slate-400 hover:text-slate-600\">\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            <form onSubmit={handleSave} className=\"space-y-4 pt-4 text-xs\">\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"block font-semibold text-slate-700 mb-1\">\n                    Identificador de Cl\303\241usula <span className=\"text-rose-500\">*</span>\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    value={formId}\n                    onChange={(e) => setFormId(e.target.value)}\n                    placeholder=\"clausula_confidencialidad\"\n                    className=\"w-full px-3 py-2 font-mono bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block font-semibold text-slate-700 mb-1\">Categor\303\255a</label>\n                  <select\n                    value={formCategory}\n                    onChange={(e) => setFormCategory(e.target.value as ClauseCategory)}\n                    className=\"w-full px-3 py-2 border border-slate-200 rounded-lg focus:outline-none\"\n                  >\n                    <option value=\"Inmobiliario\">Inmobiliario</option>\n                    <option value=\"Penalidades\">Penalidades y Mora</option>\n                    <option value=\"Jurisdicci\303\263n\">Jurisdicci\303\263n y Tribunales</option>\n                    <option value=\"Garant\303\255as\">Garant\303\255as y Dep\303\263sitos</option>\n                    <option value=\"Laboral\">Laboral</option>\n                    <option value=\"Confidencialidad\">Confidencialidad / NDA</option>\n                    <option value=\"General\">General</option>\n                  </select>\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block font-semibold text-slate-700 mb-1\">\n                  T\303\255tulo de la Cl\303\241usula <span className=\"text-rose-500\">*</span>\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  value={formTitle}\n                  onChange={(e) => setFormTitle(e.target.value)}\n                  placeholder=\"ej. CL\303\201USULA DE CONFIDENCIALIDAD Y NO DIVULGACI\303\223N\"\n                  className=\"w-full px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block font-semibold text-slate-700 mb-1\">Descripci\303\263n Jur\303\255dica</label>\n                <input\n                  type=\"text\"\n                  value={formDescription}\n                  onChange={(e) => setFormDescription(e.target.value)}\n                  placeholder=\"ej. Regula el secreto profesional y penalidades por revelaci\303\263n de secretos comerciales\"\n                  className=\"w-full px-3 py-2 border border-slate-200 rounded-lg focus:outline-none\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block font-semibold text-slate-700 mb-1\">\n                  Texto de la Cl\303\241usula <span className=\"text-rose-500\">*</span>\n                </label>\n                <textarea\n                  required\n                  rows={6}\n                  value={formContent}\n                  onChange={(e) => setFormContent(e.target.value)}\n                  placeholder=\"Escribe el texto de la cl\303\241usula. Puedes incluir {{variables}}...\"\n                  className=\"w-full p-3 font-serif text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500\"\n                />\n              </div>\n\n              <div className=\"flex justify-end space-x-2 pt-4 border-t border-slate-100\">\n                <button\n                  type=\"button\"\n                  onClick={resetForm}\n                  className=\"px-4 py-2 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700\"\n                >\n                  Cancelar\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"px-4 py-2 rounded-lg text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white shadow-sm\"\n                >\n                  Guardar Cl\303\241usula\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
