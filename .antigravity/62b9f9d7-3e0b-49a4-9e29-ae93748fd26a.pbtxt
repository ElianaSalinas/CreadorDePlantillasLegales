  file_change {
    absolute_path_uri: "file:///src/components/PaginatedDocumentPreview.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useMemo } from \'react\';\nimport {\n  FileText,\n  ZoomIn,\n  ZoomOut,\n  Maximize2,\n  BookOpen,\n  Layers,\n  ChevronLeft,\n  ChevronRight,\n  Printer,\n  Copy,\n  Check,\n} from \'lucide-react\';\n\ninterface PaginatedDocumentPreviewProps {\n  content: string;\n  templateName?: string;\n  className?: string;\n}\n\nexport const PaginatedDocumentPreview: React.FC<PaginatedDocumentPreviewProps> = ({\n  content,\n  templateName = \'Documento Legal\',\n  className = \'\',\n}) => {\n  const [zoom, setZoom] = useState<number>(100);\n  const [viewMode, setViewMode] = useState<\'PAGINATED\' | \'CONTINUOUS\'>(\'PAGINATED\');\n  const [copied, setCopied] = useState(false);\n\n  // Divide content into realistic legal pages\n  const pages = useMemo(() => {\n    if (!content || !content.trim()) {\n      return [\'\'];\n    }\n\n    // Check if explicit page breaks exist\n    if (content.includes(\'{{PAGE_BREAK}}\') || content.includes(\'=== SALTO DE P\303\201GINA ===\')) {\n      return content\n        .split(/\\{\\{PAGE_BREAK\\}\\}|=== SALTO DE P\303\201GINA ===/)\n        .map((p) => p.trim())\n        .filter(Boolean);\n    }\n\n    // Dynamic paragraph-based pagination\n    // Approx 2,200 characters or ~40-45 lines of legal text per letter page with 1.5 line height\n    const paragraphs = content.split(\'\\n\\n\');\n    const resultPages: string[] = [];\n    let currentPageText = \'\';\n    let currentLength = 0;\n    const MAX_PAGE_CHARS = 2100;\n\n    for (const para of paragraphs) {\n      const trimmed = para.trim();\n      if (!trimmed) continue;\n\n      if (currentLength + trimmed.length > MAX_PAGE_CHARS && currentPageText.length > 500) {\n        resultPages.push(currentPageText.trim());\n        currentPageText = trimmed;\n        currentLength = trimmed.length;\n      } else {\n        currentPageText += (currentPageText ? \'\\n\\n\' : \'\') + trimmed;\n        currentLength += trimmed.length;\n      }\n    }\n\n    if (currentPageText.trim()) {\n      resultPages.push(currentPageText.trim());\n    }\n\n    return resultPages.length > 0 ? resultPages : [\'\'];\n  }, [content]);\n\n  const handleCopy = () => {\n    navigator.clipboard.writeText(content);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  const handleZoomIn = () => setZoom((prev) => Math.min(prev + 10, 130));\n  const handleZoomOut = () => setZoom((prev) => Math.max(prev - 10, 70));\n  const handleResetZoom = () => setZoom(100);\n\n  return (\n    <div className={`flex flex-col h-full bg-slate-200/70 overflow-hidden ${className}`}>\n      {/* Document Toolbar */}\n      <div className=\"bg-white border-b border-slate-300 px-4 py-2 flex flex-wrap items-center justify-between gap-2 shrink-0 z-10 shadow-xs\">\n        <div className=\"flex items-center space-x-2\">\n          <span className=\"text-xs font-semibold text-slate-700 flex items-center space-x-1.5\">\n            <BookOpen className=\"w-3.5 h-3.5 text-blue-600\" />\n            <span>Previsualizaci\303\263n Notarial</span>\n          </span>\n\n          <span className=\"text-[11px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full font-medium border border-slate-200\">\n            {pages.length} {pages.length === 1 ? \'P\303\241gina\' : \'P\303\241ginas\'}\n          </span>\n        </div>\n\n        {/* Controls: Mode Switcher & Zoom */}\n        <div className=\"flex items-center space-x-2\">\n          {/* Mode Switcher */}\n          <div className=\"flex items-center bg-slate-100 p-0.5 rounded-lg border border-slate-200 text-xs\">\n            <button\n              onClick={() => setViewMode(\'PAGINATED\')}\n              className={`px-2.5 py-1 rounded-md font-medium transition-all ${\n                viewMode === \'PAGINATED\'\n                  ? \'bg-white text-slate-900 shadow-xs\'\n                  : \'text-slate-500 hover:text-slate-800\'\n              }`}\n            >\n              Hojas Paginadas\n            </button>\n            <button\n              onClick={() => setViewMode(\'CONTINUOUS\')}\n              className={`px-2.5 py-1 rounded-md font-medium transition-all ${\n                viewMode === \'CONTINUOUS\'\n                  ? \'bg-white text-slate-900 shadow-xs\'\n                  : \'text-slate-500 hover:text-slate-800\'\n              }`}\n            >\n              Continuo\n            </button>\n          </div>\n\n          {/* Zoom controls */}\n          <div className=\"flex items-center space-x-1 bg-slate-100 px-1 py-0.5 rounded-lg border border-slate-200 text-xs\">\n            <button\n              onClick={handleZoomOut}\n              disabled={zoom <= 70}\n              className=\"p-1 text-slate-600 hover:text-slate-900 disabled:opacity-30 rounded hover:bg-slate-200\"\n              title=\"Reducir zoom\"\n            >\n              <ZoomOut className=\"w-3.5 h-3.5\" />\n            </button>\n            <button\n              onClick={handleResetZoom}\n              className=\"px-1.5 text-[11px] font-mono text-slate-700 hover:text-blue-600\"\n              title=\"Restablecer 100%\"\n            >\n              {zoom}%\n            </button>\n            <button\n              onClick={handleZoomIn}\n              disabled={zoom >= 130}\n              className=\"p-1 text-slate-600 hover:text-slate-900 disabled:opacity-30 rounded hover:bg-slate-200\"\n              title=\"Aumentar zoom\"\n            >\n              <ZoomIn className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n\n          <button\n            onClick={handleCopy}\n            className=\"p-1.5 text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-lg transition-colors border border-slate-200\"\n            title=\"Copiar texto del documento\"\n          >\n            {copied ? <Check className=\"w-3.5 h-3.5 text-emerald-600\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n          </button>\n        </div>\n      </div>\n\n      {/* Pages Container with Vertical Scroll ONLY */}\n      <div className=\"flex-1 overflow-y-auto overflow-x-hidden p-4 sm:p-8 flex flex-col items-center space-y-6\">\n        {viewMode === \'PAGINATED\' ? (\n          pages.map((pageText, idx) => (\n            <div\n              key={idx}\n              style={{\n                width: `${Math.min(100, Math.max(60, zoom * 0.85))}%`,\n                maxWidth: \'780px\',\n                minWidth: \'280px\',\n              }}\n              className=\"bg-white rounded-md shadow-lg border border-slate-300 flex flex-col justify-between transition-all duration-150 relative overflow-hidden\"\n            >\n              {/* Notarial Sheet Top Header */}\n              <div className=\"px-8 sm:px-12 pt-8 pb-4 border-b border-slate-100 flex items-center justify-between text-[10px] text-slate-400 font-serif tracking-wider uppercase\">\n                <span className=\"truncate max-w-[280px]\">REP\303\232BLICA DOMINICANA \342\200\242 ACTO JUR\303\215DICO</span>\n                <span>{templateName}</span>\n              </div>\n\n              {/* Sheet Body Content */}\n              <div className=\"px-8 sm:px-12 py-6 text-slate-900 font-serif leading-relaxed text-sm sm:text-[15px] whitespace-pre-wrap break-words overflow-hidden selection:bg-amber-100\">\n                {pageText || (\n                  <p className=\"text-slate-400 italic text-center py-16 font-sans\">\n                    El documento est\303\241 vac\303\255o. Escribe o selecciona campos para previsualizar.\n                  </p>\n                )}\n              </div>\n\n              {/* Notarial Sheet Bottom Footer */}\n              <div className=\"px-8 sm:px-12 py-4 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400 font-serif\">\n                <span>Colegio Notarial Dominicano / CARD</span>\n                <span className=\"font-semibold text-slate-600\">\n                  P\303\241gina {idx + 1} de {pages.length}\n                </span>\n              </div>\n\n              {/* Left Margin Notarial Stamp Border Accent */}\n              <div className=\"absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-blue-600 via-indigo-600 to-slate-400 opacity-60\" />\n            </div>\n          ))\n        ) : (\n          /* Continuous Mode */\n          <div\n            style={{\n              width: `${Math.min(100, Math.max(60, zoom * 0.85))}%`,\n              maxWidth: \'820px\',\n              minWidth: \'280px\',\n            }}\n            className=\"bg-white rounded-lg shadow-lg border border-slate-300 p-8 sm:p-14 text-slate-900 font-serif leading-relaxed text-sm sm:text-[15px] whitespace-pre-wrap break-words selection:bg-amber-100 overflow-hidden\"\n          >\n            <div className=\"border-b border-slate-200 pb-4 mb-6 text-center text-xs text-slate-400 font-serif uppercase tracking-widest\">\n              REP\303\232BLICA DOMINICANA \342\200\242 {templateName}\n            </div>\n\n            {content || (\n              <p className=\"text-slate-400 italic text-center py-20 font-sans\">\n                El documento est\303\241 vac\303\255o. Escribe o selecciona campos para previsualizar.\n              </p>\n            )}\n\n            <div className=\"border-t border-slate-200 pt-6 mt-12 text-center text-xs text-slate-400 font-serif\">\n              *** FIN DEL ACTO JUR\303\215DICO ***\n            </div>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }
