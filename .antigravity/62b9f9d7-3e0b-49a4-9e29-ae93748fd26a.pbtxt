    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { HelpCircle, BookOpen, ShieldCheck, Scale, Keyboard, X, ExternalLink } from \'lucide-react\';\n\ninterface HelpLegalModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const HelpLegalModal: React.FC<HelpLegalModalProps> = ({ isOpen, onClose }) => {\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4\">\n      <div className=\"bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-2xl max-h-[85vh] flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-150\">\n        <div className=\"p-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between\">\n          <div className=\"flex items-center space-x-2\">\n            <HelpCircle className=\"w-5 h-5 text-blue-600\" />\n            <div>\n              <h3 className=\"font-bold text-sm text-slate-900\">Centro de Ayuda y Normativa Jur\303\255dica</h3>\n              <p className=\"text-[11px] text-slate-500\">Rep\303\272blica Dominicana \342\200\242 Ley 140-15 del Notariado</p>\n            </div>\n          </div>\n          <button onClick={onClose} className=\"p-1 hover:bg-slate-200 rounded text-slate-400 hover:text-slate-700\">\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        <div className=\"flex-1 overflow-y-auto p-6 space-y-6 text-xs text-slate-700\">\n          {/* Section 1: Ley 140-15 */}\n          <div className=\"p-4 bg-blue-50/70 border border-blue-200 rounded-xl space-y-2\">\n            <div className=\"flex items-center space-x-2 text-blue-900 font-bold text-sm\">\n              <Scale className=\"w-4 h-4 text-blue-700\" />\n              <span>Marco Legal: Ley del Notariado 140-15</span>\n            </div>\n            <p className=\"leading-relaxed\">\n              Los actos aut\303\251nticos y bajo firma privada legalizados deben cumplir con los requisitos solemnes: comparecencia completa de partes (nombres, c\303\251dulas JCE, estado civil, ocupaci\303\263n y domicilio), fe de conocimiento, lectura \303\255ntegra en alta voz, y firma de notario con su n\303\272mero de colegiatura y sello oficial.\n            </p>\n          </div>\n\n          {/* Section 2: Shortcuts */}\n          <div className=\"space-y-3\">\n            <div className=\"flex items-center space-x-2 text-slate-900 font-bold text-sm\">\n              <Keyboard className=\"w-4 h-4 text-slate-600\" />\n              <span>Atajos de Teclado del Ribbon Jur\303\255dico</span>\n            </div>\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs\">\n              <div className=\"p-2.5 bg-slate-50 border border-slate-200 rounded-lg flex justify-between\">\n                <span>Guardar documento</span>\n                <kbd className=\"px-1.5 py-0.5 bg-white border border-slate-300 rounded font-mono font-bold text-[10px]\">Ctrl + S</kbd>\n              </div>\n              <div className=\"p-2.5 bg-slate-50 border border-slate-200 rounded-lg flex justify-between\">\n                <span>Imprimir / Exportar PDF</span>\n                <kbd className=\"px-1.5 py-0.5 bg-white border border-slate-300 rounded font-mono font-bold text-[10px]\">Ctrl + P</kbd>\n              </div>\n              <div className=\"p-2.5 bg-slate-50 border border-slate-200 rounded-lg flex justify-between\">\n                <span>Buscar en texto</span>\n                <kbd className=\"px-1.5 py-0.5 bg-white border border-slate-300 rounded font-mono font-bold text-[10px]\">Ctrl + F</kbd>\n              </div>\n              <div className=\"p-2.5 bg-slate-50 border border-slate-200 rounded-lg flex justify-between\">\n                <span>Copiar todo</span>\n                <kbd className=\"px-1.5 py-0.5 bg-white border border-slate-300 rounded font-mono font-bold text-[10px]\">Ctrl + C</kbd>\n              </div>\n            </div>\n          </div>\n\n          {/* Section 3: Dominican Validations */}\n          <div className=\"space-y-2\">\n            <h4 className=\"font-bold text-slate-900\">Validaciones Autom\303\241ticas Integradas:</h4>\n            <ul className=\"list-disc list-inside space-y-1 text-slate-600\">\n              <li><strong>C\303\251dulas JCE:</strong> Verificaci\303\263n de 11 d\303\255gitos con algoritmo M\303\263dulo 10 y detecci\303\263n de prefijos dominicanos v\303\241lidos.</li>\n              <li><strong>RNC DGII:</strong> Verificaci\303\263n de 9 u 11 d\303\255gitos para personas jur\303\255dicas y f\303\255sicas.</li>\n              <li><strong>Montos en Letras:</strong> Conversi\303\263n gramatical estricta a moneda dominicana (Pesos Dominicanos con centavos).</li>\n              <li><strong>Fechas Solemnes:</strong> Redacci\303\263n notarial formal (\"A los quince (15) d\303\255as del mes de...\").</li>\n            </ul>\n          </div>\n        </div>\n\n        <div className=\"p-4 bg-slate-50 border-t border-slate-200 flex justify-end\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-semibold\"\n          >\n            Entendido\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
