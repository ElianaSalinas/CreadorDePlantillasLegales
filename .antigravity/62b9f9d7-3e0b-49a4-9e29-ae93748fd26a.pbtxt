  file_change {
    absolute_path_uri: "file:///src/components/WelcomePage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport {\n  FileText,\n  FileCheck2,\n  Scale,\n  Sparkles,\n  ArrowRight,\n  ShieldCheck,\n  Zap,\n  Layers,\n  BookOpen,\n  Code2,\n  SlidersHorizontal,\n  CheckCircle2,\n  Lock,\n  Building,\n  UserCheck,\n  DollarSign,\n  Briefcase,\n  Search,\n} from \'lucide-react\';\nimport { useAppStore } from \'../store/useAppStore\';\n\nexport const WelcomePage: React.FC = () => {\n  const { state, setView, setActiveTemplateId, currentUser } = useAppStore();\n\n  const handleStartTemplate = (templateId: string) => {\n    setActiveTemplateId(templateId);\n    setView(\'FORM_GEN\');\n  };\n\n  return (\n    <div className=\"min-h-screen bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 font-sans selection:bg-emerald-100 pb-20\">\n      {/* Top Banner Navigation */}\n      <header className=\"border-b border-[#E8E5DF] dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 sticky top-0 z-20 backdrop-blur-sm px-6 sm:px-12 py-3.5 flex items-center justify-between\">\n        {/* Brand Logo */}\n        <div\n          onClick={() => setView(\'WELCOME\')}\n          className=\"flex items-center space-x-2.5 cursor-pointer group\"\n          id=\"welcome-brand-logo\"\n        >\n          <div className=\"w-7 h-7 bg-[#0D2C24] dark:bg-emerald-600 rounded flex items-center justify-center text-white font-serif font-bold text-sm shadow-2xs group-hover:bg-[#164E3E] transition-colors\">\n            S\n          </div>\n          <span className=\"font-serif font-bold text-lg tracking-wider text-[#0D2C24] dark:text-emerald-400\">\n            SAVE\n          </span>\n        </div>\n\n        {/* Center Nav */}\n        <nav className=\"hidden md:flex items-center space-x-8 text-xs font-medium text-slate-600 dark:text-slate-300\">\n          <button\n            onClick={() => setView(\'WELCOME\')}\n            className=\"text-[#0D2C24] dark:text-emerald-400 font-bold border-b-2 border-[#0D2C24] dark:border-emerald-400 pb-0.5\"\n          >\n            Inicio\n          </button>\n          <button\n            onClick={() => setView(\'TEMPLATES\')}\n            className=\"hover:text-[#0D2C24] dark:hover:text-emerald-400 transition-colors cursor-pointer\"\n          >\n            Plantillas Notariales\n          </button>\n          <button\n            onClick={() => setView(\'DOCUMENTS\')}\n            className=\"hover:text-[#0D2C24] dark:hover:text-emerald-400 transition-colors cursor-pointer flex items-center space-x-1\"\n          >\n            <span>B\303\263veda de Contratos</span>\n            <span className=\"bg-amber-100 dark:bg-amber-950 text-amber-900 dark:text-amber-300 text-[10px] px-1.5 py-0.2 rounded-full font-bold\">\n              {state.generatedDocuments.length}\n            </span>\n          </button>\n          <button\n            onClick={() => setView(\'PRICING\')}\n            className=\"hover:text-[#0D2C24] dark:hover:text-emerald-400 transition-colors cursor-pointer\"\n          >\n            Planes & Precios\n          </button>\n        </nav>\n\n        {/* Right CTA */}\n        <div className=\"flex items-center space-x-3\">\n          <button\n            onClick={() => setView(\'PRICING\')}\n            className=\"hidden sm:inline-block text-xs font-semibold text-slate-700 dark:text-slate-200 hover:text-[#0D2C24] px-3 py-1.5 transition-colors cursor-pointer\"\n          >\n            Ver Planes\n          </button>\n          <button\n            onClick={() => setView(\'TEMPLATES\')}\n            className=\"bg-[#0D2C24] hover:bg-[#164E3E] text-white text-xs font-semibold px-4 py-2 rounded-lg shadow-xs transition-colors cursor-pointer flex items-center space-x-1.5\"\n            id=\"btn-welcome-enter-app\"\n          >\n            <span>Acceder a la B\303\263veda</span>\n            <ArrowRight className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n      </header>\n\n      {/* Hero Section */}\n      <section className=\"relative px-6 sm:px-12 pt-14 sm:pt-20 pb-16 max-w-6xl mx-auto text-center\">\n        {/* Top Tag */}\n        <div className=\"inline-flex items-center space-x-2 px-3.5 py-1 rounded-full bg-[#F5F2ED] dark:bg-slate-800 border border-[#E8E5DF] dark:border-slate-700 text-[11px] font-semibold text-[#0D2C24] dark:text-emerald-400 mb-6 shadow-2xs\">\n          <Scale className=\"w-3.5 h-3.5 text-[#C5A059]\" />\n          <span>Plataforma Notarial y Legal para la Rep\303\272blica Dominicana</span>\n        </div>\n\n        {/* Main Headline */}\n        <h1 className=\"text-4xl sm:text-6xl font-serif text-[#0D2C24] dark:text-white font-bold tracking-tight mb-6 leading-tight max-w-4xl mx-auto\">\n          Automatizaci\303\263n y seguridad jur\303\255dica para equipos legales modernos.\n        </h1>\n\n        {/* Subtitle */}\n        <p className=\"text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed font-sans font-normal\">\n          Genera, parametriza y valida actos aut\303\251nticos, contratos de alquiler, pagar\303\251s y acuerdos mercantiles con derivaci\303\263n autom\303\241tica de n\303\272meros a letras, verificaci\303\263n de c\303\251dulas JCE y custodia notarial.\n        </p>\n\n        {/* Action Buttons */}\n        <div className=\"flex flex-col sm:flex-row items-center justify-center gap-3.5 mb-16\">\n          <button\n            onClick={() => setView(\'TEMPLATES\')}\n            className=\"w-full sm:w-auto px-6 py-3.5 rounded-xl bg-[#0D2C24] hover:bg-[#164E3E] text-white text-sm font-bold shadow-md hover:shadow-lg transition-all flex items-center justify-center space-x-2.5 cursor-pointer\"\n            id=\"btn-hero-explore-templates\"\n          >\n            <FileText className=\"w-4 h-4 text-[#FDE8B5]\" />\n            <span>Explorar Cat\303\241logo de Plantillas</span>\n            <ArrowRight className=\"w-4 h-4\" />\n          </button>\n\n          <button\n            onClick={() => setView(\'DOCUMENTS\')}\n            className=\"w-full sm:w-auto px-6 py-3.5 rounded-xl bg-white dark:bg-slate-900 hover:bg-[#F5F2ED] dark:hover:bg-slate-800 text-slate-900 dark:text-white border border-[#D1CCC4] dark:border-slate-700 text-sm font-semibold transition-colors flex items-center justify-center space-x-2 cursor-pointer\"\n            id=\"btn-hero-vault\"\n          >\n            <FileCheck2 className=\"w-4 h-4 text-[#0D2C24] dark:text-emerald-400\" />\n            <span>B\303\263veda de Contratos ({state.generatedDocuments.length})</span>\n          </button>\n\n          <button\n            onClick={() => setView(\'PRICING\')}\n            className=\"w-full sm:w-auto px-6 py-3.5 rounded-xl bg-[#FDE8B5] hover:bg-[#FCE19F] text-[#0D2C24] text-sm font-bold shadow-xs transition-colors flex items-center justify-center space-x-2 cursor-pointer\"\n            id=\"btn-hero-pricing\"\n          >\n            <DollarSign className=\"w-4 h-4 text-[#0D2C24]\" />\n            <span>Planes de Suscripci\303\263n</span>\n          </button>\n        </div>\n\n        {/* Trust Badges Bar */}\n        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto pt-8 border-t border-[#E8E5DF] dark:border-slate-800 text-left\">\n          <div className=\"p-3.5 rounded-xl bg-[#F5F2ED]/60 dark:bg-slate-900 border border-[#E8E5DF] dark:border-slate-800\">\n            <div className=\"flex items-center space-x-2 text-xs font-bold text-slate-900 dark:text-white mb-1\">\n              <ShieldCheck className=\"w-4 h-4 text-[#0D2C24] dark:text-emerald-400\" />\n              <span>Ley 140-15 del Notariado</span>\n            </div>\n            <p className=\"text-[11px] text-slate-500 dark:text-slate-400\">\n              Estructura formal para comparecencia y fe p\303\272blica notarial RD.\n            </p>\n          </div>\n\n          <div className=\"p-3.5 rounded-xl bg-[#F5F2ED]/60 dark:bg-slate-900 border border-[#E8E5DF] dark:border-slate-800\">\n            <div className=\"flex items-center space-x-2 text-xs font-bold text-slate-900 dark:text-white mb-1\">\n              <Sparkles className=\"w-4 h-4 text-[#C5A059]\" />\n              <span>C\303\241lculo en Letras RD</span>\n            </div>\n            <p className=\"text-[11px] text-slate-500 dark:text-slate-400\">\n              Transformaci\303\263n ortogr\303\241fica inmediata de valores DOP y USD a letras.\n            </p>\n          </div>\n\n          <div className=\"p-3.5 rounded-xl bg-[#F5F2ED]/60 dark:bg-slate-900 border border-[#E8E5DF] dark:border-slate-800\">\n            <div className=\"flex items-center space-x-2 text-xs font-bold text-slate-900 dark:text-white mb-1\">\n              <Lock className=\"w-4 h-4 text-[#0D2C24] dark:text-emerald-400\" />\n              <span>Validaci\303\263n JCE y RNC</span>\n            </div>\n            <p className=\"text-[11px] text-slate-500 dark:text-slate-400\">\n              Algoritmo Luhn m\303\263dulo 10 para c\303\251dulas y comprobaci\303\263n de RNC DGII.\n            </p>\n          </div>\n\n          <div className=\"p-3.5 rounded-xl bg-[#F5F2ED]/60 dark:bg-slate-900 border border-[#E8E5DF] dark:border-slate-800\">\n            <div className=\"flex items-center space-x-2 text-xs font-bold text-slate-900 dark:text-white mb-1\">\n              <FileCheck2 className=\"w-4 h-4 text-emerald-600\" />\n              <span>Exportaci\303\263n Limpia</span>\n            </div>\n            <p className=\"text-[11px] text-slate-500 dark:text-slate-400\">\n              Impresi\303\263n notarial n\303\255tida, descarga en PDF o DOCX sin artificios.\n            </p>\n          </div>\n        </div>\n      </section>\n\n      {/* Featured Quick Templates Section */}\n      <section className=\"px-6 sm:px-12 py-12 max-w-6xl mx-auto\">\n        <div className=\"flex flex-col sm:flex-row sm:items-end justify-between mb-8 pb-4 border-b border-[#E8E5DF] dark:border-slate-800\">\n          <div>\n            <span className=\"text-xs font-bold uppercase tracking-wider text-[#C5A059] block mb-1\">\n              Cat\303\241logo Destacado\n            </span>\n            <h2 className=\"text-2xl sm:text-3xl font-serif font-bold text-[#0D2C24] dark:text-white\">\n              Plantillas Notariales Listas para Usar\n            </h2>\n          </div>\n          <button\n            onClick={() => setView(\'TEMPLATES\')}\n            className=\"mt-3 sm:mt-0 text-xs font-semibold text-[#0D2C24] dark:text-emerald-400 hover:underline flex items-center space-x-1\"\n          >\n            <span>Ver todas las plantillas ({state.templates.length})</span>\n            <ArrowRight className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n\n        {/* Template Cards Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n          {state.templates.slice(0, 3).map((tpl) => (\n            <div\n              key={tpl.id}\n              className=\"bg-[#FAFAF8] dark:bg-slate-900 rounded-2xl border border-[#E8E5DF] dark:border-slate-800 p-6 flex flex-col justify-between hover:border-[#0D2C24] dark:hover:border-emerald-500 hover:shadow-md transition-all group\"\n            >\n              <div>\n                <div className=\"flex items-center justify-between mb-4\">\n                  <span className=\"px-2.5 py-1 rounded-md bg-[#0D2C24] text-white text-[10px] font-bold uppercase tracking-wider\">\n                    {tpl.category}\n                  </span>\n                  <span className=\"text-[11px] font-mono text-slate-500\">v{tpl.version}</span>\n                </div>\n\n                <h3 className=\"font-serif text-lg font-bold text-slate-900 dark:text-white mb-2 group-hover:text-[#0D2C24] dark:group-hover:text-emerald-400 transition-colors\">\n                  {tpl.name}\n                </h3>\n\n                <p className=\"text-xs text-slate-600 dark:text-slate-400 mb-4 line-clamp-3 leading-relaxed\">\n                  {tpl.description}\n                </p>\n\n                <div className=\"flex items-center space-x-4 text-[11px] text-slate-500 dark:text-slate-400 mb-6\">\n                  <span>{tpl.variables?.length || 0} Variables</span>\n                  <span>\342\200\242</span>\n                  <span>{tpl.sections?.length || 0} Cl\303\241usulas</span>\n                </div>\n              </div>\n\n              <div className=\"flex items-center space-x-2 pt-4 border-t border-[#E8E5DF] dark:border-slate-800\">\n                <button\n                  onClick={() => handleStartTemplate(tpl.id)}\n                  className=\"flex-1 py-2 px-3 bg-[#0D2C24] hover:bg-[#164E3E] text-white text-xs font-semibold rounded-lg transition-colors flex items-center justify-center space-x-1.5 cursor-pointer\"\n                >\n                  <Zap className=\"w-3.5 h-3.5 text-[#FDE8B5]\" />\n                  <span>Generar Contrato</span>\n                </button>\n                <button\n                  onClick={() => {\n                    setActiveTemplateId(tpl.id);\n                    setView(\'EDITOR\');\n                  }}\n                  className=\"py-2 px-3 bg-white dark:bg-slate-800 border border-[#D1CCC4] dark:border-slate-700 text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-lg hover:bg-slate-50 transition-colors cursor-pointer\"\n                  title=\"Editar Estructura\"\n                >\n                  Editar\n                </button>\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n\n      {/* Interactive Platform Highlights Bento Showcase */}\n      <section className=\"px-6 sm:px-12 py-12 max-w-6xl mx-auto\">\n        <div className=\"rounded-3xl bg-[#0D2C24] text-white p-8 sm:p-12 shadow-2xl relative overflow-hidden\">\n          {/* Subtle background glow */}\n          <div className=\"absolute top-0 right-0 w-96 h-96 bg-emerald-700/20 rounded-full blur-3xl pointer-events-none\"></div>\n\n          <div className=\"max-w-2xl mb-10 relative z-10\">\n            <span className=\"inline-block px-3 py-1 rounded-full bg-[#FDE8B5] text-[#0D2C24] text-[11px] font-bold tracking-wide mb-4\">\n              M\303\263dulos Profesionales SAVE\n            </span>\n            <h2 className=\"text-2xl sm:text-4xl font-serif font-bold text-white mb-4 leading-tight\">\n              Dise\303\261ado exclusivamente para el rigor y la solemnidad del derecho dominicano.\n            </h2>\n            <p className=\"text-xs sm:text-sm text-emerald-100/80 leading-relaxed font-sans\">\n              Cada herramienta ha sido programada con las normas legales del C\303\263digo Civil Dominicano, la Ley 140-15 y las mejores pr\303\241cticas notariales para evitar tachaduras, omisiones y nulidades.\n            </p>\n          </div>\n\n          {/* Grid of features */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 relative z-10\">\n            <div className=\"p-5 rounded-2xl bg-[#164E3E]/70 border border-emerald-800/60 backdrop-blur-xs\">\n              <SlidersHorizontal className=\"w-5 h-5 text-[#FDE8B5] mb-3\" />\n              <h4 className=\"font-serif font-bold text-sm text-white mb-1.5\">\n                Editor Param\303\251trico de Cl\303\241usulas\n              </h4>\n              <p className=\"text-xs text-emerald-100/70 leading-relaxed\">\n                Inserta variables din\303\241micas como <code className=\"text-[#FDE8B5] font-mono text-[10px]\">&#123;&#123;inquilino_nombre&#125;&#125;</code> y condiciones condicionales sin perder el formato solemnemente requerido.\n              </p>\n            </div>\n\n            <div className=\"p-5 rounded-2xl bg-[#164E3E]/70 border border-emerald-800/60 backdrop-blur-xs\">\n              <Sparkles className=\"w-5 h-5 text-[#FDE8B5] mb-3\" />\n              <h4 className=\"font-serif font-bold text-sm text-white mb-1.5\">\n                Human-in-the-Loop con IA\n              </h4>\n              <p className=\"text-xs text-emerald-100/70 leading-relaxed\">\n                Pega cualquier contrato en texto libre o DOCX: nuestro asistente inteligente detecta partes, c\303\251dulas, precios y fechas para convertirlos en par\303\241metros reutilizables.\n              </p>\n            </div>\n\n            <div className=\"p-5 rounded-2xl bg-[#164E3E]/70 border border-emerald-800/60 backdrop-blur-xs\">\n              <FileCheck2 className=\"w-5 h-5 text-[#FDE8B5] mb-3\" />\n              <h4 className=\"font-serif font-bold text-sm text-white mb-1.5\">\n                B\303\263veda Cifrada de Contratos\n              </h4>\n              <p className=\"text-xs text-emerald-100/70 leading-relaxed\">\n                Almacenamiento seguro de todos los documentos finalizados con vista preliminar notarial completa, historial de versiones y auditor\303\255a de cambios.\n              </p>\n            </div>\n          </div>\n\n          <div className=\"mt-10 pt-8 border-t border-emerald-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 relative z-10\">\n            <div className=\"text-xs text-emerald-200/80\">\n              \302\277Listo para automatizar la redacci\303\263n jur\303\255dica de tu despacho?\n            </div>\n            <div className=\"flex items-center space-x-3\">\n              <button\n                onClick={() => setView(\'TEMPLATES\')}\n                className=\"px-5 py-2.5 rounded-xl bg-[#FDE8B5] hover:bg-[#FCE19F] text-[#0D2C24] font-bold text-xs shadow-sm transition-colors cursor-pointer\"\n              >\n                Comenzar a Redactar\n              </button>\n              <button\n                onClick={() => setView(\'PRICING\')}\n                className=\"px-5 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold text-xs border border-white/20 transition-colors cursor-pointer\"\n              >\n                Ver Precios\n              </button>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* Footer */}\n      <footer className=\"mt-16 border-t border-[#E8E5DF] dark:border-slate-800 bg-[#FAFAF8] dark:bg-slate-900/60 py-12 px-6 sm:px-12\">\n        <div className=\"max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-8 items-start\">\n          <div className=\"md:col-span-6 space-y-3\">\n            <div className=\"flex items-center space-x-2.5\">\n              <div className=\"w-6 h-6 bg-[#0D2C24] dark:bg-emerald-600 rounded flex items-center justify-center text-white font-serif font-bold text-xs\">\n                S\n              </div>\n              <span className=\"font-serif font-bold text-base tracking-wider text-[#0D2C24] dark:text-emerald-400\">\n                SAVE\n              </span>\n            </div>\n            <p className=\"text-xs text-slate-500 dark:text-slate-400 max-w-sm leading-relaxed\">\n              \302\251 2024 SAVE Legal Technologies. All rights reserved. Providing modern legal solutions with high-velocity efficiency.\n            </p>\n          </div>\n\n          <div className=\"md:col-span-3 space-y-2\">\n            <div className=\"text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-2\">\n              Plataforma\n            </div>\n            <ul className=\"space-y-1.5 text-xs text-slate-600 dark:text-slate-400\">\n              <li><button onClick={() => setView(\'TEMPLATES\')} className=\"hover:text-[#0D2C24]\">Cat\303\241logo de Plantillas</button></li>\n              <li><button onClick={() => setView(\'DOCUMENTS\')} className=\"hover:text-[#0D2C24]\">B\303\263veda de Contratos</button></li>\n              <li><button onClick={() => setView(\'PRICING\')} className=\"hover:text-[#0D2C24]\">Planes & Precios</button></li>\n            </ul>\n          </div>\n\n          <div className=\"md:col-span-3 space-y-2\">\n            <div className=\"text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-2\">\n              Legal & Cumplimiento\n            </div>\n            <ul className=\"space-y-1.5 text-xs text-slate-600 dark:text-slate-400\">\n              <li><a href=\"#privacy\" className=\"hover:text-[#0D2C24]\">T\303\251rminos de Servicio Notarial</a></li>\n              <li><a href=\"#terms\" className=\"hover:text-[#0D2C24]\">Privacidad y Encriptaci\303\263n</a></li>\n              <li><a href=\"#card\" className=\"hover:text-[#0D2C24]\">Matr\303\255cula CARD y Colegio de Notarios</a></li>\n            </ul>\n          </div>\n        </div>\n      </footer>\n    </div>\n  );\n};\n"
    }
