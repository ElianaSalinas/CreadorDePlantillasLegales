  file_change {
    absolute_path_uri: "file:///src/components/ribbon/BackstageModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  FileText,\n  Save,\n  Printer,\n  Share2,\n  Download,\n  FolderOpen,\n  Plus,\n  Info,\n  User,\n  Settings,\n  ArrowLeft,\n  CheckCircle2,\n  ShieldCheck,\n  Building,\n  Scale,\n  Award,\n  BookOpen,\n  Copy,\n  Check,\n} from \'lucide-react\';\nimport { useAppStore } from \'../../store/useAppStore\';\nimport { generateDocxBlob, generatePdfBlob, generateSchemaJson } from \'../../core/exportEngine\';\n\ninterface BackstageModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  renderedText: string;\n}\n\nexport const BackstageModal: React.FC<BackstageModalProps> = ({\n  isOpen,\n  onClose,\n  renderedText,\n}) => {\n  const {\n    activeTemplate,\n    currentUser,\n    updateTemplate,\n    createTemplate,\n    duplicateTemplate,\n    saveGeneratedDocument,\n    setView,\n  } = useAppStore();\n\n  const [activeTab, setActiveTab] = useState<\n    \'INFO\' | \'NEW\' | \'OPEN\' | \'SAVE\' | \'SAVE_AS\' | \'PRINT\' | \'SHARE\' | \'EXPORT\' | \'ACCOUNT\' | \'OPTIONS\'\n  >(\'INFO\');\n\n  const [copiedLink, setCopiedLink] = useState(false);\n  const [exportMessage, setExportMessage] = useState<string | null>(null);\n\n  if (!isOpen || !activeTemplate) return null;\n\n  const handleDownloadDocx = async () => {\n    try {\n      const title = activeTemplate.name;\n      const blob = await generateDocxBlob(title, renderedText);\n      const url = URL.createObjectURL(blob);\n      const a = document.createElement(\'a\');\n      a.href = url;\n      a.download = `${title.replace(/[^a-zA-Z0-9_-]/g, \'_\')}.docx`;\n      a.click();\n      URL.revokeObjectURL(url);\n      setExportMessage(\'Documento DOCX exportado exitosamente.\');\n      setTimeout(() => setExportMessage(null), 3000);\n    } catch (e: any) {\n      alert(`Error exportando DOCX: ${e.message}`);\n    }\n  };\n\n  const handleDownloadPdf = () => {\n    try {\n      const title = activeTemplate.name;\n      const blob = generatePdfBlob(title, renderedText);\n      const url = URL.createObjectURL(blob);\n      const a = document.createElement(\'a\');\n      a.href = url;\n      a.download = `${title.replace(/[^a-zA-Z0-9_-]/g, \'_\')}.pdf`;\n      a.click();\n      URL.revokeObjectURL(url);\n      setExportMessage(\'Documento PDF generado y descargado.\');\n      setTimeout(() => setExportMessage(null), 3000);\n    } catch (e: any) {\n      alert(`Error exportando PDF: ${e.message}`);\n    }\n  };\n\n  const handleDownloadJson = () => {\n    const jsonStr = generateSchemaJson(activeTemplate);\n    const blob = new Blob([jsonStr], { type: \'application/json\' });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\'a\');\n    a.href = url;\n    a.download = `${activeTemplate.name.replace(/[^a-zA-Z0-9_-]/g, \'_\')}_schema.json`;\n    a.click();\n    URL.revokeObjectURL(url);\n    setExportMessage(\'Esquema JSON Schema exportado.\');\n    setTimeout(() => setExportMessage(null), 3000);\n  };\n\n  const handlePrint = () => {\n    window.print();\n  };\n\n  const handleCopyLink = () => {\n    navigator.clipboard.writeText(window.location.href);\n    setCopiedLink(true);\n    setTimeout(() => setCopiedLink(false), 2500);\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex overflow-hidden\">\n      {/* Backstage Left Navigation Bar */}\n      <div className=\"w-64 bg-slate-900 text-white flex flex-col shrink-0 border-r border-slate-800 shadow-2xl\">\n        {/* Back Button */}\n        <div className=\"p-4 border-b border-slate-800 flex items-center space-x-3\">\n          <button\n            onClick={onClose}\n            className=\"p-2 rounded-full hover:bg-slate-800 text-slate-300 hover:text-white transition-colors\"\n            title=\"Volver al documento\"\n          >\n            <ArrowLeft className=\"w-5 h-5\" />\n          </button>\n          <div>\n            <h2 className=\"text-sm font-bold tracking-tight\">Men\303\272 Archivo</h2>\n            <p className=\"text-[11px] text-slate-400\">SAVE Legal RD \342\200\242 Backstage</p>\n          </div>\n        </div>\n\n        {/* Tab Buttons */}\n        <div className=\"flex-1 p-3 space-y-1 overflow-y-auto\">\n          <button\n            onClick={() => setActiveTab(\'INFO\')}\n            className={`w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold transition-all ${\n              activeTab === \'INFO\' ? \'bg-blue-600 text-white shadow-md\' : \'text-slate-300 hover:bg-slate-800 hover:text-white\'\n            }`}\n          >\n            <Info className=\"w-4 h-4\" />\n            <span>Informaci\303\263n del Documento</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'NEW\')}\n            className={`w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold transition-all ${\n              activeTab === \'NEW\' ? \'bg-blue-600 text-white shadow-md\' : \'text-slate-300 hover:bg-slate-800 hover:text-white\'\n            }`}\n          >\n            <Plus className=\"w-4 h-4\" />\n            <span>Nuevo</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'OPEN\')}\n            className={`w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold transition-all ${\n              activeTab === \'OPEN\' ? \'bg-blue-600 text-white shadow-md\' : \'text-slate-300 hover:bg-slate-800 hover:text-white\'\n            }`}\n          >\n            <FolderOpen className=\"w-4 h-4\" />\n            <span>Abrir Plantilla</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'SAVE\')}\n            className={`w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold transition-all ${\n              activeTab === \'SAVE\' ? \'bg-blue-600 text-white shadow-md\' : \'text-slate-300 hover:bg-slate-800 hover:text-white\'\n            }`}\n          >\n            <Save className=\"w-4 h-4\" />\n            <span>Guardar Cambios</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'SAVE_AS\')}\n            className={`w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold transition-all ${\n              activeTab === \'SAVE_AS\' ? \'bg-blue-600 text-white shadow-md\' : \'text-slate-300 hover:bg-slate-800 hover:text-white\'\n            }`}\n          >\n            <Copy className=\"w-4 h-4\" />\n            <span>Guardar Como Copia</span>\n          </button>\n\n          <div className=\"border-t border-slate-800 my-2 pt-2\" />\n\n          <button\n            onClick={() => setActiveTab(\'PRINT\')}\n            className={`w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold transition-all ${\n              activeTab === \'PRINT\' ? \'bg-blue-600 text-white shadow-md\' : \'text-slate-300 hover:bg-slate-800 hover:text-white\'\n            }`}\n          >\n            <Printer className=\"w-4 h-4\" />\n            <span>Imprimir</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'SHARE\')}\n            className={`w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold transition-all ${\n              activeTab === \'SHARE\' ? \'bg-blue-600 text-white shadow-md\' : \'text-slate-300 hover:bg-slate-800 hover:text-white\'\n            }`}\n          >\n            <Share2 className=\"w-4 h-4\" />\n            <span>Compartir</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'EXPORT\')}\n            className={`w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold transition-all ${\n              activeTab === \'EXPORT\' ? \'bg-blue-600 text-white shadow-md\' : \'text-slate-300 hover:bg-slate-800 hover:text-white\'\n            }`}\n          >\n            <Download className=\"w-4 h-4\" />\n            <span>Exportar (DOCX, PDF, JSON)</span>\n          </button>\n\n          <div className=\"border-t border-slate-800 my-2 pt-2\" />\n\n          <button\n            onClick={() => setActiveTab(\'ACCOUNT\')}\n            className={`w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold transition-all ${\n              activeTab === \'ACCOUNT\' ? \'bg-blue-600 text-white shadow-md\' : \'text-slate-300 hover:bg-slate-800 hover:text-white\'\n            }`}\n          >\n            <User className=\"w-4 h-4\" />\n            <span>Cuenta y Colegiatura CARD</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'OPTIONS\')}\n            className={`w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold transition-all ${\n              activeTab === \'OPTIONS\' ? \'bg-blue-600 text-white shadow-md\' : \'text-slate-300 hover:bg-slate-800 hover:text-white\'\n            }`}\n          >\n            <Settings className=\"w-4 h-4\" />\n            <span>Opciones de la Aplicaci\303\263n</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Backstage Content Area with Smooth Vertical Scroll */}\n      <div className=\"flex-1 bg-white flex flex-col overflow-y-auto overflow-x-hidden p-8 sm:p-12 text-slate-800\">\n        {exportMessage && (\n          <div className=\"mb-6 p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl flex items-center space-x-3 shadow-xs\">\n            <CheckCircle2 className=\"w-5 h-5 text-emerald-600\" />\n            <span className=\"text-sm font-semibold\">{exportMessage}</span>\n          </div>\n        )}\n\n        {/* INFO TAB */}\n        {activeTab === \'INFO\' && (\n          <div className=\"max-w-3xl space-y-6\">\n            <div>\n              <h1 className=\"text-2xl font-serif font-bold text-slate-900\">Informaci\303\263n del Acto Notarial</h1>\n              <p className=\"text-xs text-slate-500 mt-1\">Propiedades solemnes, autor\303\255a y estado regulatorio bajo la Ley 140-15</p>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n              <div className=\"p-5 bg-slate-50 border border-slate-200 rounded-xl space-y-2\">\n                <span className=\"text-[11px] font-bold text-slate-400 uppercase tracking-wider\">T\303\255tulo del Documento</span>\n                <p className=\"font-serif font-bold text-base text-slate-900\">{activeTemplate.name}</p>\n                <p className=\"text-xs text-slate-500\">{activeTemplate.description || \'Sin descripci\303\263n adicional.\'}</p>\n              </div>\n\n              <div className=\"p-5 bg-slate-50 border border-slate-200 rounded-xl space-y-2\">\n                <span className=\"text-[11px] font-bold text-slate-400 uppercase tracking-wider\">Autor Jur\303\255dico & Notar\303\255a</span>\n                <p className=\"font-semibold text-sm text-slate-800\">{currentUser.name}</p>\n                <p className=\"text-xs text-blue-600 font-mono\">{currentUser.cardRegistration} \342\200\242 {currentUser.notaryRegistration}</p>\n                <p className=\"text-xs text-slate-500\">{currentUser.lawFirm}</p>\n              </div>\n\n              <div className=\"p-5 bg-slate-50 border border-slate-200 rounded-xl space-y-2\">\n                <span className=\"text-[11px] font-bold text-slate-400 uppercase tracking-wider\">Metadatos de Estructura</span>\n                <div className=\"grid grid-cols-2 gap-2 text-xs\">\n                  <div>\n                    <span className=\"text-slate-400\">Versi\303\263n:</span> <span className=\"font-mono font-bold\">v{activeTemplate.version}</span>\n                  </div>\n                  <div>\n                    <span className=\"text-slate-400\">Variables:</span> <span className=\"font-bold\">{activeTemplate.variables.length}</span>\n                  </div>\n                  <div>\n                    <span className=\"text-slate-400\">Cl\303\241usulas:</span> <span className=\"font-bold\">{activeTemplate.clauses.length}</span>\n                  </div>\n                  <div>\n                    <span className=\"text-slate-400\">Reglas:</span> <span className=\"font-bold\">{activeTemplate.rules.length}</span>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"p-5 bg-slate-50 border border-slate-200 rounded-xl space-y-2\">\n                <span className=\"text-[11px] font-bold text-slate-400 uppercase tracking-wider\">Jurisdicci\303\263n y Vigencia</span>\n                <p className=\"text-xs font-semibold text-slate-800\">Rep\303\272blica Dominicana</p>\n                <p className=\"text-xs text-slate-500\">\303\232ltima modificaci\303\263n: {new Date(activeTemplate.updatedAt).toLocaleString()}</p>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* NEW TAB */}\n        {activeTab === \'NEW\' && (\n          <div className=\"max-w-3xl space-y-6\">\n            <div>\n              <h1 className=\"text-2xl font-serif font-bold text-slate-900\">Crear Nuevo Documento o Plantilla</h1>\n              <p className=\"text-xs text-slate-500 mt-1\">Selecciona una plantilla base o inicia un borrador desde cero</p>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n              <button\n                onClick={() => {\n                  createTemplate({\n                    name: \'Nuevo Contrato Notarial en Blanco\',\n                    description: \'Documento en blanco para redacci\303\263n notarial libre\',\n                    category: \'Civil\',\n                    content: \'ACTO N\303\232MERO ______.- En la ciudad de Santo Domingo, Distrito Nacional, Capital de la Rep\303\272blica Dominicana...\',\n                  });\n                  onClose();\n                  setView(\'EDITOR\');\n                }}\n                className=\"p-6 bg-blue-50/50 hover:bg-blue-50 border-2 border-dashed border-blue-300 rounded-2xl text-left transition-all group\"\n              >\n                <Plus className=\"w-8 h-8 text-blue-600 mb-3 group-hover:scale-110 transition-transform\" />\n                <h3 className=\"font-bold text-sm text-slate-900\">Documento en Blanco</h3>\n                <p className=\"text-xs text-slate-500 mt-1\">Inicia con hoja notarial limpia y a\303\261ade variables o cl\303\241usulas a discreci\303\263n.</p>\n              </button>\n\n              <button\n                onClick={() => {\n                  onClose();\n                  setView(\'TEMPLATES\');\n                }}\n                className=\"p-6 bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-2xl text-left transition-all\"\n              >\n                <BookOpen className=\"w-8 h-8 text-indigo-600 mb-3\" />\n                <h3 className=\"font-bold text-sm text-slate-900\">Desde Cat\303\241logo Notarial</h3>\n                <p className=\"text-xs text-slate-500 mt-1\">Elige entre contratos de alquiler, pagar\303\251s notariales, poderes y ventas de inmuebles.</p>\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* OPEN TAB */}\n        {activeTab === \'OPEN\' && (\n          <div className=\"max-w-3xl space-y-6\">\n            <div>\n              <h1 className=\"text-2xl font-serif font-bold text-slate-900\">Abrir Plantilla Existente</h1>\n              <p className=\"text-xs text-slate-500 mt-1\">Navega por la biblioteca de actos y contratos guardados</p>\n            </div>\n            <button\n              onClick={() => {\n                onClose();\n                setView(\'TEMPLATES\');\n              }}\n              className=\"px-5 py-3 bg-blue-600 text-white rounded-xl text-xs font-semibold shadow-sm hover:bg-blue-500 transition-colors inline-flex items-center space-x-2\"\n            >\n              <FolderOpen className=\"w-4 h-4\" />\n              <span>Ver Cat\303\241logo Completo de Plantillas</span>\n            </button>\n          </div>\n        )}\n\n        {/* SAVE TAB */}\n        {activeTab === \'SAVE\' && (\n          <div className=\"max-w-3xl space-y-6\">\n            <div>\n              <h1 className=\"text-2xl font-serif font-bold text-slate-900\">Guardar Cambios</h1>\n              <p className=\"text-xs text-slate-500 mt-1\">Los cambios se guardan localmente y en el historial de versiones</p>\n            </div>\n            <div className=\"p-6 bg-emerald-50 border border-emerald-200 rounded-2xl space-y-3\">\n              <CheckCircle2 className=\"w-8 h-8 text-emerald-600\" />\n              <h3 className=\"font-bold text-emerald-950 text-sm\">Cambios Sincronizados</h3>\n              <p className=\"text-xs text-emerald-800 leading-relaxed\">\n                El documento se encuentra actualizado con la \303\272ltima versi\303\263n de contenido y variables.\n              </p>\n              <button\n                onClick={() => {\n                  updateTemplate(activeTemplate.id, { updatedAt: new Date().toISOString() });\n                  setExportMessage(\'Plantilla guardada satisfactoriamente.\');\n                  setTimeout(() => setExportMessage(null), 3000);\n                }}\n                className=\"mt-2 px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold rounded-lg shadow-xs\"\n              >\n                Forzar Guardado Inmediato\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* SAVE AS TAB */}\n        {activeTab === \'SAVE_AS\' && (\n          <div className=\"max-w-3xl space-y-6\">\n            <div>\n              <h1 className=\"text-2xl font-serif font-bold text-slate-900\">Guardar como Copia</h1>\n              <p className=\"text-xs text-slate-500 mt-1\">Crea un duplicado independiente con nuevo identificador</p>\n            </div>\n            <button\n              onClick={() => {\n                duplicateTemplate(activeTemplate.id);\n                setExportMessage(\'Plantilla duplicada y guardada como nueva copia.\');\n                setTimeout(() => setExportMessage(null), 3000);\n              }}\n              className=\"px-5 py-3 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-xs font-semibold shadow-sm transition-colors inline-flex items-center space-x-2\"\n            >\n              <Copy className=\"w-4 h-4\" />\n              <span>Crear Duplicado \"{activeTemplate.name} (Copia)\"</span>\n            </button>\n          </div>\n        )}\n\n        {/* PRINT TAB */}\n        {activeTab === \'PRINT\' && (\n          <div className=\"max-w-3xl space-y-6\">\n            <div>\n              <h1 className=\"text-2xl font-serif font-bold text-slate-900\">Imprimir Acto Notarial</h1>\n              <p className=\"text-xs text-slate-500 mt-1\">Env\303\255a a la impresora o genera formato para papel sellado notarial</p>\n            </div>\n            <div className=\"p-6 bg-slate-50 border border-slate-200 rounded-2xl flex items-center justify-between\">\n              <div>\n                <h3 className=\"font-bold text-slate-900 text-sm\">Di\303\241logo de Impresi\303\263n Notarial</h3>\n                <p className=\"text-xs text-slate-500 mt-0.5\">Optimizado para hojas tama\303\261o Carta y Legal con m\303\241rgenes solemnes.</p>\n              </div>\n              <button\n                onClick={handlePrint}\n                className=\"px-5 py-2.5 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold rounded-xl shadow-sm inline-flex items-center space-x-2\"\n              >\n                <Printer className=\"w-4 h-4\" />\n                <span>Imprimir Ahora</span>\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* SHARE TAB */}\n        {activeTab === \'SHARE\' && (\n          <div className=\"max-w-3xl space-y-6\">\n            <div>\n              <h1 className=\"text-2xl font-serif font-bold text-slate-900\">Compartir Documento</h1>\n              <p className=\"text-xs text-slate-500 mt-1\">Env\303\255a a clientes o colegas para revisi\303\263n previa o firma</p>\n            </div>\n            <div className=\"p-6 bg-slate-50 border border-slate-200 rounded-2xl space-y-4\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-xs font-semibold text-slate-700\">Enlace de Revisi\303\263n Notarial</span>\n                <button\n                  onClick={handleCopyLink}\n                  className=\"px-3 py-1.5 bg-blue-600 text-white text-xs font-semibold rounded-lg shadow-xs hover:bg-blue-500 inline-flex items-center space-x-1.5\"\n                >\n                  {copiedLink ? <Check className=\"w-3.5 h-3.5\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                  <span>{copiedLink ? \'Copiado\' : \'Copiar Enlace\'}</span>\n                </button>\n              </div>\n              <input\n                readOnly\n                value={window.location.href}\n                className=\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg font-mono text-slate-600\"\n              />\n            </div>\n          </div>\n        )}\n\n        {/* EXPORT TAB */}\n        {activeTab === \'EXPORT\' && (\n          <div className=\"max-w-3xl space-y-6\">\n            <div>\n              <h1 className=\"text-2xl font-serif font-bold text-slate-900\">Exportar Documento</h1>\n              <p className=\"text-xs text-slate-500 mt-1\">Formatos de alta fidelidad compatibles con Word, Adobe Acrobat y sistemas jur\303\255dicos</p>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n              <div className=\"p-6 bg-blue-50 border border-blue-200 rounded-2xl flex flex-col justify-between space-y-4\">\n                <div>\n                  <span className=\"text-[10px] font-bold uppercase tracking-wider text-blue-700 bg-blue-100 px-2 py-0.5 rounded\">Microsoft Word</span>\n                  <h3 className=\"font-bold text-slate-900 text-sm mt-2\">Documento .DOCX</h3>\n                  <p className=\"text-xs text-slate-500 mt-1\">Con formato OOXML, encabezados y estilos listos para editar.</p>\n                </div>\n                <button\n                  onClick={handleDownloadDocx}\n                  className=\"w-full py-2.5 bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold rounded-xl shadow-xs\"\n                >\n                  Descargar DOCX\n                </button>\n              </div>\n\n              <div className=\"p-6 bg-rose-50 border border-rose-200 rounded-2xl flex flex-col justify-between space-y-4\">\n                <div>\n                  <span className=\"text-[10px] font-bold uppercase tracking-wider text-rose-700 bg-rose-100 px-2 py-0.5 rounded\">Adobe Acrobat</span>\n                  <h3 className=\"font-bold text-slate-900 text-sm mt-2\">Documento .PDF</h3>\n                  <p className=\"text-xs text-slate-500 mt-1\">Documento notarial no modificable con sello y paginaci\303\263n.</p>\n                </div>\n                <button\n                  onClick={handleDownloadPdf}\n                  className=\"w-full py-2.5 bg-rose-600 hover:bg-rose-500 text-white text-xs font-semibold rounded-xl shadow-xs\"\n                >\n                  Descargar PDF\n                </button>\n              </div>\n\n              <div className=\"p-6 bg-purple-50 border border-purple-200 rounded-2xl flex flex-col justify-between space-y-4\">\n                <div>\n                  <span className=\"text-[10px] font-bold uppercase tracking-wider text-purple-700 bg-purple-100 px-2 py-0.5 rounded\">Contrato de Datos</span>\n                  <h3 className=\"font-bold text-slate-900 text-sm mt-2\">JSON Schema</h3>\n                  <p className=\"text-xs text-slate-500 mt-1\">Esquema interoperable con reglas y tipos de datos dominicanos.</p>\n                </div>\n                <button\n                  onClick={handleDownloadJson}\n                  className=\"w-full py-2.5 bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold rounded-xl shadow-xs\"\n                >\n                  Descargar JSON\n                </button>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* ACCOUNT TAB */}\n        {activeTab === \'ACCOUNT\' && (\n          <div className=\"max-w-3xl space-y-6\">\n            <div>\n              <h1 className=\"text-2xl font-serif font-bold text-slate-900\">Perfil del Profesional Legal</h1>\n              <p className=\"text-xs text-slate-500 mt-1\">Credenciales y permisos unificados para todos los usuarios</p>\n            </div>\n\n            <div className=\"p-6 bg-slate-50 border border-slate-200 rounded-2xl space-y-4\">\n              <div className=\"flex items-center space-x-4\">\n                <div className=\"w-14 h-14 bg-gradient-to-tr from-blue-700 to-indigo-600 rounded-2xl flex items-center justify-center text-white font-bold text-xl shadow-md\">\n                  {currentUser.name.charAt(0)}\n                </div>\n                <div>\n                  <h3 className=\"font-serif font-bold text-base text-slate-900\">{currentUser.name}</h3>\n                  <p className=\"text-xs text-blue-600 font-mono font-medium\">{currentUser.cardRegistration}</p>\n                  <p className=\"text-xs text-slate-500\">{currentUser.roleTitle}</p>\n                </div>\n              </div>\n\n              <div className=\"border-t border-slate-200 pt-4 grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs\">\n                <div>\n                  <span className=\"text-slate-400\">Colegio de Notarios:</span> <span className=\"font-semibold\">{currentUser.notaryRegistration || \'No aplica\'}</span>\n                </div>\n                <div>\n                  <span className=\"text-slate-400\">Jurisdicci\303\263n:</span> <span className=\"font-semibold\">{currentUser.jurisdiction}</span>\n                </div>\n                <div>\n                  <span className=\"text-slate-400\">Bufete / Despacho:</span> <span className=\"font-semibold\">{currentUser.lawFirm}</span>\n                </div>\n                <div>\n                  <span className=\"text-slate-400\">Estado de Permisos:</span> <span className=\"font-semibold text-emerald-600\">Acceso Total Concedido (Todos los perfiles)</span>\n                </div>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* OPTIONS TAB */}\n        {activeTab === \'OPTIONS\' && (\n          <div className=\"max-w-3xl space-y-6\">\n            <div>\n              <h1 className=\"text-2xl font-serif font-bold text-slate-900\">Opciones de la Aplicaci\303\263n</h1>\n              <p className=\"text-xs text-slate-500 mt-1\">Configuraciones de redacci\303\263n legal, numeraci\303\263n y cumplimiento de Ley 140-15</p>\n            </div>\n\n            <div className=\"p-6 bg-slate-50 border border-slate-200 rounded-2xl space-y-3 text-xs\">\n              <label className=\"flex items-center space-x-3 cursor-pointer\">\n                <input type=\"checkbox\" defaultChecked className=\"w-4 h-4 text-blue-600 rounded\" />\n                <span className=\"font-medium text-slate-800\">Habilitar conversi\303\263n autom\303\241tica de montos a letras en pesos dominicanos (DOP)</span>\n              </label>\n              <label className=\"flex items-center space-x-3 cursor-pointer\">\n                <input type=\"checkbox\" defaultChecked className=\"w-4 h-4 text-blue-600 rounded\" />\n                <span className=\"font-medium text-slate-800\">Validaci\303\263n estricta de C\303\251dulas JCE mediante M\303\263dulo 10 en tiempo real</span>\n              </label>\n              <label className=\"flex items-center space-x-3 cursor-pointer\">\n                <input type=\"checkbox\" defaultChecked className=\"w-4 h-4 text-blue-600 rounded\" />\n                <span className=\"font-medium text-slate-800\">Validaci\303\263n de RNC para personas jur\303\255dicas con DGII</span>\n              </label>\n              <label className=\"flex items-center space-x-3 cursor-pointer\">\n                <input type=\"checkbox\" defaultChecked className=\"w-4 h-4 text-blue-600 rounded\" />\n                <span className=\"font-medium text-slate-800\">Incluir membrete solemne de la Rep\303\272blica Dominicana en exportaciones</span>\n              </label>\n            </div>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
