          text: "    renderedContent: `PAGAR\303\211 NOTARIAL CON FUERZA EJECUTORIA"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "(Ley No. 140-15 del Notariado Dominicano y Arts. 545 y siguientes del C\303\263digo de Procedimiento Civil)"
