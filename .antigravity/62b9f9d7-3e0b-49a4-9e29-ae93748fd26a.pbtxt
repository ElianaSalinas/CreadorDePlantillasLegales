        target_content: "  const getViewTitle = () => {\n    switch (state.currentView) {\n      case \'DOCUMENTS\':\n        return {\n          title: \'Contratos Finales Guardados\',\n          subtitle: \'B\303\263veda inmutable de contratos y actos legales emitidos\',\n          icon: <FileCheck2 className=\"w-5 h-5 text-amber-500\" />,\n        };\n      case \'TEMPLATES\':\n        return {\n          title: \'Cat\303\241logo de Plantillas\',\n          subtitle: \'Gesti\303\263n y parametrizaci\303\263n de plantillas notariales dominicanas\',\n          icon: <Files className=\"w-5 h-5 text-indigo-500\" />,\n        };\n      case \'EDITOR\':\n        return {\n          title: activeTemplate ? activeTemplate.name : \'Editor de Plantillas\',\n          subtitle: \'Editor notarial estilo Word con previsualizaci\303\263n formal\',\n          icon: <PenTool className=\"w-5 h-5 text-emerald-500\" />,\n        };\n      case \'VARIABLES\':\n        return {\n          title: \'Variables & Campos de Datos\',\n          subtitle: \'Validaci\303\263n de c\303\251dulas, montos en letras y datos de partes\',\n          icon: <Sliders className=\"w-5 h-5 text-cyan-500\" />,\n        };\n      case \'CLAUSES\':\n        return {\n          title: \'Biblioteca de Cl\303\241usulas Dominicanas\',\n          subtitle: \'Dep\303\263sitos, mora, jurisdicci\303\263n y cl\303\241usulas est\303\241ndar\',\n          icon: <BookOpen className=\"w-5 h-5 text-purple-500\" />,\n        };\n      case \'RULES\':\n        return {\n          title: \'Reglas Condicionales\',\n          subtitle: \'Automatizaci\303\263n l\303\263gica de inclusi\303\263n y exclusi\303\263n de cl\303\241usulas\',\n          icon: <GitFork className=\"w-5 h-5 text-rose-500\" />,\n        };\n      case \'FORM_GEN\':\n        return {\n          title: \'Generador de Contratos Finales\',\n          subtitle: \'Diligenciamiento de datos y emisi\303\263n de documento final\',\n          icon: <Sparkles className=\"w-5 h-5 text-blue-500\" />,\n        };\n      case \'HITL_REVIEW\':\n        return {\n          title: \'Revisi\303\263n Human-In-The-Loop\',\n          subtitle: \'Aprobaci\303\263n y fusi\303\263n de tokens detectados con IA\',\n          icon: <ShieldCheck className=\"w-5 h-5 text-amber-500\" />,\n        };\n      default:\n        return {\n          title: \'Plataforma Legal Notarial\',\n          subtitle: \'Rep\303\272blica Dominicana\',\n          icon: <Scale className=\"w-5 h-5 text-blue-500\" />,\n        };\n    }\n  };"
        replacement_content: "  const getViewTitle = () => {\n    switch (state.currentView) {\n      case \'WELCOME\':\n        return {\n          title: \'Bienvenido a SAVE\',\n          subtitle: \'Automatizaci\303\263n Notarial y Legal de Alto Nivel para Rep\303\272blica Dominicana\',\n          icon: <Scale className=\"w-5 h-5 text-[#C5A059]\" />,\n        };\n      case \'PRICING\':\n        return {\n          title: \'Planes y Opciones de Suscripci\303\263n\',\n          subtitle: \'Precios transparentes para equipos legales modernos\',\n          icon: <Scale className=\"w-5 h-5 text-[#0D2C24]\" />,\n        };\n      case \'DOCUMENTS\':\n        return {\n          title: \'Contratos Finales Guardados\',\n          subtitle: \'B\303\263veda inmutable de contratos y actos legales emitidos\',\n          icon: <FileCheck2 className=\"w-5 h-5 text-[#C5A059]\" />,\n        };\n      case \'TEMPLATES\':\n        return {\n          title: \'Cat\303\241logo de Plantillas\',\n          subtitle: \'Gesti\303\263n y parametrizaci\303\263n de plantillas notariales dominicanas\',\n          icon: <Files className=\"w-5 h-5 text-[#0D2C24] dark:text-emerald-400\" />,\n        };\n      case \'EDITOR\':\n        return {\n          title: activeTemplate ? activeTemplate.name : \'Editor de Plantillas\',\n          subtitle: \'Editor notarial estilo Word con previsualizaci\303\263n formal\',\n          icon: <PenTool className=\"w-5 h-5 text-emerald-600\" />,\n        };\n      case \'VARIABLES\':\n        return {\n          title: \'Variables & Campos de Datos\',\n          subtitle: \'Validaci\303\263n de c\303\251dulas, montos en letras y datos de partes\',\n          icon: <Sliders className=\"w-5 h-5 text-[#0D2C24] dark:text-emerald-400\" />,\n        };\n      case \'CLAUSES\':\n        return {\n          title: \'Biblioteca de Cl\303\241usulas Dominicanas\',\n          subtitle: \'Dep\303\263sitos, mora, jurisdicci\303\263n y cl\303\241usulas est\303\241ndar\',\n          icon: <BookOpen className=\"w-5 h-5 text-[#C5A059]\" />,\n        };\n      case \'RULES\':\n        return {\n          title: \'Reglas Condicionales\',\n          subtitle: \'Automatizaci\303\263n l\303\263gica de inclusi\303\263n y exclusi\303\263n de cl\303\241usulas\',\n          icon: <GitFork className=\"w-5 h-5 text-[#0D2C24] dark:text-emerald-400\" />,\n        };\n      case \'FORM_GEN\':\n        return {\n          title: \'Generador de Contratos Finales\',\n          subtitle: \'Diligenciamiento de datos y emisi\303\263n de documento final\',\n          icon: <Sparkles className=\"w-5 h-5 text-[#C5A059]\" />,\n        };\n      case \'HITL_REVIEW\':\n        return {\n          title: \'Revisi\303\263n Human-In-The-Loop\',\n          subtitle: \'Aprobaci\303\263n y fusi\303\263n de tokens detectados con IA\',\n          icon: <ShieldCheck className=\"w-5 h-5 text-[#0D2C24] dark:text-emerald-400\" />,\n        };\n      default:\n        return {\n          title: \'Plataforma Legal Notarial\',\n          subtitle: \'Rep\303\272blica Dominicana\',\n          icon: <Scale className=\"w-5 h-5 text-[#0D2C24]\" />,\n        };\n    }\n  };"
