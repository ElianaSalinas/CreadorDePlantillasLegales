      replacement_content: "import React, { useState } from \'react\';\nimport { Plus, X, FileText, Building, Scale, Briefcase } from \'lucide-react\';\nimport { useAppStore } from \'../store/useAppStore\';\nimport { TemplateCategory } from \'../types\';\n\ninterface NewTemplateModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const NewTemplateModal: React.FC<NewTemplateModalProps> = ({ isOpen, onClose }) => {\n  const { createTemplate, setView } = useAppStore();\n\n  const [name, setName] = useState(\'\');\n  const [description, setDescription] = useState(\'\');\n  const [category, setCategory] = useState<TemplateCategory>(\'Inmobiliario\');\n  const [preset, setPreset] = useState<\'BLANK\' | \'ALQUILER\' | \'VENTA\' | \'PODER\'>(\'BLANK\');\n\n  if (!isOpen) return null;\n\n  const handleCreate = (e: React.FormEvent) => {\n    e.preventDefault();\n\n    let initialContent = \'\';\n    if (preset === \'ALQUILER\') {\n      initialContent = `CONTRATO DE ALQUILER RESIDENCIAL\\n\\nENTRE: {{arrendador_nombre}}, titular de la C\303\251dula No. {{arrendador_cedula}}, por una parte;\\nY de la otra parte, {{arrendatario_nombre}}, C\303\251dula No. {{arrendatario_cedula}}.\\n\\nSE HA CONVENIDO LO SIGUIENTE:\\n\\nPRIMERO: {{arrendador_nombre}} alquila a {{arrendatario_nombre}} el inmueble ubicado en {{inmueble_direccion}} por un canon mensual de {{renta_mensual_monto}} ({{renta_mensual_letras}}).\\n\\nHECHO EN Santo Domingo, Rep\303\272blica Dominicana, a los {{fecha_firma}}.`;\n    } else if (preset === \'VENTA\') {\n      initialContent = `CONTRATO DE PROMESA DE VENTA\\n\\nENTRE: {{vendedor_nombre}}, C\303\251dula No. {{vendedor_cedula}};\\nY {{comprador_nombre}}, C\303\251dula No. {{comprador_cedula}}.\\n\\nPRIMERO: EL VENDEDOR vende a EL COMPRADOR el inmueble amparado por el Certificado de T\303\255tulo No. {{matricula_titulo}} por la suma de {{precio_venta_monto}} ({{precio_venta_letras}}).\\n\\nFIRMADO en Rep\303\272blica Dominicana.`;\n    } else if (preset === \'PODER\') {\n      initialContent = `PODER ESPECIAL NOTARIAL\\n\\nANTE M\303\215, {{notario_nombre}}, Notario P\303\272blico para el {{distrito_judicial}};\\n\\nCOMPARECI\303\223: {{poderdante_nombre}}, C\303\251dula No. {{poderdante_cedula}}, quien otorga poder especial a favor de {{apoderado_nombre}}, C\303\251dula No. {{apoderado_cedula}} para realizar: {{facultades_especificas}}.\\n\\nDOY FE.`;\n    }\n\n    const newId = createTemplate({\n      name: name || \'Nueva Plantilla Legal\',\n      description,\n      category,\n      content: initialContent,\n    });\n\n    onClose();\n    setView(\'EDITOR\');\n  };\n\n  return (\n    <div className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 z-50 animate-in fade-in\">\n      <div className=\"bg-white dark:bg-slate-900 rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-[#E8E5DF] dark:border-slate-800 space-y-4\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between pb-3 border-b border-[#E8E5DF] dark:border-slate-800\">\n          <div className=\"flex items-center space-x-3\">\n            <div className=\"w-9 h-9 rounded-xl bg-[#0D2C24] text-[#FDE8B5] flex items-center justify-center\">\n              <Plus className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h3 className=\"font-serif font-bold text-base text-slate-900 dark:text-white\">Crear Nueva Plantilla Legal</h3>\n              <p className=\"text-xs text-slate-500 dark:text-slate-400\">Jurisdicci\303\263n Rep\303\272blica Dominicana \342\200\242 SAVE</p>\n            </div>\n          </div>\n\n          <button onClick={onClose} className=\"text-slate-400 hover:text-slate-600 dark:hover:text-white cursor-pointer\">\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        <form onSubmit={handleCreate} className=\"space-y-4 text-xs\">\n          <div>\n            <label className=\"block font-semibold text-slate-700 dark:text-slate-300 mb-1\">\n              Nombre de la Plantilla <span className=\"text-rose-500\">*</span>\n            </label>\n            <input\n              type=\"text\"\n              required\n              value={name}\n              onChange={(e) => setName(e.target.value)}\n              placeholder=\"ej. Contrato de Alquiler Comercial Tipo B\"\n              className=\"w-full px-3 py-2 border border-[#D1CCC4] dark:border-slate-700 dark:bg-slate-800 dark:text-white rounded-xl focus:outline-none focus:ring-2 focus:ring-[#0D2C24] text-xs\"\n            />\n          </div>\n\n          <div>\n            <label className=\"block font-semibold text-slate-700 dark:text-slate-300 mb-1\">Descripci\303\263n Jur\303\255dica</label>\n            <textarea\n              rows={2}\n              value={description}\n              onChange={(e) => setDescription(e.target.value)}\n              placeholder=\"Breve resumen del alcance o prop\303\263sito del documento...\"\n              className=\"w-full px-3 py-2 border border-[#D1CCC4] dark:border-slate-700 dark:bg-slate-800 dark:text-white rounded-xl focus:outline-none focus:ring-2 focus:ring-[#0D2C24] text-xs\"\n            />\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-3\">\n            <div>\n              <label className=\"block font-semibold text-slate-700 dark:text-slate-300 mb-1\">Categor\303\255a</label>\n              <select\n                value={category}\n                onChange={(e) => setCategory(e.target.value as TemplateCategory)}\n                className=\"w-full px-3 py-2 border border-[#D1CCC4] dark:border-slate-700 dark:bg-slate-800 dark:text-white rounded-xl focus:outline-none text-xs\"\n              >\n                <option value=\"Inmobiliario\">Inmobiliario</option>\n                <option value=\"Civil\">Civil</option>\n                <option value=\"Comercial\">Comercial</option>\n                <option value=\"Corporativo\">Corporativo</option>\n              </select>\n            </div>\n\n            <div>\n              <label className=\"block font-semibold text-slate-700 dark:text-slate-300 mb-1\">Estructura Inicial</label>\n              <select\n                value={preset}\n                onChange={(e) => setPreset(e.target.value as any)}\n                className=\"w-full px-3 py-2 border border-[#D1CCC4] dark:border-slate-700 dark:bg-slate-800 dark:text-white rounded-xl focus:outline-none text-xs\"\n              >\n                <option value=\"BLANK\">En blanco (vac\303\255a)</option>\n                <option value=\"ALQUILER\">Base de Alquiler RD</option>\n                <option value=\"VENTA\">Base de Promesa de Venta</option>\n                <option value=\"PODER\">Base de Poder Notarial</option>\n              </select>\n            </div>\n          </div>\n\n          <div className=\"flex justify-end space-x-2 pt-4 border-t border-[#E8E5DF] dark:border-slate-800\">\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"px-4 py-2 rounded-xl font-semibold bg-[#F5F2ED] dark:bg-slate-800 hover:bg-[#E8E5DF] dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 cursor-pointer\"\n            >\n              Cancelar\n            </button>\n            <button\n              type=\"submit\"\n              className=\"px-4 py-2 rounded-xl font-bold bg-[#0D2C24] hover:bg-[#164E3E] text-white shadow-sm cursor-pointer\"\n            >\n              Crear y Abrir Editor\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n};\n"
    }
