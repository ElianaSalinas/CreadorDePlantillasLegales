  file_change {
    absolute_path_uri: "file:///src/components/HITLReviewPanel.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  Sparkles,\n  CheckCircle2,\n  XCircle,\n  Merge,\n  ArrowRight,\n  ShieldCheck,\n  Check,\n  X,\n  Edit2,\n  FileText,\n  AlertCircle,\n} from \'lucide-react\';\nimport { useAppStore } from \'../store/useAppStore\';\nimport { DetectedToken, TemplateCategory } from \'../types\';\nimport { normalizeVariableTag } from \'../core/variableEngine\';\n\nexport const HITLReviewPanel: React.FC = () => {\n  const {\n    state,\n    acceptHitlToken,\n    rejectHitlToken,\n    mergeHitlTokens,\n    commitHitlToTemplate,\n    setView,\n  } = useAppStore();\n\n  const [templateName, setTemplateName] = useState(\'Contrato Parametrizado\');\n  const [templateCategory, setTemplateCategory] = useState<TemplateCategory>(\'Inmobiliario\');\n  const [editingTokenId, setEditingTokenId] = useState<string | null>(null);\n  const [editedTag, setEditedTag] = useState(\'\');\n  const [selectedForMerge, setSelectedForMerge] = useState<string[]>([]);\n\n  const tokens = state.hitlTokens;\n  const originalText = state.hitlOriginalText;\n\n  if (tokens.length === 0 && !originalText) {\n    return (\n      <div className=\"max-w-4xl mx-auto py-16 text-center\">\n        <p className=\"text-slate-500\">No hay sesiones activas de revisi\303\263n Human-in-the-Loop.</p>\n        <button\n          onClick={() => setView(\'TEMPLATES\')}\n          className=\"mt-4 px-4 py-2 bg-blue-600 text-white text-xs font-semibold rounded-lg\"\n        >\n          Volver al Cat\303\241logo\n        </button>\n      </div>\n    );\n  }\n\n  const acceptedCount = tokens.filter((t) => t.status === \'ACEPTADA\' || t.status === \'FUSIONADA\').length;\n  const pendingCount = tokens.filter((t) => t.status === \'PENDIENTE\').length;\n\n  const handleAcceptAll = () => {\n    tokens.forEach((t) => {\n      if (t.status === \'PENDIENTE\') {\n        acceptHitlToken(t.id);\n      }\n    });\n  };\n\n  const handleRejectAll = () => {\n    tokens.forEach((t) => {\n      if (t.status === \'PENDIENTE\') {\n        rejectHitlToken(t.id);\n      }\n    });\n  };\n\n  const handleStartEditTag = (token: DetectedToken) => {\n    setEditingTokenId(token.id);\n    setEditedTag(token.tag);\n  };\n\n  const handleSaveEditTag = (token: DetectedToken) => {\n    acceptHitlToken(token.id, normalizeVariableTag(editedTag));\n    setEditingTokenId(null);\n  };\n\n  const handleToggleMergeSelection = (tokenId: string) => {\n    if (selectedForMerge.includes(tokenId)) {\n      setSelectedForMerge(selectedForMerge.filter((id) => id !== tokenId));\n    } else {\n      setSelectedForMerge([...selectedForMerge, tokenId]);\n    }\n  };\n\n  const handleExecuteMerge = () => {\n    if (selectedForMerge.length < 2) {\n      alert(\'Selecciona al menos 2 variables para fusionar.\');\n      return;\n    }\n    const [target, ...sources] = selectedForMerge;\n    mergeHitlTokens(target, sources);\n    setSelectedForMerge([]);\n  };\n\n  const handleCommit = () => {\n    commitHitlToTemplate(templateName, templateCategory);\n  };\n\n  return (\n    <div className=\"h-[calc(100vh-4rem)] flex flex-col bg-slate-100 overflow-hidden\">\n      {/* Top Action & Status Bar */}\n      <div className=\"bg-white border-b border-slate-200 px-6 py-3 flex flex-wrap items-center justify-between gap-4 shrink-0 shadow-xs\">\n        <div>\n          <div className=\"flex items-center space-x-2\">\n            <span className=\"text-xs font-bold uppercase tracking-wider text-purple-700 bg-purple-50 px-2.5 py-0.5 rounded-md border border-purple-100 flex items-center space-x-1\">\n              <Sparkles className=\"w-3.5 h-3.5 text-purple-600\" />\n              <span>Revisi\303\263n Human-in-the-Loop (US-42..US-46)</span>\n            </span>\n            <span className=\"text-xs text-slate-500\">\n              {acceptedCount} de {tokens.length} variables confirmadas\n            </span>\n          </div>\n          <h2 className=\"text-lg font-serif font-bold text-slate-900 mt-0.5\">\n            Verificaci\303\263n y Aprobaci\303\263n de Detecci\303\263n Autom\303\241tica\n          </h2>\n        </div>\n\n        {/* Global actions */}\n        <div className=\"flex items-center space-x-2\">\n          {selectedForMerge.length >= 2 && (\n            <button\n              onClick={handleExecuteMerge}\n              className=\"px-3 py-1.5 rounded-lg text-xs font-semibold bg-purple-600 hover:bg-purple-500 text-white shadow-xs flex items-center space-x-1\"\n            >\n              <Merge className=\"w-3.5 h-3.5\" />\n              <span>Fusionar Seleccionadas ({selectedForMerge.length})</span>\n            </button>\n          )}\n\n          <button\n            onClick={handleAcceptAll}\n            className=\"px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors\"\n          >\n            Aceptar Todas\n          </button>\n\n          <button\n            onClick={handleRejectAll}\n            className=\"px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors\"\n          >\n            Rechazar Todas\n          </button>\n\n          <button\n            onClick={handleCommit}\n            className=\"px-4 py-2 rounded-lg text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white shadow-sm flex items-center space-x-1.5 transition-all\"\n          >\n            <Check className=\"w-4 h-4\" />\n            <span>Confirmar e Incorporar a Plantilla</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Split Screen Workspace */}\n      <div className=\"flex-1 flex overflow-hidden\">\n        {/* Left Side: Original Text with Highlights */}\n        <div className=\"w-1/2 h-full flex flex-col bg-white border-r border-slate-200\">\n          <div className=\"p-3 bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-700 flex items-center justify-between\">\n            <span className=\"flex items-center space-x-1.5\">\n              <FileText className=\"w-3.5 h-3.5 text-blue-600\" />\n              <span>Documento Original Importado</span>\n            </span>\n            <span className=\"text-[11px] text-slate-400 font-mono\">{originalText.length} caracteres</span>\n          </div>\n\n          <div className=\"flex-1 p-6 overflow-y-auto font-serif text-sm leading-relaxed text-slate-800 whitespace-pre-wrap selection:bg-purple-100\">\n            {originalText}\n          </div>\n        </div>\n\n        {/* Right Side: Detected Tokens Verification List */}\n        <div className=\"w-1/2 h-full flex flex-col bg-slate-50\">\n          <div className=\"p-3 bg-slate-100 border-b border-slate-200 text-xs font-semibold text-slate-700 flex items-center justify-between\">\n            <span className=\"flex items-center space-x-1.5\">\n              <ShieldCheck className=\"w-3.5 h-3.5 text-purple-600\" />\n              <span>Variables Detectadas para Aprobaci\303\263n ({tokens.length})</span>\n            </span>\n            <span className=\"text-[11px] text-purple-700 font-medium\">Validadores Dominicanos Activos \360\237\207\251\360\237\207\264</span>\n          </div>\n\n          <div className=\"flex-1 p-4 overflow-y-auto space-y-3\">\n            {tokens.length === 0 ? (\n              <div className=\"p-8 text-center text-slate-400 text-xs\">\n                No se detectaron variables en el texto proporcionado.\n              </div>\n            ) : (\n              tokens.map((token) => {\n                const isSelectedForMerge = selectedForMerge.includes(token.id);\n\n                return (\n                  <div\n                    key={token.id}\n                    className={`p-4 rounded-xl border transition-all ${\n                      token.status === \'ACEPTADA\' || token.status === \'MODIFICADA\'\n                        ? \'bg-emerald-50/40 border-emerald-200\'\n                        : token.status === \'RECHAZADA\'\n                        ? \'bg-slate-100/60 border-slate-200 opacity-60\'\n                        : token.status === \'FUSIONADA\'\n                        ? \'bg-purple-50/40 border-purple-200\'\n                        : \'bg-white border-slate-200 shadow-xs\'\n                    }`}\n                  >\n                    <div className=\"flex items-start justify-between gap-3\">\n                      <div className=\"space-y-1 flex-1\">\n                        {/* Token Header */}\n                        <div className=\"flex items-center space-x-2 flex-wrap\">\n                          {editingTokenId === token.id ? (\n                            <div className=\"flex items-center space-x-1\">\n                              <input\n                                type=\"text\"\n                                value={editedTag}\n                                onChange={(e) => setEditedTag(e.target.value)}\n                                className=\"font-mono text-xs px-2 py-0.5 border border-blue-400 rounded bg-white\"\n                              />\n                              <button\n                                onClick={() => handleSaveEditTag(token)}\n                                className=\"p-1 bg-emerald-600 text-white rounded hover:bg-emerald-500\"\n                              >\n                                <Check className=\"w-3 h-3\" />\n                              </button>\n                            </div>\n                          ) : (\n                            <span className=\"font-mono font-bold text-xs text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-100\">\n                              {`{{${token.tag}}}`}\n                            </span>\n                          )}\n\n                          <span className=\"text-[10px] px-2 py-0.5 rounded bg-slate-100 text-slate-600 font-mono\">\n                            {token.dataType}\n                          </span>\n\n                          <span\n                            className={`text-[10px] px-2 py-0.5 rounded-full font-bold ${\n                              token.confidence >= 0.85\n                                ? \'bg-emerald-100 text-emerald-800\'\n                                : token.confidence >= 0.6\n                                ? \'bg-amber-100 text-amber-800\'\n                                : \'bg-rose-100 text-rose-800\'\n                            }`}\n                          >\n                            {Math.round(token.confidence * 100)}% confianza\n                          </span>\n\n                          <span\n                            className={`text-[10px] font-bold uppercase ${\n                              token.status === \'ACEPTADA\'\n                                ? \'text-emerald-600\'\n                                : token.status === \'RECHAZADA\'\n                                ? \'text-slate-400 line-through\'\n                                : token.status === \'FUSIONADA\'\n                                ? \'text-purple-600\'\n                                : \'text-amber-600\'\n                            }`}\n                          >\n                            {token.status}\n                          </span>\n                        </div>\n\n                        {/* Extracted value preview */}\n                        <div className=\"text-xs text-slate-700 font-serif bg-slate-50 p-2 rounded border border-slate-100\">\n                          Texto detectado: <strong className=\"text-slate-900 font-sans\">\"{token.originalValue}\"</strong>\n                        </div>\n                      </div>\n\n                      {/* Token Actions */}\n                      <div className=\"flex items-center space-x-1 shrink-0\">\n                        <button\n                          onClick={() => handleToggleMergeSelection(token.id)}\n                          className={`p-1.5 rounded-md transition-colors ${\n                            isSelectedForMerge\n                              ? \'bg-purple-600 text-white\'\n                              : \'text-slate-400 hover:text-purple-600 hover:bg-purple-50\'\n                          }`}\n                          title=\"Seleccionar para fusi\303\263n con otra variable (US-45)\"\n                        >\n                          <Merge className=\"w-3.5 h-3.5\" />\n                        </button>\n\n                        <button\n                          onClick={() => handleStartEditTag(token)}\n                          className=\"p-1.5 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-md transition-colors\"\n                          title=\"Editar Identificador Tag (US-44)\"\n                        >\n                          <Edit2 className=\"w-3.5 h-3.5\" />\n                        </button>\n\n                        {token.status !== \'ACEPTADA\' && (\n                          <button\n                            onClick={() => acceptHitlToken(token.id)}\n                            className=\"p-1.5 text-slate-400 hover:text-emerald-600 hover:bg-emerald-50 rounded-md transition-colors\"\n                            title=\"Aceptar variable\"\n                          >\n                            <CheckCircle2 className=\"w-4 h-4\" />\n                          </button>\n                        )}\n\n                        {token.status !== \'RECHAZADA\' && (\n                          <button\n                            onClick={() => rejectHitlToken(token.id)}\n                            className=\"p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-md transition-colors\"\n                            title=\"Rechazar variable\"\n                          >\n                            <XCircle className=\"w-4 h-4\" />\n                          </button>\n                        )}\n                      </div>\n                    </div>\n                  </div>\n                );\n              })\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
