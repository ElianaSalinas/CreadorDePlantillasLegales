  file_change {
    absolute_path_uri: "file:///src/components/DocumentsVault.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  FileCheck2,\n  Download,\n  Printer,\n  FileText,\n  Search,\n  Trash2,\n  Eye,\n  Calendar,\n  Layers,\n  ChevronRight,\n  Sparkles,\n  Scale,\n  ShieldCheck,\n  CheckCircle2,\n  Copy,\n  Edit3,\n  Save,\n  RotateCcw,\n  Plus,\n  Filter,\n  User,\n  Building,\n  Info,\n  Clock,\n  ArrowRight,\n} from \'lucide-react\';\nimport { useAppStore } from \'../store/useAppStore\';\nimport { GeneratedDocument, LegalTemplate } from \'../types\';\nimport { generateDocxBlob, generatePdfBlob } from \'../core/exportEngine\';\n\nexport const DocumentsVault: React.FC = () => {\n  const {\n    state,\n    setView,\n    setActiveTemplateId,\n    deleteGeneratedDocument,\n    updateGeneratedDocument,\n    duplicateGeneratedDocument,\n    restoreSampleGeneratedDocuments,\n  } = useAppStore();\n\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [statusFilter, setStatusFilter] = useState<\'ALL\' | \'NOTARIADO\' | \'EMITIDO\' | \'BORRADOR\' | \'ARCHIVADO\'>(\'ALL\');\n  const [selectedDocId, setSelectedDocId] = useState<string | null>(\n    state.generatedDocuments[0]?.id || null\n  );\n  const [activeTab, setActiveTab] = useState<\'PREVIEW\' | \'VARIABLES\' | \'EDIT_TEXT\'>(\'PREVIEW\');\n  const [editedText, setEditedText] = useState(\'\');\n  const [isEditing, setIsEditing] = useState(false);\n  const [isNewModalOpen, setIsNewModalOpen] = useState(false);\n  const [copiedKey, setCopiedKey] = useState<string | null>(null);\n  const [toastMessage, setToastMessage] = useState<string | null>(null);\n\n  const showToast = (msg: string) => {\n    setToastMessage(msg);\n    setTimeout(() => setToastMessage(null), 3500);\n  };\n\n  const selectedDoc = state.generatedDocuments.find((d) => d.id === selectedDocId) || state.generatedDocuments[0] || null;\n\n  // Filtered documents\n  const filteredDocs = state.generatedDocuments.filter((doc) => {\n    const matchesSearch =\n      doc.title.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      doc.templateName.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      (doc.author && doc.author.toLowerCase().includes(searchQuery.toLowerCase())) ||\n      (doc.valuesSnapshot &&\n        Object.values(doc.valuesSnapshot).some(\n          (val) => typeof val === \'string\' && val.toLowerCase().includes(searchQuery.toLowerCase())\n        ));\n\n    const matchesStatus =\n      statusFilter === \'ALL\' ||\n      (statusFilter === \'NOTARIADO\' && doc.status === \'NOTARIADO\') ||\n      (statusFilter === \'EMITIDO\' && (doc.status === \'EMITIDO\' || doc.status === \'APROBADO\' || doc.status === \'GENERADO\')) ||\n      (statusFilter === \'BORRADOR\' && (doc.status === \'BORRADOR\' || doc.status === \'EN_REVISION\')) ||\n      (statusFilter === \'ARCHIVADO\' && doc.status === \'ARCHIVADO\');\n\n    return matchesSearch && matchesStatus;\n  });\n\n  // Statistics\n  const totalDocs = state.generatedDocuments.length;\n  const notariadosCount = state.generatedDocuments.filter((d) => d.status === \'NOTARIADO\').length;\n  const emitidosCount = state.generatedDocuments.filter(\n    (d) => d.status === \'EMITIDO\' || d.status === \'APROBADO\' || d.status === \'GENERADO\'\n  ).length;\n  const borradoresCount = state.generatedDocuments.filter(\n    (d) => d.status === \'BORRADOR\' || d.status === \'EN_REVISION\' || !d.status\n  ).length;\n\n  const handleDownloadDocx = async (doc: GeneratedDocument) => {\n    try {\n      const blob = await generateDocxBlob(doc.title, doc.renderedContent || doc.finalContent || \'\');\n      const url = URL.createObjectURL(blob);\n      const a = document.createElement(\'a\');\n      a.href = url;\n      a.download = `${doc.title.replace(/[^a-zA-Z0-9_-]/g, \'_\')}.docx`;\n      a.click();\n      URL.revokeObjectURL(url);\n      showToast(\'Documento Word (.docx) descargado con \303\251xito.\');\n    } catch (e: any) {\n      alert(`Error al generar DOCX: ${e.message}`);\n    }\n  };\n\n  const handleDownloadPdf = (doc: GeneratedDocument) => {\n    try {\n      const blob = generatePdfBlob(doc.title, doc.renderedContent || doc.finalContent || \'\');\n      const url = URL.createObjectURL(blob);\n      const a = document.createElement(\'a\');\n      a.href = url;\n      a.download = `${doc.title.replace(/[^a-zA-Z0-9_-]/g, \'_\')}.pdf`;\n      a.click();\n      URL.revokeObjectURL(url);\n      showToast(\'Documento Notarial (.pdf) descargado con \303\251xito.\');\n    } catch (e: any) {\n      alert(`Error al generar PDF: ${e.message}`);\n    }\n  };\n\n  const handleStartEditing = () => {\n    if (!selectedDoc) return;\n    setEditedText(selectedDoc.renderedContent || selectedDoc.finalContent || \'\');\n    setIsEditing(true);\n    setActiveTab(\'EDIT_TEXT\');\n  };\n\n  const handleSaveEditedText = () => {\n    if (!selectedDoc) return;\n    updateGeneratedDocument(selectedDoc.id, {\n      renderedContent: editedText,\n      finalContent: editedText,\n    });\n    setIsEditing(false);\n    setActiveTab(\'PREVIEW\');\n    showToast(\'Modificaciones guardadas en el contrato final.\');\n  };\n\n  const handleStatusChange = (newStatus: any) => {\n    if (!selectedDoc) return;\n    updateGeneratedDocument(selectedDoc.id, { status: newStatus });\n    showToast(`Estado cambiado a: ${newStatus}`);\n  };\n\n  const handleDelete = (docId: string) => {\n    if (confirm(\'\302\277Est\303\241s seguro de eliminar este contrato final de la b\303\263veda? Esta acci\303\263n no se puede deshacer.\')) {\n      deleteGeneratedDocument(docId);\n      if (selectedDocId === docId) {\n        setSelectedDocId(state.generatedDocuments.find((d) => d.id !== docId)?.id || null);\n      }\n      showToast(\'Contrato final eliminado de la b\303\263veda.\');\n    }\n  };\n\n  const handleDuplicate = (docId: string) => {\n    duplicateGeneratedDocument(docId);\n    showToast(\'Copia del contrato creada con \303\251xito.\');\n  };\n\n  const copyToClipboard = (text: string, key: string) => {\n    navigator.clipboard.writeText(text);\n    setCopiedKey(key);\n    setTimeout(() => setCopiedKey(null), 2000);\n  };\n\n  const handleSelectTemplateForNew = (template: LegalTemplate) => {\n    setActiveTemplateId(template.id);\n    setIsNewModalOpen(false);\n    setView(\'FORM_GEN\');\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6\">\n      {/* Toast Notification */}\n      {toastMessage && (\n        <div className=\"fixed bottom-6 right-6 z-50 bg-slate-900 text-white px-4 py-3 rounded-xl shadow-2xl border border-slate-700 flex items-center space-x-2.5 text-xs animate-bounce\">\n          <CheckCircle2 className=\"w-4 h-4 text-emerald-400 shrink-0\" />\n          <span className=\"font-medium\">{toastMessage}</span>\n        </div>\n      )}\n\n      {/* Main Header / Explanation Banner */}\n      <div className=\"bg-white rounded-2xl border border-slate-200/90 p-6 shadow-xs space-y-4\">\n        <div className=\"flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4\">\n          <div>\n            <div className=\"flex items-center space-x-2.5\">\n              <span className=\"inline-flex items-center space-x-1.5 bg-amber-50 text-amber-800 border border-amber-200/80 px-2.5 py-0.5 rounded-md text-xs font-bold uppercase tracking-wider\">\n                <FileCheck2 className=\"w-3.5 h-3.5 text-amber-600\" />\n                <span>B\303\263veda de Contratos Finales</span>\n              </span>\n              <span className=\"text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded font-mono font-medium\">\n                {totalDocs} contratos guardados\n              </span>\n            </div>\n            <h1 className=\"text-2xl sm:text-3xl font-bold text-slate-900 font-serif mt-2\">\n              Contratos Finales Emitidos & Actos Notariados\n            </h1>\n            <p className=\"text-xs sm:text-sm text-slate-600 mt-1.5 max-w-3xl leading-relaxed\">\n              Repositorio seguro de contratos terminados, listos para firma o legalizados con fe p\303\272blica notarial dominicana. \n              A diferencia de las plantillas param\303\251tricas, estos documentos contienen los datos definitivos capturados de las partes e inmuebles.\n            </p>\n          </div>\n\n          {/* Quick Actions */}\n          <div className=\"flex flex-wrap items-center gap-2.5 shrink-0\">\n            <button\n              onClick={() => setIsNewModalOpen(true)}\n              className=\"flex items-center space-x-2 px-4 py-2.5 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold rounded-xl text-xs shadow-sm transition-all\"\n            >\n              <Plus className=\"w-4 h-4 text-slate-950\" />\n              <span>+ Redactar Nuevo Contrato</span>\n            </button>\n\n            {state.generatedDocuments.length === 0 && (\n              <button\n                onClick={restoreSampleGeneratedDocuments}\n                className=\"flex items-center space-x-1.5 px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-medium border border-slate-300 transition-colors\"\n                title=\"Cargar contratos dominicanos de ejemplo\"\n              >\n                <RotateCcw className=\"w-3.5 h-3.5\" />\n                <span>Cargar Ejemplos RD</span>\n              </button>\n            )}\n          </div>\n        </div>\n\n        {/* Quick Stats Grid */}\n        <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2 border-t border-slate-100\">\n          <div className=\"bg-slate-50/70 p-3 rounded-xl border border-slate-200/80\">\n            <span className=\"text-[11px] font-semibold text-slate-500 block\">Total en B\303\263veda</span>\n            <span className=\"text-xl font-bold text-slate-900 font-mono\">{totalDocs}</span>\n          </div>\n\n          <div className=\"bg-emerald-50/70 p-3 rounded-xl border border-emerald-200/80\">\n            <span className=\"text-[11px] font-semibold text-emerald-800 block\">\342\232\226\357\270\217 Notariados (Fe P\303\272blica)</span>\n            <span className=\"text-xl font-bold text-emerald-900 font-mono\">{notariadosCount}</span>\n          </div>\n\n          <div className=\"bg-blue-50/70 p-3 rounded-xl border border-blue-200/80\">\n            <span className=\"text-[11px] font-semibold text-blue-800 block\">\360\237\223\235 Emitidos para Firma</span>\n            <span className=\"text-xl font-bold text-blue-900 font-mono\">{emitidosCount}</span>\n          </div>\n\n          <div className=\"bg-amber-50/70 p-3 rounded-xl border border-amber-200/80\">\n            <span className=\"text-[11px] font-semibold text-amber-800 block\">\360\237\223\204 Borradores Finales</span>\n            <span className=\"text-xl font-bold text-amber-900 font-mono\">{borradoresCount}</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Main Content Layout: List on Left, Preview/Editor on Right */}\n      {state.generatedDocuments.length === 0 ? (\n        <div className=\"bg-white rounded-2xl p-12 text-center border border-slate-200 shadow-xs space-y-4\">\n          <div className=\"w-16 h-16 rounded-full bg-amber-50 border border-amber-200 flex items-center justify-center mx-auto text-amber-600\">\n            <FileCheck2 className=\"w-8 h-8\" />\n          </div>\n          <h3 className=\"text-lg font-bold text-slate-900 font-serif\">No hay contratos finales guardados</h3>\n          <p className=\"text-xs text-slate-500 max-w-md mx-auto leading-relaxed\">\n            Puedes generar tu primer contrato legal llenando los datos en una plantilla o cargar los contratos dominicanos de muestra con actos de alquiler y pagar\303\251s aut\303\251nticos.\n          </p>\n          <div className=\"flex items-center justify-center space-x-3 pt-2\">\n            <button\n              onClick={() => setIsNewModalOpen(true)}\n              className=\"px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold rounded-xl shadow-xs transition-colors\"\n            >\n              Generar desde Plantilla\n            </button>\n            <button\n              onClick={restoreSampleGeneratedDocuments}\n              className=\"px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl border border-slate-300 transition-colors\"\n            >\n              Cargar Muestras Dominicanas\n            </button>\n          </div>\n        </div>\n      ) : (\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n          {/* LEFT: Documents List & Search */}\n          <div className=\"lg:col-span-5 bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden flex flex-col\">\n            {/* Search and Filters Header */}\n            <div className=\"p-3 bg-slate-50/80 border-b border-slate-200 space-y-2.5\">\n              <div className=\"relative\">\n                <Search className=\"w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" />\n                <input\n                  type=\"text\"\n                  placeholder=\"Buscar por t\303\255tulo, inquilino, deudor, c\303\251dula...\"\n                  value={searchQuery}\n                  onChange={(e) => setSearchQuery(e.target.value)}\n                  className=\"w-full pl-8 pr-3 py-2 text-xs rounded-xl border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-2xs\"\n                />\n              </div>\n\n              {/* Status Filter Tabs */}\n              <div className=\"flex items-center space-x-1 overflow-x-auto pb-1 text-[11px]\">\n                <button\n                  onClick={() => setStatusFilter(\'ALL\')}\n                  className={`px-2.5 py-1 rounded-lg font-medium whitespace-nowrap transition-colors ${\n                    statusFilter === \'ALL\'\n                      ? \'bg-slate-900 text-white font-bold\'\n                      : \'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200\'\n                  }`}\n                >\n                  Todos ({totalDocs})\n                </button>\n                <button\n                  onClick={() => setStatusFilter(\'NOTARIADO\')}\n                  className={`px-2.5 py-1 rounded-lg font-medium whitespace-nowrap transition-colors ${\n                    statusFilter === \'NOTARIADO\'\n                      ? \'bg-emerald-700 text-white font-bold\'\n                      : \'bg-white text-emerald-800 hover:bg-emerald-50 border border-emerald-200\'\n                  }`}\n                >\n                  Notariados ({notariadosCount})\n                </button>\n                <button\n                  onClick={() => setStatusFilter(\'EMITIDO\')}\n                  className={`px-2.5 py-1 rounded-lg font-medium whitespace-nowrap transition-colors ${\n                    statusFilter === \'EMITIDO\'\n                      ? \'bg-blue-700 text-white font-bold\'\n                      : \'bg-white text-blue-800 hover:bg-blue-50 border border-blue-200\'\n                  }`}\n                >\n                  Emitidos ({emitidosCount})\n                </button>\n                <button\n                  onClick={() => setStatusFilter(\'BORRADOR\')}\n                  className={`px-2.5 py-1 rounded-lg font-medium whitespace-nowrap transition-colors ${\n                    statusFilter === \'BORRADOR\'\n                      ? \'bg-amber-700 text-white font-bold\'\n                      : \'bg-white text-amber-800 hover:bg-amber-50 border border-amber-200\'\n                  }`}\n                >\n                  Borradores ({borradoresCount})\n                </button>\n              </div>\n            </div>\n\n            {/* List Items */}\n            <div className=\"divide-y divide-slate-100 max-h-[620px] overflow-y-auto\">\n              {filteredDocs.length === 0 ? (\n                <div className=\"p-8 text-center text-slate-400 text-xs\">\n                  No se encontraron contratos con los filtros aplicados.\n                </div>\n              ) : (\n                filteredDocs.map((doc) => {\n                  const isSelected = selectedDoc?.id === doc.id;\n                  const status = doc.status || \'EMITIDO\';\n\n                  return (\n                    <button\n                      key={doc.id}\n                      onClick={() => {\n                        setSelectedDocId(doc.id);\n                        setIsEditing(false);\n                        setActiveTab(\'PREVIEW\');\n                      }}\n                      className={`w-full text-left p-4 transition-all flex items-start justify-between group ${\n                        isSelected\n                          ? \'bg-blue-50/80 border-l-4 border-blue-600 shadow-2xs\'\n                          : \'hover:bg-slate-50/80\'\n                      }`}\n                    >\n                      <div className=\"space-y-1.5 flex-1 pr-2\">\n                        <div className=\"flex items-center space-x-2\">\n                          <span\n                            className={`text-[10px] font-bold px-2 py-0.5 rounded-md uppercase font-mono ${\n                              status === \'NOTARIADO\'\n                                ? \'bg-emerald-100 text-emerald-800 border border-emerald-200\'\n                                : status === \'EMITIDO\' || status === \'APROBADO\' || status === \'GENERADO\'\n                                ? \'bg-blue-100 text-blue-800 border border-blue-200\'\n                                : \'bg-amber-100 text-amber-800 border border-amber-200\'\n                            }`}\n                          >\n                            {status === \'NOTARIADO\'\n                              ? \'\342\232\226\357\270\217 Notariado\'\n                              : status === \'EMITIDO\'\n                              ? \'\360\237\223\235 Emitido\'\n                              : \'\360\237\223\204 Borrador\'}\n                          </span>\n\n                          <span className=\"text-[10px] text-slate-400 font-mono\">\n                            {doc.format || \'DOCX\'}\n                          </span>\n                        </div>\n\n                        <h4 className=\"font-serif font-bold text-xs text-slate-900 line-clamp-2 leading-snug\">\n                          {doc.title}\n                        </h4>\n\n                        <div className=\"text-[11px] text-slate-500 flex items-center space-x-1.5\">\n                          <span className=\"truncate\">Plantilla base: {doc.templateName}</span>\n                        </div>\n\n                        <div className=\"flex items-center space-x-3 text-[10px] text-slate-400 pt-0.5\">\n                          <span className=\"flex items-center space-x-1\">\n                            <Clock className=\"w-3 h-3 text-slate-400\" />\n                            <span>\n                              {doc.createdAt\n                                ? new Date(doc.createdAt).toLocaleDateString(\'es-DO\', {\n                                    day: \'2-digit\',\n                                    month: \'short\',\n                                    year: \'numeric\',\n                                  })\n                                : \'Fecha no disponible\'}\n                            </span>\n                          </span>\n                          {doc.valuesSnapshot && (\n                            <span>{Object.keys(doc.valuesSnapshot).length} datos capturados</span>\n                          )}\n                        </div>\n                      </div>\n\n                      <ChevronRight\n                        className={`w-4 h-4 shrink-0 mt-2 transition-transform ${\n                          isSelected ? \'text-blue-600 translate-x-0.5\' : \'text-slate-300 group-hover:text-slate-500\'\n                        }`}\n                      />\n                    </button>\n                  );\n                })\n              )}\n            </div>\n          </div>\n\n          {/* RIGHT: Document Details & Viewer */}\n          <div className=\"lg:col-span-7 bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden\">\n            {selectedDoc ? (\n              <div>\n                {/* Header Action Bar */}\n                <div className=\"p-4 bg-slate-50/90 border-b border-slate-200 space-y-3\">\n                  <div className=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3\">\n                    <div>\n                      <div className=\"flex items-center space-x-2\">\n                        <select\n                          value={selectedDoc.status || \'EMITIDO\'}\n                          onChange={(e) => handleStatusChange(e.target.value)}\n                          className=\"text-[11px] font-bold px-2.5 py-1 rounded-lg border border-slate-300 bg-white focus:ring-2 focus:ring-blue-500\"\n                        >\n                          <option value=\"NOTARIADO\">\342\232\226\357\270\217 Estado: Notariado (Fe P\303\272blica)</option>\n                          <option value=\"EMITIDO\">\360\237\223\235 Estado: Emitido / Listo para Firma</option>\n                          <option value=\"BORRADOR\">\360\237\223\204 Estado: Borrador Final</option>\n                          <option value=\"ARCHIVADO\">\360\237\227\204\357\270\217 Estado: Archivado</option>\n                        </select>\n\n                        <span className=\"text-[11px] text-slate-500 font-mono\">\n                          ID: {selectedDoc.id.slice(-8)}\n                        </span>\n                      </div>\n\n                      <h3 className=\"font-serif font-bold text-base text-slate-900 mt-1\">\n                        {selectedDoc.title}\n                      </h3>\n                      <p className=\"text-[11px] text-slate-500\">\n                        Autor: {selectedDoc.author || \'Lic. Stephania Montero (CARD 14092)\'} \342\200\242{\' \'}\n                        {selectedDoc.createdAt && new Date(selectedDoc.createdAt).toLocaleString(\'es-DO\')}\n                      </p>\n                    </div>\n\n                    {/* Export & Print Controls */}\n                    <div className=\"flex items-center space-x-2 shrink-0\">\n                      <button\n                        onClick={() => handleDownloadDocx(selectedDoc)}\n                        className=\"flex items-center space-x-1 px-3 py-1.5 rounded-lg text-xs font-semibold bg-blue-600 hover:bg-blue-500 text-white shadow-xs transition-colors\"\n                        title=\"Descargar en formato Word editable (.docx)\"\n                      >\n                        <Download className=\"w-3.5 h-3.5\" />\n                        <span>Word .DOCX</span>\n                      </button>\n\n                      <button\n                        onClick={() => handleDownloadPdf(selectedDoc)}\n                        className=\"flex items-center space-x-1 px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-900 hover:bg-slate-800 text-white shadow-xs transition-colors\"\n                        title=\"Descargar o imprimir PDF Notarial\"\n                      >\n                        <Printer className=\"w-3.5 h-3.5\" />\n                        <span>PDF / Imprimir</span>\n                      </button>\n                    </div>\n                  </div>\n\n                  {/* Secondary Toolbar (Tabs + Actions) */}\n                  <div className=\"flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-slate-200/80\">\n                    <div className=\"flex items-center space-x-1 bg-slate-200/70 p-1 rounded-xl\">\n                      <button\n                        onClick={() => {\n                          setIsEditing(false);\n                          setActiveTab(\'PREVIEW\');\n                        }}\n                        className={`px-3 py-1 rounded-lg text-xs font-semibold transition-all ${\n                          activeTab === \'PREVIEW\'\n                            ? \'bg-white text-slate-900 shadow-xs\'\n                            : \'text-slate-600 hover:text-slate-900\'\n                        }`}\n                      >\n                        Vista Notarial Formal\n                      </button>\n\n                      <button\n                        onClick={() => {\n                          setIsEditing(false);\n                          setActiveTab(\'VARIABLES\');\n                        }}\n                        className={`px-3 py-1 rounded-lg text-xs font-semibold transition-all ${\n                          activeTab === \'VARIABLES\'\n                            ? \'bg-white text-slate-900 shadow-xs\'\n                            : \'text-slate-600 hover:text-slate-900\'\n                        }`}\n                      >\n                        Snapshot de Datos ({selectedDoc.valuesSnapshot ? Object.keys(selectedDoc.valuesSnapshot).length : 0})\n                      </button>\n\n                      <button\n                        onClick={handleStartEditing}\n                        className={`px-3 py-1 rounded-lg text-xs font-semibold transition-all ${\n                          activeTab === \'EDIT_TEXT\'\n                            ? \'bg-white text-slate-900 shadow-xs\'\n                            : \'text-slate-600 hover:text-slate-900\'\n                        }`}\n                      >\n                        <span className=\"flex items-center space-x-1\">\n                          <Edit3 className=\"w-3 h-3\" />\n                          <span>Editar Texto</span>\n                        </span>\n                      </button>\n                    </div>\n\n                    <div className=\"flex items-center space-x-1.5\">\n                      <button\n                        onClick={() => handleDuplicate(selectedDoc.id)}\n                        className=\"px-2.5 py-1 text-[11px] font-medium text-slate-600 hover:bg-slate-200 rounded-lg transition-colors flex items-center space-x-1\"\n                        title=\"Duplicar como nuevo contrato\"\n                      >\n                        <Copy className=\"w-3 h-3\" />\n                        <span>Duplicar</span>\n                      </button>\n\n                      <button\n                        onClick={() => handleDelete(selectedDoc.id)}\n                        className=\"px-2.5 py-1 text-[11px] font-medium text-rose-600 hover:bg-rose-50 rounded-lg transition-colors flex items-center space-x-1\"\n                        title=\"Eliminar contrato de la b\303\263veda\"\n                      >\n                        <Trash2 className=\"w-3 h-3\" />\n                        <span>Eliminar</span>\n                      </button>\n                    </div>\n                  </div>\n                </div>\n\n                {/* TAB 1: NOTARIAL PREVIEW */}\n                {activeTab === \'PREVIEW\' && (\n                  <div className=\"p-6 bg-amber-50/20 max-h-[580px] overflow-y-auto\">\n                    {/* Parchment Document Sheet */}\n                    <div className=\"bg-white p-8 sm:p-12 rounded-xl shadow-md border border-slate-200 max-w-2xl mx-auto font-serif text-slate-900 text-xs sm:text-sm leading-relaxed space-y-4 relative\">\n                      {/* Top Solemn Seal */}\n                      <div className=\"text-center pb-4 border-b border-slate-200\">\n                        <div className=\"flex items-center justify-center space-x-2 text-slate-700\">\n                          <Scale className=\"w-5 h-5 text-amber-600\" />\n                          <span className=\"font-bold uppercase tracking-widest text-[11px]\">\n                            Rep\303\272blica Dominicana \342\200\242 Fe Notarial\n                          </span>\n                        </div>\n                        <span className=\"text-[10px] text-slate-400 font-sans block mt-0.5\">\n                          Acto Aut\303\251ntico Registrado en B\303\263veda Legal SAVE\n                        </span>\n                      </div>\n\n                      {/* Rendered Contract Text */}\n                      <div className=\"whitespace-pre-wrap selection:bg-amber-100 font-serif text-slate-800 text-xs sm:text-[13px] leading-relaxed\">\n                        {selectedDoc.renderedContent || selectedDoc.finalContent}\n                      </div>\n\n                      {/* Notarial Stamp Stamp */}\n                      <div className=\"pt-6 border-t border-slate-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 font-sans text-[11px] text-slate-500\">\n                        <div>\n                          <span className=\"font-semibold text-slate-800 block\">\n                            {selectedDoc.author || \'Lic. Stephania Montero\'}\n                          </span>\n                          <span>Notaria P\303\272blica de los del N\303\272mero del Distrito Nacional</span>\n                          <span className=\"block font-mono text-emerald-600 font-bold\">Matr\303\255cula CARD No. 14092</span>\n                        </div>\n\n                        <div className=\"p-2.5 bg-emerald-50 border border-emerald-200 rounded-lg text-emerald-800 font-mono text-[10px] text-center\">\n                          <ShieldCheck className=\"w-4 h-4 mx-auto mb-0.5 text-emerald-600\" />\n                          <span>DOCUMENTO LEGALIZADO</span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                )}\n\n                {/* TAB 2: VARIABLES & CAPTURED DATA SNAPSHOT */}\n                {activeTab === \'VARIABLES\' && (\n                  <div className=\"p-6 max-h-[580px] overflow-y-auto space-y-4\">\n                    <div className=\"bg-blue-50/70 p-3.5 rounded-xl border border-blue-200/80 text-xs text-blue-950 flex items-start space-x-2.5\">\n                      <Info className=\"w-4 h-4 text-blue-600 shrink-0 mt-0.5\" />\n                      <div>\n                        <span className=\"font-bold\">Snapshot de Datos Capturados:</span>\n                        <p className=\"text-blue-800 text-[11px] mt-0.5\">\n                          Estos son los valores y respuestas capturados de los comparecientes al momento de emitir este contrato final.\n                        </p>\n                      </div>\n                    </div>\n\n                    {selectedDoc.valuesSnapshot && Object.keys(selectedDoc.valuesSnapshot).length > 0 ? (\n                      <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                        {Object.entries(selectedDoc.valuesSnapshot).map(([key, value]) => (\n                          <div\n                            key={key}\n                            className=\"bg-white p-3 rounded-xl border border-slate-200 shadow-2xs space-y-1 relative group hover:border-blue-300 transition-colors\"\n                          >\n                            <div className=\"flex items-center justify-between\">\n                              <span className=\"font-mono text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded border border-blue-100\">\n                                {`{{${key}}}`}\n                              </span>\n                              <button\n                                onClick={() => copyToClipboard(String(value), key)}\n                                className=\"text-slate-400 hover:text-slate-600 p-1 rounded\"\n                                title=\"Copiar valor\"\n                              >\n                                {copiedKey === key ? (\n                                  <CheckCircle2 className=\"w-3 h-3 text-emerald-600\" />\n                                ) : (\n                                  <Copy className=\"w-3 h-3\" />\n                                )}\n                              </button>\n                            </div>\n                            <div className=\"text-xs font-semibold text-slate-800 break-words\">\n                              {value === true\n                                ? \'S\303\255 (Verdadero)\'\n                                : value === false\n                                ? \'No (Falso)\'\n                                : String(value)}\n                            </div>\n                          </div>\n                        ))}\n                      </div>\n                    ) : (\n                      <div className=\"p-8 text-center text-slate-400 text-xs\">\n                        No hay datos adicionales registrados en el snapshot de este contrato.\n                      </div>\n                    )}\n                  </div>\n                )}\n\n                {/* TAB 3: INLINE TEXT EDITOR */}\n                {activeTab === \'EDIT_TEXT\' && (\n                  <div className=\"p-4 space-y-3\">\n                    <div className=\"flex items-center justify-between bg-amber-50 p-3 rounded-xl border border-amber-200 text-xs text-amber-900\">\n                      <span>Modificando el texto final de este contrato espec\303\255fico en la b\303\263veda:</span>\n                      <button\n                        onClick={handleSaveEditedText}\n                        className=\"flex items-center space-x-1.5 px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-lg text-xs shadow-xs\"\n                      >\n                        <Save className=\"w-3.5 h-3.5\" />\n                        <span>Guardar Cambios</span>\n                      </button>\n                    </div>\n\n                    <textarea\n                      value={editedText}\n                      onChange={(e) => setEditedText(e.target.value)}\n                      rows={20}\n                      className=\"w-full p-4 rounded-xl border border-slate-300 font-serif text-xs leading-relaxed focus:ring-2 focus:ring-blue-500 focus:outline-none bg-slate-50/50\"\n                    />\n                  </div>\n                )}\n              </div>\n            ) : (\n              <div className=\"p-12 text-center text-slate-400 text-xs\">\n                Selecciona un contrato de la lista izquierda para previsualizar sus cl\303\241usulas y datos.\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n\n      {/* SELECT TEMPLATE MODAL FOR NEW FINAL CONTRACT */}\n      {isNewModalOpen && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/60 backdrop-blur-xs animate-in fade-in\">\n          <div className=\"bg-white rounded-2xl max-w-xl w-full p-6 shadow-2xl border border-slate-200 space-y-4\">\n            <div className=\"flex items-center justify-between pb-3 border-b border-slate-100\">\n              <div className=\"flex items-center space-x-2\">\n                <div className=\"w-8 h-8 rounded-lg bg-amber-100 flex items-center justify-center text-amber-700\">\n                  <Sparkles className=\"w-4 h-4\" />\n                </div>\n                <div>\n                  <h3 className=\"font-bold text-slate-900 text-sm\">Emitir Nuevo Contrato Final</h3>\n                  <p className=\"text-xs text-slate-500\">Selecciona la plantilla base para completar los datos de las partes:</p>\n                </div>\n              </div>\n              <button\n                onClick={() => setIsNewModalOpen(false)}\n                className=\"text-slate-400 hover:text-slate-600 text-sm font-bold p-1 rounded\"\n              >\n                \342\234\225\n              </button>\n            </div>\n\n            <div className=\"space-y-2 max-h-[380px] overflow-y-auto\">\n              {state.templates.map((tpl) => (\n                <button\n                  key={tpl.id}\n                  onClick={() => handleSelectTemplateForNew(tpl)}\n                  className=\"w-full text-left p-3.5 rounded-xl border border-slate-200 hover:border-blue-500 hover:bg-blue-50/50 transition-all flex items-center justify-between group\"\n                >\n                  <div className=\"space-y-1\">\n                    <div className=\"flex items-center space-x-2\">\n                      <span className=\"font-semibold text-xs text-slate-900 group-hover:text-blue-700\">\n                        {tpl.name}\n                      </span>\n                      <span className=\"text-[10px] bg-slate-100 text-slate-600 px-1.5 py-0.2 rounded font-mono\">\n                        {tpl.category}\n                      </span>\n                    </div>\n                    <p className=\"text-[11px] text-slate-500 line-clamp-1\">{tpl.description}</p>\n                    <span className=\"text-[10px] text-slate-400 block font-mono\">\n                      {tpl.variables.length} variables \342\200\242 {tpl.clauses.length} cl\303\241usulas\n                    </span>\n                  </div>\n\n                  <ArrowRight className=\"w-4 h-4 text-slate-400 group-hover:text-blue-600 shrink-0 group-hover:translate-x-1 transition-transform\" />\n                </button>\n              ))}\n            </div>\n\n            <div className=\"pt-2 flex justify-end\">\n              <button\n                onClick={() => setIsNewModalOpen(false)}\n                className=\"px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100\"\n              >\n                Cancelar\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
