    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  FileText,\n  FileCheck2,\n  Files,\n  PenTool,\n  Sliders,\n  BookOpen,\n  GitFork,\n  Sparkles,\n  ShieldCheck,\n  History,\n  Upload,\n  Code2,\n  UserCheck,\n  ChevronLeft,\n  ChevronRight,\n  Plus,\n  Scale,\n  Activity,\n  CheckCircle2,\n  Briefcase,\n  Layers,\n  Search,\n} from \'lucide-react\';\nimport { useAppStore } from \'../store/useAppStore\';\nimport { AppState } from \'../types\';\n\ninterface SidebarProps {\n  onOpenNewTemplateModal: () => void;\n  onOpenDocxImportModal: () => void;\n  onOpenHealthModal: () => void;\n  onOpenSchemaModal: () => void;\n  onOpenProfileModal: () => void;\n  onOpenAuditModal: () => void;\n  isMobileOpen: boolean;\n  setIsMobileOpen: (open: boolean) => void;\n}\n\nexport const Sidebar: React.FC<SidebarProps> = ({\n  onOpenNewTemplateModal,\n  onOpenDocxImportModal,\n  onOpenHealthModal,\n  onOpenSchemaModal,\n  onOpenProfileModal,\n  onOpenAuditModal,\n  isMobileOpen,\n  setIsMobileOpen,\n}) => {\n  const { state, setView, currentUser, activeTemplate } = useAppStore();\n  const [isCollapsed, setIsCollapsed] = useState(false);\n\n  const pendingHitlCount = state.hitlTokens.filter((t) => t.status === \'PENDIENTE\').length;\n  const finalDocsCount = state.generatedDocuments.length;\n  const templatesCount = state.templates.length;\n\n  const navigateTo = (view: AppState[\'currentView\']) => {\n    setView(view);\n    if (window.innerWidth < 1024) {\n      setIsMobileOpen(false);\n    }\n  };\n\n  return (\n    <>\n      {/* Mobile Backdrop Overlay */}\n      {isMobileOpen && (\n        <div\n          onClick={() => setIsMobileOpen(false)}\n          className=\"fixed inset-0 bg-slate-950/60 backdrop-blur-xs z-40 lg:hidden transition-opacity\"\n        />\n      )}\n\n      {/* Lateral Sidebar */}\n      <aside\n        className={`fixed lg:static top-0 bottom-0 left-0 z-50 flex flex-col bg-slate-900 border-r border-slate-800 text-slate-300 transition-all duration-300 ease-in-out shadow-2xl lg:shadow-none ${\n          isCollapsed ? \'w-20\' : \'w-72\'\n        } ${isMobileOpen ? \'translate-x-0\' : \'-translate-x-full lg:translate-x-0\'}`}\n      >\n        {/* Brand Header */}\n        <div className=\"p-4 border-b border-slate-800 flex items-center justify-between\">\n          <div className=\"flex items-center space-x-3 overflow-hidden\">\n            <div className=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-600 via-blue-600 to-indigo-600 p-0.5 shadow-md shrink-0 flex items-center justify-center text-white\">\n              <Scale className=\"w-5 h-5\" />\n            </div>\n            {!isCollapsed && (\n              <div className=\"leading-tight truncate\">\n                <div className=\"flex items-center space-x-1.5\">\n                  <span className=\"font-serif font-bold text-base text-white tracking-wide\">SAVE Legal</span>\n                  <span className=\"text-[10px] bg-blue-500/20 text-blue-300 border border-blue-500/30 px-1.5 py-0.2 rounded font-mono font-semibold\">\n                    RD \360\237\207\251\360\237\207\264\n                  </span>\n                </div>\n                <span className=\"text-[10px] text-slate-400 block truncate\">\n                  Gesti\303\263n Notarial & Contractual\n                </span>\n              </div>\n            )}\n          </div>\n\n          {/* Desktop Collapse Toggle */}\n          <button\n            onClick={() => setIsCollapsed(!isCollapsed)}\n            className=\"hidden lg:flex p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors\"\n            title={isCollapsed ? \'Expandir men\303\272 lateral\' : \'Contraer men\303\272 lateral\'}\n          >\n            {isCollapsed ? <ChevronRight className=\"w-4 h-4\" /> : <ChevronLeft className=\"w-4 h-4\" />}\n          </button>\n        </div>\n\n        {/* Primary Call to Action */}\n        <div className=\"p-3 border-b border-slate-800 space-y-2\">\n          <button\n            onClick={() => navigateTo(\'DOCUMENTS\')}\n            className={`w-full flex items-center justify-center space-x-2 py-2.5 px-3 rounded-xl font-semibold text-xs transition-all shadow-md ${\n              state.currentView === \'DOCUMENTS\'\n                ? \'bg-amber-500 hover:bg-amber-400 text-slate-950 ring-2 ring-amber-400/40 font-bold\'\n                : \'bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold\'\n            }`}\n            title=\"Ver Contratos Finales Guardados\"\n          >\n            <FileCheck2 className=\"w-4 h-4 shrink-0 text-slate-950\" />\n            {!isCollapsed && (\n              <span className=\"truncate flex items-center justify-between w-full\">\n                <span>Contratos Finales</span>\n                <span className=\"bg-slate-950/20 text-slate-950 text-[10px] px-1.5 py-0.5 rounded-full font-mono font-black\">\n                  {finalDocsCount}\n                </span>\n              </span>\n            )}\n          </button>\n\n          {!isCollapsed && (\n            <div className=\"grid grid-cols-2 gap-1.5 pt-1\">\n              <button\n                onClick={() => {\n                  if (activeTemplate) {\n                    navigateTo(\'FORM_GEN\');\n                  } else {\n                    navigateTo(\'TEMPLATES\');\n                  }\n                }}\n                className=\"flex items-center justify-center space-x-1.5 py-1.5 px-2 bg-blue-600/20 hover:bg-blue-600/30 text-blue-300 border border-blue-500/30 rounded-lg text-[11px] font-medium transition-colors\"\n                title=\"Generar contrato desde plantilla\"\n              >\n                <Sparkles className=\"w-3 h-3 text-blue-400\" />\n                <span>Emitir Acto</span>\n              </button>\n\n              <button\n                onClick={onOpenNewTemplateModal}\n                className=\"flex items-center justify-center space-x-1.5 py-1.5 px-2 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 rounded-lg text-[11px] font-medium transition-colors\"\n                title=\"Crear nueva plantilla\"\n              >\n                <Plus className=\"w-3 h-3 text-slate-300\" />\n                <span>+ Plantilla</span>\n              </button>\n            </div>\n          )}\n        </div>\n\n        {/* Scrollable Navigation Items */}\n        <div className=\"flex-1 overflow-y-auto py-3 px-2 space-y-5 scrollbar-thin scrollbar-thumb-slate-800\">\n          {/* SECTION 1: CONTRATOS FINALES & EMISI\303\223N */}\n          <div>\n            {!isCollapsed && (\n              <div className=\"px-3 pb-1.5 text-[10px] font-bold uppercase tracking-wider text-slate-400\">\n                Contratos Finales\n              </div>\n            )}\n            <div className=\"space-y-1\">\n              <button\n                onClick={() => navigateTo(\'DOCUMENTS\')}\n                className={`w-full flex items-center space-x-3 px-3 py-2 rounded-xl text-xs font-medium transition-all ${\n                  state.currentView === \'DOCUMENTS\'\n                    ? \'bg-blue-600 text-white shadow-md font-semibold\'\n                    : \'text-slate-300 hover:bg-slate-800 hover:text-white\'\n                }`}\n                title=\"B\303\263veda de Contratos Finales Guardados\"\n              >\n                <FileCheck2 className={`w-4 h-4 shrink-0 ${state.currentView === \'DOCUMENTS\' ? \'text-white\' : \'text-amber-400\'}`} />\n                {!isCollapsed && (\n                  <div className=\"flex items-center justify-between flex-1 truncate\">\n                    <span className=\"truncate\">B\303\263veda de Contratos</span>\n                    <span\n                      className={`text-[10px] px-1.5 py-0.5 rounded-full font-mono font-bold ${\n                        state.currentView === \'DOCUMENTS\'\n                          ? \'bg-white/20 text-white\'\n                          : \'bg-slate-800 text-amber-300 border border-amber-500/30\'\n                      }`}\n                    >\n                      {finalDocsCount}\n                    </span>\n                  </div>\n                )}\n              </button>\n\n              <button\n                onClick={() => {\n                  if (activeTemplate) {\n                    navigateTo(\'FORM_GEN\');\n                  } else {\n                    navigateTo(\'TEMPLATES\');\n                  }\n                }}\n                className={`w-full flex items-center space-x-3 px-3 py-2 rounded-xl text-xs font-medium transition-all ${\n                  state.currentView === \'FORM_GEN\'\n                    ? \'bg-blue-600 text-white shadow-md font-semibold\'\n                    : \'text-slate-300 hover:bg-slate-800 hover:text-white\'\n                }`}\n                title=\"Generar Nuevo Contrato Final\"\n              >\n                <Sparkles className={`w-4 h-4 shrink-0 ${state.currentView === \'FORM_GEN\' ? \'text-white\' : \'text-blue-400\'}`} />\n                {!isCollapsed && <span className=\"truncate\">Generador de Contratos</span>}\n              </button>\n            </div>\n          </div>\n\n          {/* SECTION 2: GESTI\303\223N DE PLANTILLAS */}\n          <div>\n            {!isCollapsed && (\n              <div className=\"px-3 pb-1.5 text-[10px] font-bold uppercase tracking-wider text-slate-400\">\n                Gesti\303\263n de Plantillas\n              </div>\n            )}\n            <div className=\"space-y-1\">\n              <button\n                onClick={() => navigateTo(\'TEMPLATES\')}\n                className={`w-full flex items-center space-x-3 px-3 py-2 rounded-xl text-xs font-medium transition-all ${\n                  state.currentView === \'TEMPLATES\'\n                    ? \'bg-blue-600 text-white shadow-md font-semibold\'\n                    : \'text-slate-300 hover:bg-slate-800 hover:text-white\'\n                }`}\n                title=\"Cat\303\241logo de Plantillas\"\n              >\n                <Files className=\"w-4 h-4 shrink-0 text-indigo-400\" />\n                {!isCollapsed && (\n                  <div className=\"flex items-center justify-between flex-1 truncate\">\n                    <span className=\"truncate\">Cat\303\241logo Plantillas</span>\n                    <span\n                      className={`text-[10px] px-1.5 py-0.5 rounded-full font-mono ${\n                        state.currentView === \'TEMPLATES\'\n                          ? \'bg-white/20 text-white\'\n                          : \'bg-slate-800 text-slate-400\'\n                      }`}\n                    >\n                      {templatesCount}\n                    </span>\n                  </div>\n                )}\n              </button>\n\n              <button\n                onClick={() => navigateTo(\'EDITOR\')}\n                className={`w-full flex items-center space-x-3 px-3 py-2 rounded-xl text-xs font-medium transition-all ${\n                  state.currentView === \'EDITOR\'\n                    ? \'bg-blue-600 text-white shadow-md font-semibold\'\n                    : \'text-slate-300 hover:bg-slate-800 hover:text-white\'\n                }`}\n                title=\"Editor Notarial de Plantilla\"\n              >\n                <PenTool className=\"w-4 h-4 shrink-0 text-emerald-400\" />\n                {!isCollapsed && <span className=\"truncate\">Editor Notarial Ribbon</span>}\n              </button>\n\n              <button\n                onClick={() => navigateTo(\'VARIABLES\')}\n                className={`w-full flex items-center space-x-3 px-3 py-2 rounded-xl text-xs font-medium transition-all ${\n                  state.currentView === \'VARIABLES\'\n                    ? \'bg-blue-600 text-white shadow-md font-semibold\'\n                    : \'text-slate-300 hover:bg-slate-800 hover:text-white\'\n                }`}\n                title=\"Variables y Campos\"\n              >\n                <Sliders className=\"w-4 h-4 shrink-0 text-cyan-400\" />\n                {!isCollapsed && (\n                  <div className=\"flex items-center justify-between flex-1 truncate\">\n                    <span className=\"truncate\">Variables & Campos</span>\n                    {activeTemplate && (\n                      <span className=\"text-[10px] text-slate-400 font-mono\">\n                        {activeTemplate.variables.length}\n                      </span>\n                    )}\n                  </div>\n                )}\n              </button>\n\n              <button\n                onClick={() => navigateTo(\'CLAUSES\')}\n                className={`w-full flex items-center space-x-3 px-3 py-2 rounded-xl text-xs font-medium transition-all ${\n                  state.currentView === \'CLAUSES\'\n                    ? \'bg-blue-600 text-white shadow-md font-semibold\'\n                    : \'text-slate-300 hover:bg-slate-800 hover:text-white\'\n                }`}\n                title=\"Biblioteca de Cl\303\241usulas Dominicanas\"\n              >\n                <BookOpen className=\"w-4 h-4 shrink-0 text-purple-400\" />\n                {!isCollapsed && <span className=\"truncate\">Biblioteca Cl\303\241usulas</span>}\n              </button>\n\n              <button\n                onClick={() => navigateTo(\'RULES\')}\n                className={`w-full flex items-center space-x-3 px-3 py-2 rounded-xl text-xs font-medium transition-all ${\n                  state.currentView === \'RULES\'\n                    ? \'bg-blue-600 text-white shadow-md font-semibold\'\n                    : \'text-slate-300 hover:bg-slate-800 hover:text-white\'\n                }`}\n                title=\"Reglas Condicionales\"\n              >\n                <GitFork className=\"w-4 h-4 shrink-0 text-rose-400\" />\n                {!isCollapsed && <span className=\"truncate\">Reglas Condicionales</span>}\n              </button>\n\n              {pendingHitlCount > 0 && (\n                <button\n                  onClick={() => navigateTo(\'HITL_REVIEW\')}\n                  className={`w-full flex items-center space-x-3 px-3 py-2 rounded-xl text-xs font-medium transition-all bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30`}\n                  title=\"Revisi\303\263n Human-In-The-Loop\"\n                >\n                  <Activity className=\"w-4 h-4 shrink-0 text-amber-400 animate-pulse\" />\n                  {!isCollapsed && (\n                    <div className=\"flex items-center justify-between flex-1 truncate\">\n                      <span className=\"truncate\">Revisi\303\263n Tokens HITL</span>\n                      <span className=\"bg-amber-500 text-slate-950 text-[10px] px-1.5 py-0.2 rounded-full font-bold\">\n                        {pendingHitlCount}\n                      </span>\n                    </div>\n                  )}\n                </button>\n              )}\n            </div>\n          </div>\n\n          {/* SECTION 3: HERRAMIENTAS NOTARIALES */}\n          <div>\n            {!isCollapsed && (\n              <div className=\"px-3 pb-1.5 text-[10px] font-bold uppercase tracking-wider text-slate-400\">\n                Herramientas Notariales\n              </div>\n            )}\n            <div className=\"space-y-1\">\n              <button\n                onClick={onOpenHealthModal}\n                className=\"w-full flex items-center space-x-3 px-3 py-2 rounded-xl text-xs font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors\"\n                title=\"Diagn\303\263stico de Salud de Plantilla\"\n              >\n                <ShieldCheck className=\"w-4 h-4 shrink-0 text-teal-400\" />\n                {!isCollapsed && <span className=\"truncate\">Diagn\303\263stico Legal</span>}\n              </button>\n\n              <button\n                onClick={onOpenAuditModal}\n                className=\"w-full flex items-center space-x-3 px-3 py-2 rounded-xl text-xs font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors\"\n                title=\"Pistas de Auditor\303\255a Inmutable\"\n              >\n                <History className=\"w-4 h-4 shrink-0 text-sky-400\" />\n                {!isCollapsed && <span className=\"truncate\">Pistas de Auditor\303\255a</span>}\n              </button>\n\n              <button\n                onClick={onOpenDocxImportModal}\n                className=\"w-full flex items-center space-x-3 px-3 py-2 rounded-xl text-xs font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors\"\n                title=\"Importar Documento Word DOCX\"\n              >\n                <Upload className=\"w-4 h-4 shrink-0 text-blue-400\" />\n                {!isCollapsed && <span className=\"truncate\">Importar DOCX</span>}\n              </button>\n\n              <button\n                onClick={onOpenSchemaModal}\n                className=\"w-full flex items-center space-x-3 px-3 py-2 rounded-xl text-xs font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors\"\n                title=\"Ver Esquema JSON (schema.json)\"\n              >\n                <Code2 className=\"w-4 h-4 shrink-0 text-violet-400\" />\n                {!isCollapsed && <span className=\"truncate\">Esquema JSON</span>}\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* Active Template Context Card (if selected and expanded) */}\n        {!isCollapsed && activeTemplate && (\n          <div className=\"p-3 mx-3 mb-2 bg-slate-800/80 rounded-xl border border-slate-700/70 text-xs\">\n            <div className=\"flex items-center justify-between text-[10px] text-slate-400 mb-1\">\n              <span className=\"font-semibold uppercase tracking-wider text-blue-400\">Plantilla Activa</span>\n              <span className=\"bg-emerald-500/20 text-emerald-300 px-1.5 py-0.2 rounded font-mono font-medium\">\n                {activeTemplate.status}\n              </span>\n            </div>\n            <h4 className=\"font-semibold text-slate-200 line-clamp-1 text-xs\">\n              {activeTemplate.name}\n            </h4>\n            <div className=\"flex items-center justify-between mt-2 pt-2 border-t border-slate-700/50 text-[11px]\">\n              <button\n                onClick={() => navigateTo(\'EDITOR\')}\n                className=\"text-blue-400 hover:text-blue-300 font-medium\"\n              >\n                Editar\n              </button>\n              <button\n                onClick={() => navigateTo(\'FORM_GEN\')}\n                className=\"text-amber-400 hover:text-amber-300 font-medium\"\n              >\n                Generar Acto \342\206\222\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* Footer User Profile & Notary Card */}\n        <div className=\"p-3 border-t border-slate-800 bg-slate-950/40\">\n          <button\n            onClick={onOpenProfileModal}\n            className=\"w-full flex items-center space-x-3 p-2 rounded-xl hover:bg-slate-800/80 transition-colors text-left group\"\n            title=\"Ver / Editar Perfil y Matr\303\255cula Notarial\"\n          >\n            <div className=\"w-8 h-8 rounded-lg bg-gradient-to-br from-blue-600 to-indigo-700 flex items-center justify-center text-white font-bold text-xs shrink-0 shadow-xs group-hover:ring-2 group-hover:ring-blue-400\">\n              {currentUser.name\n                .split(\' \')\n                .map((n) => n[0])\n                .slice(0, 2)\n                .join(\'\')}\n            </div>\n\n            {!isCollapsed && (\n              <div className=\"flex-1 min-w-0\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-xs font-semibold text-white truncate block\">\n                    {currentUser.name}\n                  </span>\n                </div>\n                <div className=\"text-[10px] text-slate-400 truncate flex items-center space-x-1\">\n                  <span className=\"text-emerald-400 font-mono\">CARD: {currentUser.cardRegistration}</span>\n                </div>\n              </div>\n            )}\n          </button>\n        </div>\n      </aside>\n    </>\n  );\n};\n"
    }
