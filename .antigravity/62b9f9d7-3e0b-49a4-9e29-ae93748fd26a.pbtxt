=== \'ERROR\' && <XCircle className=\\\"w-3.5 h-3.5 text-rose-400\\\" />}\\n                <span>Salud: {health.score}%</span>\\n              </button>\\n            )}\\n\\n            {activeTemplate && (\\n              <button\\n                onClick={onOpenSchemaModal}\\n                className=\\\"p-1.5 text-slate-400 hover:text-slate-200 hover:bg-slate-800 rounded-md transition-colors\\\"\\n                title=\\\"Ver Contrato schema.json\\\"\\n              >\\n                <Code2 className=\\\"w-4 h-4\\\" />\\n              </button>\\n            )}\\n\\n            <button\\n              onClick={onOpenDocxImportModal}\\n              className=\\\"hidden sm:flex items-center space-x-1.5 px-3 py-1.5 rounded-md text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-colors\\\"\\n            >\\n              <Upload className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Importar DOCX</span>\\n            </button>\\n\\n            <button\\n              onClick={onOpenNewTemplateModal}\\n              className=\\\"flex items-center space-x-1 px-3 py-1.5 rounded-md text-xs font-medium bg-blue-600 hover:bg-blue-500 text-white shadow-sm transition-colors\\\"\\n            >\\n              <Plus className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Nueva Plantilla</span>\\n            </button>\\n          </div>\\n        </div>\\n      </div>\\n    </header>\\n  );\\n};\", \"TargetFile\":\"/src/components/Navbar.tsx\", \"toolAction\":\"Editing file\", \"toolSummary\":\"Update Navbar with lawyer badge and profile trigger\"}"
