        lines {
          text: "export function montoALetras("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  monto: number | string,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
