      name: "edit_file"
      arguments_json: "{\"Instruction\":\"Add currentUser to AppState and lawyer role switching in useAppStore.ts\", \"ReplacementContent\":\"import { useState, useEffect } from \'react\';\\nimport {\\n  LegalTemplate,\\n  TemplateStatus,\\n  TemplateVariable,\\n  LegalClause,\\n  ConditionalRule,\\n  AuditLogEntry,\\n  GeneratedDocument,\\n  DetectedToken,\\n  TemplateCategory,\\n  UserProfile,\\n  UserRole,\\n} from \'../types\';\\nimport { INITIAL_TEMPLATES } from \'../core/sampleData\';\\nimport { DEFAULT_DOMINICAN_CLAUSES } from \'../core/clauseEngine\';\\nimport { normalizeVariableTag } from \'../core/variableEngine\';\\nimport { runTemplateHealthCheck } from \'../core/healthCheck\';\\nimport { LAWYER_DEFAULT_PROFILE, AVAILABLE_PROFILES, ROLE_PERMISSIONS } from \'../core/userProfiles\';\\n\\nconst STORAGE_KEY = \'save_legal_platform_v2_state\';\\n\\ninterface AppState {\\n  currentUser: UserProfile;\\n  templates: LegalTemplate[];\\n  activeTemplateId: string | null;\\n  currentView:\\n    | \'TEMPLATES\'\\n    | \'EDITOR\'\\n    | \'VARIABLES\'\\n    | \'CLAUSES\'\\n    | \'RULES\'\\n    | \'HITL_REVIEW\'\\n    | \'FORM_GEN\'\\n    | \'DOCUMENTS\'\\n    | \'AUDIT\'\\n    | \'HEALTH_CHECK\';\\n  globalClauses: LegalClause[];\\n  auditLogs: AuditLogEntry[];\\n  generatedDocuments: GeneratedDocument[];\\n  hitlTokens: DetectedToken[];\\n  hitlOriginalText: string;\\n  hitlTemplateId: string | null;\\n  formValues: Record<string, any>;\\n  isAnalyzing: boolean;\\n}\\n\\nfunction loadInitialState(): AppState {\\n  try {\\n    const saved = localStorage.getItem(STORAGE_KEY);\\n    if (saved) {\\n      const parsed = JSON.parse(saved);\\n      return {\\n        ...parsed,\\n        currentUser: parsed.currentUser || LAWYER_DEFAULT_PROFILE,\\n        isAnalyzing: false,\\n      };\\n    }\\n  } catch (e) {\\n    console.error(\'Error loading state from localStorage:\', e);\\n  }\\n\\n  return {\\n    currentUser: LAWYER_DEFAULT_PROFILE,\\n    templates: INITIAL_TEMPLATES,\\n    activeTemplateId: INITIAL_TEMPLATES[0].id,\\n    currentView: \'TEMPLATES\',\\n    globalClauses: DEFAULT_DOMINICAN_CLAUSES,\\n    auditLogs: [\\n      {\\n        id: \'aud_init_1\',\\n        timestamp: \'2026-08-15T05:30:00Z\',\\n        user: `${LAWYER_DEFAULT_PROFILE.name} (${LAWYER_DEFAULT_PROFILE.cardRegistration})`,\\n        action: \'CREATE_TEMPLATE\',\\n        targetType: \'TEMPLATE\',\\n        targetId: \'tpl_alquiler_residencial_rd\',\\n        details: \'Plantilla de Alquiler Residencial inicializada con validadores dominicanos\',\\n      },\\n    ],\\n    generatedDocuments: [],\\n    hitlTokens: [],\\n    hitlOriginalText: \'\',\\n    hitlTemplateId: null,\\n    formValues: {},\\n    isAnalyzing: false,\\n  };\\n}\", \"TargetContent\":\"import { useState, useEffect } from \'react\';\\nimport {\\n  LegalTemplate,\\n  TemplateStatus,\\n  TemplateVariable,\\n  LegalClause,\\n  ConditionalRule,\\n  AuditLogEntry,\\n  GeneratedDocument,\\n  DetectedToken,\\n  TemplateCategory,\\n} from \'../types\';\\nimport { INITIAL_TEMPLATES } from \'../core/sampleData\';\\nimport { DEFAULT_DOMINICAN_CLAUSES } from \'../core/clauseEngine\';\\nimport { normalizeVariableTag } from \'../core/variableEngine\';\\nimport { runTemplateHealthCheck } from \'../core/healthCheck\';\\n\\nconst STORAGE_KEY = \'save_legal_platform_v2_state\';\\n\\ninterface AppState {\\n  templates: LegalTemplate[];\\n  activeTemplateId: string | null;\\n  currentView:\\n    | \'TEMPLATES\'\\n    | \'EDITOR\'\\n    | \'VARIABLES\'\\n    | \'CLAUSES\'\\n    | \'RULES\'\\n    | \'HITL_REVIEW\'\\n    | \'FORM_GEN\'\\n    | \'DOCUMENTS\'\\n    | \'AUDIT\'\\n    | \'HEALTH_CHECK\';\\n  globalClauses: LegalClause[];\\n  auditLogs: AuditLogEntry[];\\n  generatedDocuments: GeneratedDocument[];\\n  hitlTokens: DetectedToken[];\\n  hitlOriginalText: string;\\n  hitlTemplateId: string | null;\\n  formValues: Record<string, any>;\\n  isAnalyzing: boolean;\\n}\\n\\nfunction loadInitialState(): App