    <p className=\"text-[11px] text-slate-500 truncate hidden md:block\">\n                  {currentViewInfo.subtitle}\n                </p>\n              </div>\n            </div>\n          </div>\n\n          {/* Top Right Quick Actions */}\n          <div className=\"flex items-center space-x-2.5 shrink-0\">\n            {/* Direct Shortcut to Final Contracts Vault */}\n            <button\n              onClick={() => setView(\'DOCUMENTS\')}\n              className={`flex items-center space-x-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold transition-all ${\n                state.currentView === \'DOCUMENTS\'\n                  ? \'bg-amber-500 text-slate-950 font-bold shadow-xs\'\n                  : \'bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200/80\'\n              }`}\n              title=\"Ver B\303\263veda de Contratos Finales\"\n            >\n              <FileCheck2 className=\"w-4 h-4 text-amber-700\" />\n              <span className=\"hidden sm:inline\">Contratos Finales</span>\n              <span className=\"bg-amber-200/70 text-amber-900 text-[10px] px-1.5 py-0.2 rounded-full font-mono font-bold\">\n                {state.generatedDocuments.length}\n              </span>\n            </button>\n\n            {/* Active Template Badge (if any) */}\n            {activeTemplate && state.currentView !== \'DOCUMENTS\' && (\n              <button\n                onClick={() => setView(\'EDITOR\')}\n                className=\"hidden lg:flex items-center space-x-1.5 px-2.5 py-1 bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-xl text-xs font-medium text-blue-900 transition-colors\"\n                title={`Plantilla activa: ${activeTemplate.name}`}\n              >\n                <span className=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\" />\n                <span className=\"truncate max-w-[150px] font-semibold\">{activeTemplate.name}</span>\n              </button>\n            )}\n\n            {/* User Profile Quick Trigger */}\n            <button\n              onClick={() => setIsProfileOpen(true)}\n              className=\"flex items-center space-x-2 p-1 sm:px-2.5 sm:py-1 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors text-xs font-medium border border-slate-200\"\n              title=\"Gestionar perfil de Notario / Abogado\"\n            >\n              <div className=\"w-6 h-6 rounded-md bg-blue-600 flex items-center justify-center text-white text-[11px] font-bold\">\n                {currentUser.name\n                  .split(\' \')\n                  .map((n) => n[0])\n                  .slice(0, 2)\n                  .join(\'\')}\n              </div>\n              <span className=\"hidden md:inline font-semibold text-slate-800\">{currentUser.name}</span>\n            </button>\n          </div>\n        </header>"
