  file_change {
    absolute_path_uri: "file:///src/components/ribbon/NavigationPane.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useMemo } from \'react\';\nimport { BookOpen, Layers, Search, FileText, ChevronRight, X } from \'lucide-react\';\n\ninterface NavigationPaneProps {\n  content: string;\n  pages: string[];\n  onSelectClause: (clauseTitle: string) => void;\n  onSelectPage: (pageIndex: number) => void;\n  onClose: () => void;\n}\n\nexport const NavigationPane: React.FC<NavigationPaneProps> = ({\n  content,\n  pages,\n  onSelectClause,\n  onSelectPage,\n  onClose,\n}) => {\n  const [activeTab, setActiveTab] = useState<\'HEADINGS\' | \'PAGES\' | \'SEARCH\'>(\'HEADINGS\');\n  const [searchQuery, setSearchQuery] = useState(\'\');\n\n  // Extract legal clauses and headings (e.g. PRIMERO, SEGUNDO, CL\303\201USULA, ACTO N\303\232MERO)\n  const headings = useMemo(() => {\n    const lines = content.split(\'\\n\');\n    const detected: { line: string; index: number; type: string }[] = [];\n\n    lines.forEach((line, idx) => {\n      const trimmed = line.trim();\n      if (!trimmed) return;\n\n      if (\n        /^(PRIMERO|SEGUNDO|TERCERO|CUARTO|QUINTO|SEXTO|S\303\211PTIMO|OCTAVO|NOVENO|D\303\211CIMO|D\303\211CIMO PRIMERO|D\303\211CIMO SEGUNDO)/i.test(\n          trimmed\n        ) ||\n        /^(CL\303\201USULA|ART\303\215CULO|PAR\303\201GRAFO|ACTO|CAP\303\215TULO)/i.test(trimmed) ||\n        trimmed.startsWith(\'###\') ||\n        trimmed.startsWith(\'##\')\n      ) {\n        detected.push({\n          line: trimmed.replace(/^#+\\s*/, \'\'),\n          index: idx,\n          type: trimmed.startsWith(\'PRIMERO\') || trimmed.startsWith(\'SEGUNDO\') ? \'CL\303\201USULA\' : \'T\303\215TULO\',\n        });\n      }\n    });\n\n    return detected;\n  }, [content]);\n\n  return (\n    <div className=\"w-64 sm:w-72 bg-white border-r border-slate-300 flex flex-col h-full shrink-0 shadow-md z-20\">\n      {/* Pane Header */}\n      <div className=\"p-3 border-b border-slate-200 flex items-center justify-between bg-slate-50\">\n        <div className=\"flex items-center space-x-1.5 text-xs font-bold text-slate-800\">\n          <BookOpen className=\"w-3.5 h-3.5 text-blue-600\" />\n          <span>Panel de Navegaci\303\263n</span>\n        </div>\n        <button\n          onClick={onClose}\n          className=\"p-1 hover:bg-slate-200 rounded text-slate-400 hover:text-slate-700\"\n          title=\"Cerrar panel\"\n        >\n          <X className=\"w-3.5 h-3.5\" />\n        </button>\n      </div>\n\n      {/* Tabs */}\n      <div className=\"flex border-b border-slate-200 bg-slate-100/70 p-1 text-[11px] font-semibold\">\n        <button\n          onClick={() => setActiveTab(\'HEADINGS\')}\n          className={`flex-1 py-1 text-center rounded transition-all ${\n            activeTab === \'HEADINGS\' ? \'bg-white text-blue-600 shadow-xs\' : \'text-slate-600 hover:text-slate-900\'\n          }`}\n        >\n          Cl\303\241usulas ({headings.length})\n        </button>\n        <button\n          onClick={() => setActiveTab(\'PAGES\')}\n          className={`flex-1 py-1 text-center rounded transition-all ${\n            activeTab === \'PAGES\' ? \'bg-white text-blue-600 shadow-xs\' : \'text-slate-600 hover:text-slate-900\'\n          }`}\n        >\n          P\303\241ginas ({pages.length})\n        </button>\n      </div>\n\n      {/* Pane Content */}\n      <div className=\"flex-1 overflow-y-auto overflow-x-hidden p-2 space-y-1\">\n        {activeTab === \'HEADINGS\' && (\n          <div className=\"space-y-1\">\n            {headings.length === 0 ? (\n              <p className=\"text-xs text-slate-400 p-3 italic\">No se detectaron cl\303\241usulas o t\303\255tulos solemnes.</p>\n            ) : (\n              headings.map((h, i) => (\n                <button\n                  key={i}\n                  onClick={() => onSelectClause(h.line)}\n                  className=\"w-full text-left p-2 rounded-lg hover:bg-blue-50 text-xs transition-colors border border-transparent hover:border-blue-200 group flex items-start space-x-1.5\"\n                >\n                  <ChevronRight className=\"w-3.5 h-3.5 text-slate-400 group-hover:text-blue-600 shrink-0 mt-0.5\" />\n                  <div className=\"min-w-0\">\n                    <span className=\"font-semibold text-slate-800 block truncate group-hover:text-blue-700\">\n                      {h.line}\n                    </span>\n                    <span className=\"text-[10px] text-slate-400 uppercase font-mono\">{h.type}</span>\n                  </div>\n                </button>\n              ))\n            )}\n          </div>\n        )}\n\n        {activeTab === \'PAGES\' && (\n          <div className=\"grid grid-cols-2 gap-2 p-1\">\n            {pages.map((p, idx) => (\n              <button\n                key={idx}\n                onClick={() => onSelectPage(idx)}\n                className=\"flex flex-col items-center p-2 bg-slate-50 hover:bg-blue-50 border border-slate-200 hover:border-blue-300 rounded-lg text-center transition-all group\"\n              >\n                {/* Mini paper representation */}\n                <div className=\"w-16 h-20 bg-white border border-slate-300 rounded shadow-xs p-1 flex flex-col justify-between overflow-hidden text-[5px] text-slate-300 select-none\">\n                  <div className=\"space-y-0.5\">\n                    <div className=\"h-1 bg-slate-300 rounded-xs w-3/4\" />\n                    <div className=\"h-0.5 bg-slate-200 rounded-xs w-full\" />\n                    <div className=\"h-0.5 bg-slate-200 rounded-xs w-5/6\" />\n                    <div className=\"h-0.5 bg-slate-200 rounded-xs w-4/6\" />\n                  </div>\n                  <div className=\"h-0.5 bg-slate-300 rounded-xs w-1/2 self-center\" />\n                </div>\n                <span className=\"text-[10px] font-semibold text-slate-600 group-hover:text-blue-700 mt-1.5\">\n                  P\303\241gina {idx + 1}\n                </span>\n              </button>\n            ))}\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }
