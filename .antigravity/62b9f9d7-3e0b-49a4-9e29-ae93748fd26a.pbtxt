    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  X,\n  Scale,\n  ShieldCheck,\n  CheckCircle2,\n  XCircle,\n  Building,\n  MapPin,\n  Mail,\n  Award,\n  BookOpen,\n  UserCheck,\n  FileCheck2,\n  FileText,\n  History,\n  Lock,\n  Sparkles,\n  Edit3,\n  Save,\n} from \'lucide-react\';\nimport { useAppStore } from \'../store/useAppStore\';\nimport { UserRole } from \'../types\';\n\ninterface UserProfileModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const UserProfileModal: React.FC<UserProfileModalProps> = ({ isOpen, onClose }) => {\n  const { currentUser, permissions, switchUserRole, updateUserProfile, state } = useAppStore();\n  const [isEditing, setIsEditing] = useState(false);\n  const [formData, setFormData] = useState({\n    name: currentUser.name,\n    email: currentUser.email,\n    roleTitle: currentUser.roleTitle,\n    cardRegistration: currentUser.cardRegistration,\n    notaryRegistration: currentUser.notaryRegistration || \'\',\n    lawFirm: currentUser.lawFirm,\n    jurisdiction: currentUser.jurisdiction,\n  });\n\n  if (!isOpen) return null;\n\n  const handleSave = (e: React.FormEvent) => {\n    e.preventDefault();\n    updateUserProfile({\n      name: formData.name,\n      email: formData.email,\n      roleTitle: formData.roleTitle,\n      cardRegistration: formData.cardRegistration,\n      notaryRegistration: formData.notaryRegistration,\n      lawFirm: formData.lawFirm,\n      jurisdiction: formData.jurisdiction,\n    });\n    setIsEditing(false);\n  };\n\n  const handleRoleChange = (role: UserRole) => {\n    switchUserRole(role);\n    setFormData((prev) => ({\n      ...prev,\n      roleTitle: role === \'ABOGADO\'\n        ? \'Abogada en Ejercicio \342\200\242 Especialista en Derecho Notarial e Inmobiliario\'\n        : role === \'NOTARIO\'\n        ? \'Notario P\303\272blico del Distrito Nacional\'\n        : role === \'ASISTENTE_LEGAL\'\n        ? \'Paralegal / Asistente de Redacci\303\263n Contractual\'\n        : \'Administrador del Sistema Legal\',\n    }));\n  };\n\n  const permissionItems = [\n    {\n      key: \'canEditTemplates\',\n      label: \'Creaci\303\263n y Edici\303\263n de Plantillas Legales\',\n      desc: \'Capacidad para redactar, modificar y estructurar contenido de contratos\',\n      allowed: permissions.canEditTemplates,\n    },\n    {\n      key: \'canPublishTemplates\',\n      label: \'Publicaci\303\263n Oficial de Plantillas\',\n      desc: \'Habilitar plantillas para producci\303\263n tras superar el Health Check\',\n      allowed: permissions.canPublishTemplates,\n    },\n    {\n      key: \'canManageClauses\',\n      label: \'Biblioteca de Cl\303\241usulas Notariales Protegidas\',\n      desc: \'Insertar, modificar y parametrizar cl\303\241usulas jur\303\255dicas est\303\241ndar de RD\',\n      allowed: permissions.canManageClauses,\n    },\n    {\n      key: \'canManageVariables\',\n      label: \'Diccionario de Variables & Validadores JCE / DGII\',\n      desc: \'Gestionar tipos de datos, validaci\303\263n C\303\251dula Mod 10, RNC y montos en letras\',\n      allowed: permissions.canManageVariables,\n    },\n    {\n      key: \'canManageRules\',\n      label: \'Motor de Reglas Condicionales y Dependencias\',\n      desc: \'Configurar condiciones de cl\303\241usulas y validaci\303\263n de grafos ac\303\255clicos\',\n      allowed: permissions.canManageRules,\n    },\n    {\n      key: \'canPerformHITL\',\n      label: \'Revisi\303\263n Human-in-the-Loop (HITL)\',\n      desc: \'Aprobar, rechazar, corregir y fusionar tokens detectados de contratos importados\',\n      allowed: permissions.canPerformHITL,\n    },\n    {\n      key: \'canGenerateDocuments\',\n      label: \'Generaci\303\263n y Emisi\303\263n de Contratos (DOCX / PDF)\',\n      desc: \'Llenar formularios notariales y emitir documentos listos para firma\',\n      allowed: permissions.canGenerateDocuments,\n    },\n    {\n      key: \'canRunHealthCheck\',\n      label: \'Diagn\303\263stico Estructural & Health Check\',\n      desc: \'Auditar variables hu\303\251rfanas, referencias rotas y consistencia jur\303\255dica\',\n      allowed: permissions.canRunHealthCheck,\n    },\n    {\n      key: \'canAccessAuditLogs\',\n      label: \'Pista de Auditor\303\255a Legal e Inmutable\',\n      desc: \'Visualizar registros cronol\303\263gicos de cambios en plantillas y variables\',\n      allowed: permissions.canAccessAuditLogs,\n    },\n    {\n      key: \'canManageVersions\',\n      label: \'Control de Versiones y Restauraci\303\263n\',\n      desc: \'Crear snapshots de versi\303\263n (v1.0, v1.1) y revertir estados anteriores\',\n      allowed: permissions.canManageVersions,\n    },\n  ];\n\n  return (\n    <div className=\"fixed inset-0 z-50 overflow-y-auto bg-slate-950/70 backdrop-blur-sm flex items-center justify-center p-4\">\n      <div className=\"bg-white rounded-2xl max-w-3xl w-full shadow-2xl border border-slate-200 overflow-hidden animate-in fade-in zoom-in-95 duration-150 max-h-[92vh] flex flex-col\">\n        {/* Modal Header */}\n        <div className=\"bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 px-6 py-5 text-white flex items-center justify-between border-b border-slate-800\">\n          <div className=\"flex items-center space-x-3\">\n            <div className=\"w-12 h-12 rounded-xl bg-gradient-to-br from-amber-500 to-amber-700 flex items-center justify-center shadow-inner border border-amber-400/30\">\n              <Scale className=\"w-6 h-6 text-white\" />\n            </div>\n            <div>\n              <div className=\"flex items-center space-x-2\">\n                <h2 className=\"text-xl font-bold font-serif\">{currentUser.name}</h2>\n                <span className=\"px-2 py-0.5 rounded-full text-xs font-bold bg-amber-500/20 text-amber-300 border border-amber-400/30 uppercase tracking-wider\">\n                  \342\232\226\357\270\217 {currentUser.role}\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-300 mt-0.5\">{currentUser.roleTitle}</p>\n            </div>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Modal Body */}\n        <div className=\"p-6 overflow-y-auto space-y-6 flex-1 text-slate-800 text-sm\">\n          {/* Quick Lawyer Credentials Bar */}\n          <div className=\"bg-gradient-to-br from-slate-50 to-indigo-50/40 rounded-xl p-4 border border-slate-200 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs\">\n            <div className=\"flex items-start space-x-2.5\">\n              <Award className=\"w-4 h-4 text-amber-600 shrink-0 mt-0.5\" />\n              <div>\n                <span className=\"text-slate-500 block text-[10px] uppercase font-bold tracking-wider\">Colegiatura Oficial</span>\n                <span className=\"font-semibold text-slate-800\">{currentUser.cardRegistration}</span>\n                <span className=\"block text-[10px] text-slate-500\">Colegio de Abogados (CARD)</span>\n              </div>\n            </div>\n\n            <div className=\"flex items-start space-x-2.5\">\n              <Building className=\"w-4 h-4 text-blue-600 shrink-0 mt-0.5\" />\n              <div>\n                <span className=\"text-slate-500 block text-[10px] uppercase font-bold tracking-wider\">Firma Jur\303\255dica</span>\n                <span className=\"font-semibold text-slate-800\">{currentUser.lawFirm}</span>\n                <span className=\"block text-[10px] text-slate-500\">Matr\303\255cula: {currentUser.notaryRegistration || \'No aplica\'}</span>\n              </div>\n            </div>\n\n            <div className=\"flex items-start space-x-2.5\">\n              <MapPin className=\"w-4 h-4 text-emerald-600 shrink-0 mt-0.5\" />\n              <div>\n                <span className=\"text-slate-500 block text-[10px] uppercase font-bold tracking-wider\">Jurisdicci\303\263n Legal</span>\n                <span className=\"font-semibold text-slate-800\">{currentUser.jurisdiction}</span>\n                <span className=\"block text-[10px] text-slate-500\">Rep\303\272blica Dominicana \360\237\207\251\360\237\207\264</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Role Selector & State */}\n          <div className=\"border border-slate-200 rounded-xl p-4 space-y-3 bg-white\">\n            <div className=\"flex items-center justify-between\">\n              <div>\n                <h3 className=\"font-bold text-slate-900 text-sm flex items-center space-x-2\">\n                  <UserCheck className=\"w-4 h-4 text-blue-600\" />\n                  <span>Perfil y Rol del Operador Jur\303\255dico</span>\n                </h3>\n                <p className=\"text-xs text-slate-500\">Selecciona tu perfil activo para verificar los permisos de la plataforma</p>\n              </div>\n\n              {!isEditing && (\n                <button\n                  onClick={() => setIsEditing(true)}\n                  className=\"px-3 py-1 text-xs font-semibold text-blue-600 bg-blue-50 hover:bg-blue-100 rounded-lg flex items-center space-x-1 transition-colors\"\n                >\n                  <Edit3 className=\"w-3.5 h-3.5\" />\n                  <span>Editar Credenciales</span>\n                </button>\n              )}\n            </div>\n\n            {/* Role Pills */}\n            <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2 pt-1\">\n              {([\'ABOGADO\', \'NOTARIO\', \'ASISTENTE_LEGAL\', \'ADMIN\'] as UserRole[]).map((r) => {\n                const isCurrent = currentUser.role === r;\n                return (\n                  <button\n                    key={r}\n                    onClick={() => handleRoleChange(r)}\n                    className={`px-3 py-2.5 rounded-xl text-left border transition-all text-xs flex flex-col justify-between ${\n                      isCurrent\n                        ? \'border-blue-600 bg-blue-50/70 text-blue-900 ring-2 ring-blue-500/20 font-semibold\'\n                        : \'border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700\'\n                    }`}\n                  >\n                    <div className=\"flex items-center justify-between\">\n                      <span className=\"font-bold\">\n                        {r === \'ABOGADO\' && \'\342\232\226\357\270\217 Abogado\'}\n                        {r === \'NOTARIO\' && \'\360\237\223\234 Notario\'}\n                        {r === \'ASISTENTE_LEGAL\' && \'\360\237\223\235 Asistente\'}\n                        {r === \'ADMIN\' && \'\360\237\233\241\357\270\217 Admin\'}\n                      </span>\n                      {isCurrent && <CheckCircle2 className=\"w-3.5 h-3.5 text-blue-600\" />}\n                    </div>\n                    <span className=\"text-[10px] text-slate-500 mt-1\">\n                      {r === \'ABOGADO\' && \'Permisos Plenos\'}\n                      {r === \'NOTARIO\' && \'Firma y Protocolo\'}\n                      {r === \'ASISTENTE_LEGAL\' && \'Redacci\303\263n / Captura\'}\n                      {r === \'ADMIN\' && \'Control Total\'}\n                    </span>\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Edit Form if in editing mode */}\n          {isEditing && (\n            <form onSubmit={handleSave} className=\"bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-3\">\n              <h4 className=\"font-semibold text-xs text-slate-700 uppercase tracking-wider\">Actualizar Datos de Colegiatura</h4>\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs\">\n                <div>\n                  <label className=\"block text-slate-600 font-medium mb-1\">Nombre Completo del Abogado(a):</label>\n                  <input\n                    type=\"text\"\n                    value={formData.name}\n                    onChange={(e) => setFormData({ ...formData, name: e.target.value })}\n                    className=\"w-full px-3 py-1.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                    required\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block text-slate-600 font-medium mb-1\">Correo Electr\303\263nico:</label>\n                  <input\n                    type=\"email\"\n                    value={formData.email}\n                    onChange={(e) => setFormData({ ...formData, email: e.target.value })}\n                    className=\"w-full px-3 py-1.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                    required\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block text-slate-600 font-medium mb-1\">No. Carnet CARD (Colegio de Abogados):</label>\n                  <input\n                    type=\"text\"\n                    value={formData.cardRegistration}\n                    onChange={(e) => setFormData({ ...formData, cardRegistration: e.target.value })}\n                    className=\"w-full px-3 py-1.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                    required\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block text-slate-600 font-medium mb-1\">Matr\303\255cula Notarial (Opcional):</label>\n                  <input\n                    type=\"text\"\n                    value={formData.notaryRegistration}\n                    onChange={(e) => setFormData({ ...formData, notaryRegistration: e.target.value })}\n                    className=\"w-full px-3 py-1.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block text-slate-600 font-medium mb-1\">Bufete / Despacho Jur\303\255dico:</label>\n                  <input\n                    type=\"text\"\n                    value={formData.lawFirm}\n                    onChange={(e) => setFormData({ ...formData, lawFirm: e.target.value })}\n                    className=\"w-full px-3 py-1.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block text-slate-600 font-medium mb-1\">Jurisdicci\303\263n Notarial / Territorial:</label>\n                  <input\n                    type=\"text\"\n                    value={formData.jurisdiction}\n                    onChange={(e) => setFormData({ ...formData, jurisdiction: e.target.value })}\n                    className=\"w-full px-3 py-1.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                  />\n                </div>\n              </div>\n\n              <div className=\"flex justify-end space-x-2 pt-2\">\n                <button\n                  type=\"button\"\n                  onClick={() => setIsEditing(false)}\n                  className=\"px-3 py-1.5 text-xs text-slate-600 hover:bg-slate-200 rounded-lg\"\n                >\n                  Cancelar\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"px-4 py-1.5 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-500 rounded-lg flex items-center space-x-1 shadow-sm\"\n                >\n                  <Save className=\"w-3.5 h-3.5\" />\n                  <span>Guardar Cambios</span>\n                </button>\n              </div>\n            </form>\n          )}\n\n          {/* Detailed Permissions Matrix */}\n          <div className=\"space-y-3\">\n            <div className=\"flex items-center justify-between\">\n              <h3 className=\"font-bold text-slate-900 text-sm flex items-center space-x-2\">\n                <ShieldCheck className=\"w-4 h-4 text-emerald-600\" />\n                <span>Matriz de Permisos y Atribuciones Notariales</span>\n              </h3>\n              <span className=\"text-xs text-slate-500\">\n                {Object.values(permissions).filter(Boolean).length} de {Object.keys(permissions).length} facultades habilitadas\n              </span>\n            </div>\n\n            <div className=\"bg-slate-50 rounded-xl border border-slate-200 divide-y divide-slate-200\">\n              {permissionItems.map((item) => (\n                <div key={item.key} className=\"p-3.5 flex items-start justify-between space-x-3 hover:bg-slate-100/60 transition-colors\">\n                  <div className=\"space-y-0.5\">\n                    <div className=\"font-semibold text-xs text-slate-900 flex items-center space-x-2\">\n                      <span>{item.label}</span>\n                    </div>\n                    <p className=\"text-[11px] text-slate-500\">{item.desc}</p>\n                  </div>\n\n                  <div>\n                    {item.allowed ? (\n                      <span className=\"inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-300\">\n                        <CheckCircle2 className=\"w-3 h-3 mr-1 text-emerald-600\" />\n                        Habilitado\n                      </span>\n                    ) : (\n                      <span className=\"inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-200 text-slate-600 border border-slate-300\">\n                        <Lock className=\"w-3 h-3 mr-1 text-slate-400\" />\n                        Restringido\n                      </span>\n                    )}\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"bg-slate-50 px-6 py-4 border-t border-slate-200 flex items-center justify-between\">\n          <div className=\"text-xs text-slate-500 flex items-center space-x-1.5\">\n            <Scale className=\"w-3.5 h-3.5 text-blue-600\" />\n            <span>Perfil Abogado Activo \342\200\242 Certificaci\303\263n Notarial Dominicana</span>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"px-4 py-2 rounded-lg text-xs font-semibold bg-slate-900 hover:bg-slate-800 text-white shadow-sm transition-colors\"\n          >\n            Aceptar y Continuar\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
