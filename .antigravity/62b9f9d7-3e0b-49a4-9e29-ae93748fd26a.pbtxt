          text: "____________________________________"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "CARLOS MANUEL MEDINA G\303\223MEZ"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Poderdante`,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
