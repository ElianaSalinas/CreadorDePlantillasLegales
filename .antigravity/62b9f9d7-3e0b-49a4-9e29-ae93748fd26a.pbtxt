        lines {
          text: "                        ? \'es igual a\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        : rule.operator === \'not_equals\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        ? \'no es igual a\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
