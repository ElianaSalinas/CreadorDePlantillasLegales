      original_chunk {
        target_content: "        {/* Footer User Profile & Notary Card */}\n        <div className=\"p-3 border-t border-slate-800 bg-slate-950/40\">\n          <button\n            onClick={onOpenProfileModal}\n            className=\"w-full flex items-center space-x-3 p-2 rounded-xl hover:bg-slate-800/80 transition-colors text-left group\"\n            title=\"Ver / Editar Perfil y Matr\303\255cula Notarial\"\n          >\n            <div className=\"w-8 h-8 rounded-lg bg-gradient-to-br from-blue-600 to-indigo-700 flex items-center justify-center text-white font-bold text-xs shrink-0 shadow-xs group-hover:ring-2 group-hover:ring-blue-400\">\n              {currentUser.name\n                .split(\' \')\n                .map((n) => n[0])\n                .slice(0, 2)\n                .join(\'\')}\n            </div>\n\n            {!isCollapsed && (\n              <div className=\"flex-1 min-w-0\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-xs font-semibold text-white truncate block\">\n                    {currentUser.name}\n                  </span>\n                </div>\n                <div className=\"text-[10px] text-slate-400 truncate flex items-center space-x-1\">\n                  <span className=\"text-emerald-400 font-mono\">CARD: {currentUser.cardRegistration}</span>\n                </div>\n              </div>\n            )}\n          </button>\n        </div>"
        replacement_content: "        {/* Footer User Profile & Notary Card */}\n        <div className=\"p-3 border-t border-slate-800 bg-slate-950/40 space-y-2\">\n          {/* Theme Mode Toggle Button */}\n          <button\n            onClick={toggleDarkMode}\n            className=\"w-full flex items-center space-x-3 p-2 rounded-xl text-xs font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors\"\n            title={isDarkMode ? \'Cambiar a Modo Claro\' : \'Cambiar a Modo Oscuro\'}\n          >\n            {isDarkMode ? (\n              <Sun className=\"w-4 h-4 text-amber-400 shrink-0\" />\n            ) : (\n              <Moon className=\"w-4 h-4 text-indigo-400 shrink-0\" />\n            )}\n            {!isCollapsed && (\n              <span className=\"truncate\">\n                {isDarkMode ? \'Tema Claro\' : \'Tema Oscuro\'}\n              </span>\n            )}\n          </button>\n\n          <button\n            onClick={onOpenProfileModal}\n            className=\"w-full flex items-center space-x-3 p-2 rounded-xl hover:bg-slate-800/80 transition-colors text-left group\"\n            title=\"Ver / Editar Perfil y Matr\303\255cula Notarial\"\n          >\n            <div className=\"w-8 h-8 rounded-lg bg-gradient-to-br from-blue-600 to-indigo-700 flex items-center justify-center text-white font-bold text-xs shrink-0 shadow-xs group-hover:ring-2 group-hover:ring-blue-400\">\n              {currentUser.name\n                .split(\' \')\n                .map((n) => n[0])\n                .slice(0, 2)\n                .join(\'\')}\n            </div>\n\n            {!isCollapsed && (\n              <div className=\"flex-1 min-w-0\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-xs font-semibold text-white truncate block\">\n                    {currentUser.name}\n                  </span>\n                </div>\n                <div className=\"text-[10px] text-slate-400 truncate flex items-center space-x-1\">\n                  <span className=\"text-emerald-400 font-mono\">CARD: {currentUser.cardRegistration}</span>\n                </div>\n              </div>\n            )}\n          </button>\n        </div>"
