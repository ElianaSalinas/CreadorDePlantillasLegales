        lines {
          text: "    id: \'tpl_poder_especial_rd\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    name: \'Poder Especial Notarial de Representaci\303\263n (RD)\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    description: \'Acto aut\303\251ntico notarial para representaci\303\263n ante DGII, Registro de T\303\255tulos y Bancos bajo la Ley 140-15 del Notariado.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    category: \'Civil\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    jurisdiction: \'Rep\303\272blica Dominicana\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    version: \'1.0\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    status: \'PUBLISHED\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    author: \'Colegio Dominicano de Notarios\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    createdAt: \'2026-08-01T10:00:00Z\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    updatedAt: \'2026-08-10T12:00:00Z\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    content: `ACTO N\303\232MERO: {{numero_acto}}.-"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "EN LA CIUDAD DE {{ciudad_notario}}, Rep\303\272blica Dominicana, {{fecha_notarial_solemne}}."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "ANTE M\303\215, {{notario_nombre}}, Notario P\303\272blico de los del N\303\272mero para el {{distrito_judicial}}, matriculado en el Colegio Dominicano de Notarios bajo el No. {{matricula_notario}}, con estudio profesional abierto en {{notario_estudio}};"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "COMPARECI\303\223 LIBRE Y VOLUNTARIAMENTE:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "El se\303\261or {{poderdante_nombre}}, dominicano, mayor de edad, C\303\251dula No. {{poderdante_cedula}}, domiciliado en {{poderdante_direccion}}, en calidad de PODERDANTE;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "QUIEN ME HA DECLARADO que por medio del presente acto CONFIERE PODER ESPECIAL, tan amplio y suficiente como en derecho fuere necesario, a favor de {{apoderado_nombre}}, dominicano, mayor de edad, C\303\251dula No. {{apoderado_cedula}}, domiciliado en {{apoderado_direccion}}, para que en su nombre y representaci\303\263n realice los siguientes actos:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "PRIMERO: Gestionar, tramitar y firmar ante la Direcci\303\263n General de Impuestos Internos (DGII), el Registro de T\303\255tulos competente y cualquier entidad bancaria, todos los documentos requeridos para: {{facultades_especificas}}."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "DE TODO LO CUAL DOY FE Y CONSTANCIA.`,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
