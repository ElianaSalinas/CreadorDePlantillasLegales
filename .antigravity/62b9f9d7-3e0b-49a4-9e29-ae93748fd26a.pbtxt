  file_change {
    absolute_path_uri: "file:///src/components/DynamicFormGenerator.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useMemo } from \'react\';\nimport {\n  FileCheck2,\n  Download,\n  Eye,\n  CheckCircle2,\n  AlertCircle,\n  Clock,\n  Printer,\n  FileText,\n  Building,\n  CreditCard,\n  Calendar,\n  Sparkles,\n  ShieldCheck,\n  ChevronRight,\n  Code2,\n} from \'lucide-react\';\nimport { useAppStore } from \'../store/useAppStore\';\nimport {\n  evaluateRules,\n  calculateDerivedVariables,\n  substituteVariables,\n} from \'../core/variableEngine\';\nimport { renderConditionalClauses } from \'../core/clauseEngine\';\nimport {\n  validateDominicanCedula,\n  validateDominicanRNC,\n  convertNumberToSpanishWords,\n} from \'../core/dominicanValidators\';\nimport { generateDocxBlob, generatePdfBlob, generateSchemaJson } from \'../core/exportEngine\';\n\nexport const DynamicFormGenerator: React.FC = () => {\n  const {\n    activeTemplate,\n    state,\n    setFormValue,\n    setAllFormValues,\n    saveGeneratedDocument,\n    setView,\n  } = useAppStore();\n\n  const [documentTitle, setDocumentTitle] = useState(\'\');\n  const [isGenerating, setIsGenerating] = useState(false);\n  const [downloadSuccess, setDownloadSuccess] = useState<string | null>(null);\n\n  if (!activeTemplate) {\n    return (\n      <div className=\"max-w-4xl mx-auto py-16 text-center\">\n        <p className=\"text-slate-500\">Selecciona una plantilla para generar el formulario de captura.</p>\n        <button\n          onClick={() => setView(\'TEMPLATES\')}\n          className=\"mt-4 px-4 py-2 bg-blue-600 text-white text-xs font-semibold rounded-lg\"\n        >\n          Ver Plantillas\n        </button>\n      </div>\n    );\n  }\n\n  const rawValues = state.formValues;\n\n  // 1. Calculate derived variables (Montos en letras, fecha solemne, etc.)\n  const fullValuesWithDerived = useMemo(() => {\n    return calculateDerivedVariables(activeTemplate.variables, rawValues);\n  }, [activeTemplate.variables, rawValues]);\n\n  // 2. Evaluate active conditional rules (show/hide clauses, require fields)\n  const ruleEvaluation = useMemo(() => {\n    return evaluateRules(activeTemplate.rules, fullValuesWithDerived);\n  }, [activeTemplate.rules, fullValuesWithDerived]);\n\n  // 3. Render conditional clauses\n  const contentWithClauses = useMemo(() => {\n    return renderConditionalClauses(\n      activeTemplate.content,\n      activeTemplate.clauses,\n      fullValuesWithDerived,\n      ruleEvaluation.visibleClauseIds\n    );\n  }, [activeTemplate.content, activeTemplate.clauses, fullValuesWithDerived, ruleEvaluation]);\n\n  // 4. Substitute variables into final text preview\n  const finalRenderedText = useMemo(() => {\n    return substituteVariables(contentWithClauses, fullValuesWithDerived, true);\n  }, [contentWithClauses, fullValuesWithDerived]);\n\n  // 5. Validation pass for form fields\n  const validationErrors: Record<string, string> = {};\n  for (const v of activeTemplate.variables) {\n    // Skip derived variables from manual validation\n    if (v.derivedConfig) continue;\n\n    const val = fullValuesWithDerived[v.tag];\n    const isRequired = v.required || ruleEvaluation.requiredVariableIds.has(v.tag);\n\n    if (isRequired && (val === undefined || val === \'\' || val === null)) {\n      validationErrors[v.tag] = `El campo \"${v.label}\" es obligatorio.`;\n      continue;\n    }\n\n    if (val) {\n      if (v.dataType === \'cedula\') {\n        const cedRes = validateDominicanCedula(String(val));\n        if (!cedRes.isValid) {\n          validationErrors[v.tag] = cedRes.errorMessage || \'C\303\251dula dominicana inv\303\241lida (M\303\263dulo 10).\';\n        }\n      } else if (v.dataType === \'rnc\') {\n        const rncRes = validateDominicanRNC(String(val));\n        if (!rncRes.isValid) {\n          validationErrors[v.tag] = rncRes.errorMessage || \'RNC DGII inv\303\241lido.\';\n        }\n      }\n    }\n  }\n\n  const isValid = Object.keys(validationErrors).length === 0;\n\n  // Handle document generation & downloads\n  const handleDownloadDocx = async () => {\n    if (!isValid) {\n      alert(\'Por favor corrige los errores de validaci\303\263n antes de generar el documento.\');\n      return;\n    }\n\n    setIsGenerating(true);\n    try {\n      const title = documentTitle || `${activeTemplate.name} - ${new Date().toLocaleDateString()}`;\n      const blob = await generateDocxBlob(title, finalRenderedText);\n\n      const url = URL.createObjectURL(blob);\n      const a = document.createElement(\'a\');\n      a.href = url;\n      a.download = `${title.replace(/[^a-zA-Z0-9_-]/g, \'_\')}.docx`;\n      a.click();\n      URL.revokeObjectURL(url);\n\n      saveGeneratedDocument({\n        id: `doc_${Date.now()}`,\n        templateId: activeTemplate.id,\n        templateName: activeTemplate.name,\n        title,\n        createdAt: new Date().toISOString(),\n        format: \'DOCX\',\n        valuesSnapshot: fullValuesWithDerived,\n        renderedContent: finalRenderedText,\n        author: \'Operador Legal\',\n      });\n\n      setDownloadSuccess(\'Documento DOCX generado y descargado con \303\251xito.\');\n      setTimeout(() => setDownloadSuccess(null), 4000);\n    } catch (e: any) {\n      alert(`Error generando DOCX: ${e.message}`);\n    } finally {\n      setIsGenerating(false);\n    }\n  };\n\n  const handleDownloadPdf = () => {\n    if (!isValid) {\n      alert(\'Por favor corrige los errores de validaci\303\263n antes de generar el documento.\');\n      return;\n    }\n\n    setIsGenerating(true);\n    try {\n      const title = documentTitle || `${activeTemplate.name} - ${new Date().toLocaleDateString()}`;\n      const blob = generatePdfBlob(title, finalRenderedText);\n\n      const url = URL.createObjectURL(blob);\n      const a = document.createElement(\'a\');\n      a.href = url;\n      a.download = `${title.replace(/[^a-zA-Z0-9_-]/g, \'_\')}.pdf`;\n      a.click();\n      URL.revokeObjectURL(url);\n\n      saveGeneratedDocument({\n        id: `doc_${Date.now()}`,\n        templateId: activeTemplate.id,\n        templateName: activeTemplate.name,\n        title,\n        createdAt: new Date().toISOString(),\n        format: \'PDF\',\n        valuesSnapshot: fullValuesWithDerived,\n        renderedContent: finalRenderedText,\n        author: \'Operador Legal\',\n      });\n\n      setDownloadSuccess(\'Documento PDF generado y descargado con \303\251xito.\');\n      setTimeout(() => setDownloadSuccess(null), 4000);\n    } catch (e: any) {\n      alert(`Error generando PDF: ${e.message}`);\n    } finally {\n      setIsGenerating(false);\n    }\n  };\n\n  const handleDownloadSchema = () => {\n    const jsonStr = generateSchemaJson(activeTemplate);\n    const blob = new Blob([jsonStr], { type: \'application/json\' });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\'a\');\n    a.href = url;\n    a.download = `${activeTemplate.name.replace(/[^a-zA-Z0-9_-]/g, \'_\')}_schema.json`;\n    a.click();\n    URL.revokeObjectURL(url);\n  };\n\n  // Input field renderer\n  const renderField = (v: any) => {\n    const error = validationErrors[v.tag];\n    const isRequired = v.required || ruleEvaluation.requiredVariableIds.has(v.tag);\n    const value = fullValuesWithDerived[v.tag] !== undefined ? fullValuesWithDerived[v.tag] : \'\';\n\n    if (v.derivedConfig) {\n      return (\n        <div key={v.id} className=\"bg-purple-50/50 p-3 rounded-lg border border-purple-100 space-y-1\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-[11px] font-semibold text-purple-900 flex items-center space-x-1\">\n              <Sparkles className=\"w-3 h-3 text-purple-600\" />\n              <span>{v.label}</span>\n            </span>\n            <span className=\"text-[10px] text-purple-600 font-mono\">Auto-calculado</span>\n          </div>\n          <div className=\"text-xs font-serif font-bold text-slate-800 bg-white p-2 rounded border border-purple-200\">\n            {value || <span className=\"text-slate-400 font-sans italic font-normal\">Calculando...</span>}\n          </div>\n        </div>\n      );\n    }\n\n    return (\n      <div key={v.id} className=\"space-y-1\">\n        <div className=\"flex items-center justify-between\">\n          <label className=\"block text-xs font-semibold text-slate-700\">\n            {v.label} {isRequired && <span className=\"text-rose-500\">*</span>}\n          </label>\n          <span className=\"font-mono text-[10px] text-slate-400\">{`{{${v.tag}}}`}</span>\n        </div>\n\n        {v.dataType === \'boolean\' ? (\n          <div className=\"flex items-center space-x-3 py-1\">\n            <label className=\"inline-flex items-center space-x-2 text-xs text-slate-700 cursor-pointer\">\n              <input\n                type=\"radio\"\n                name={`radio_${v.tag}`}\n                checked={value === true}\n                onChange={() => setFormValue(v.tag, true)}\n                className=\"text-blue-600 focus:ring-blue-500\"\n              />\n              <span>S\303\255</span>\n            </label>\n            <label className=\"inline-flex items-center space-x-2 text-xs text-slate-700 cursor-pointer\">\n              <input\n                type=\"radio\"\n                name={`radio_${v.tag}`}\n                checked={value === false}\n                onChange={() => setFormValue(v.tag, false)}\n                className=\"text-blue-600 focus:ring-blue-500\"\n              />\n              <span>No</span>\n            </label>\n          </div>\n        ) : v.dataType === \'date\' ? (\n          <input\n            type=\"date\"\n            value={value}\n            onChange={(e) => setFormValue(v.tag, e.target.value)}\n            className={`w-full px-3 py-2 text-xs rounded-lg border bg-white focus:outline-none ${\n              error ? \'border-rose-300 focus:ring-2 focus:ring-rose-200\' : \'border-slate-200 focus:ring-2 focus:ring-blue-500\'\n            }`}\n          />\n        ) : v.dataType === \'currency\' || v.dataType === \'integer\' || v.dataType === \'percentage\' ? (\n          <div className=\"relative\">\n            {v.dataType === \'currency\' && (\n              <span className=\"absolute left-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400\">\n                {v.currency === \'USD\' ? \'US$\' : v.currency === \'EUR\' ? \'\342\202\254\' : \'RD$\'}\n              </span>\n            )}\n            <input\n              type=\"number\"\n              value={value}\n              onChange={(e) => setFormValue(v.tag, e.target.value === \'\' ? \'\' : Number(e.target.value))}\n              placeholder=\"0.00\"\n              className={`w-full ${v.dataType === \'currency\' ? \'pl-11\' : \'pl-3\'} pr-3 py-2 text-xs rounded-lg border bg-white focus:outline-none ${\n                error ? \'border-rose-300 focus:ring-2 focus:ring-rose-200\' : \'border-slate-200 focus:ring-2 focus:ring-blue-500\'\n              }`}\n            />\n          </div>\n        ) : (\n          <input\n            type=\"text\"\n            value={value}\n            onChange={(e) => setFormValue(v.tag, e.target.value)}\n            placeholder={`Ingresa ${v.label.toLowerCase()}...`}\n            className={`w-full px-3 py-2 text-xs rounded-lg border bg-white focus:outline-none ${\n              error ? \'border-rose-300 focus:ring-2 focus:ring-rose-200\' : \'border-slate-200 focus:ring-2 focus:ring-blue-500\'\n            }`}\n          />\n        )}\n\n        {error && <p className=\"text-[11px] text-rose-600 font-medium\">{error}</p>}\n      </div>\n    );\n  };\n\n  return (\n    <div className=\"h-[calc(100vh-4rem)] flex flex-col bg-slate-100 overflow-hidden\">\n      {/* Top Banner & Generation Trigger */}\n      <div className=\"bg-white border-b border-slate-200 px-6 py-3 flex flex-wrap items-center justify-between gap-4 shrink-0 shadow-xs z-20\">\n        <div className=\"flex items-center space-x-3\">\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"text-xs font-semibold text-blue-600 uppercase tracking-wider bg-blue-50 px-2 py-0.5 rounded border border-blue-100\">\n                Generador de Documentos\n              </span>\n              <span className=\"text-xs text-slate-400 font-mono\">Plantilla: {activeTemplate.name}</span>\n            </div>\n            <input\n              type=\"text\"\n              value={documentTitle}\n              onChange={(e) => setDocumentTitle(e.target.value)}\n              placeholder=\"T\303\255tulo del Contrato (ej. Contrato Alquiler - Juan P\303\251rez vs Marcos Cabrera)...\"\n              className=\"text-sm font-semibold font-serif text-slate-900 border-b border-transparent hover:border-slate-300 focus:border-blue-500 focus:outline-none mt-0.5 w-80 sm:w-96\"\n            />\n          </div>\n        </div>\n\n        {/* Action Buttons */}\n        <div className=\"flex items-center space-x-2\">\n          <button\n            onClick={handleDownloadSchema}\n            className=\"p-2 text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-lg transition-colors border border-slate-200\"\n            title=\"Descargar schema.json (Contrato de Datos)\"\n          >\n            <Code2 className=\"w-4 h-4\" />\n          </button>\n\n          <button\n            onClick={handleDownloadDocx}\n            disabled={isGenerating}\n            className=\"flex items-center space-x-1.5 px-4 py-2 rounded-lg text-xs font-semibold bg-blue-600 hover:bg-blue-500 text-white shadow-sm transition-all disabled:opacity-50\"\n          >\n            <Download className=\"w-3.5 h-3.5\" />\n            <span>Descargar DOCX</span>\n          </button>\n\n          <button\n            onClick={handleDownloadPdf}\n            disabled={isGenerating}\n            className=\"flex items-center space-x-1.5 px-4 py-2 rounded-lg text-xs font-semibold bg-slate-900 hover:bg-slate-800 text-white shadow-sm transition-all disabled:opacity-50\"\n          >\n            <Printer className=\"w-3.5 h-3.5\" />\n            <span>Descargar PDF</span>\n          </button>\n        </div>\n      </div>\n\n      {downloadSuccess && (\n        <div className=\"bg-emerald-600 text-white text-xs px-6 py-2 flex items-center justify-between\">\n          <span className=\"flex items-center space-x-2\">\n            <CheckCircle2 className=\"w-4 h-4\" />\n            <span>{downloadSuccess}</span>\n          </span>\n          <button onClick={() => setView(\'DOCUMENTS\')} className=\"underline font-semibold\">\n            Ver en Historial\n          </button>\n        </div>\n      )}\n\n      {/* Main Split Layout: Form on Left, Document Preview on Right */}\n      <div className=\"flex-1 flex overflow-hidden\">\n        {/* Left: Dynamic Form Questionnaire */}\n        <div className=\"w-full md:w-5/12 h-full flex flex-col bg-white border-r border-slate-200\">\n          <div className=\"p-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between\">\n            <span className=\"font-semibold text-xs text-slate-800 flex items-center space-x-2\">\n              <FileCheck2 className=\"w-4 h-4 text-blue-600\" />\n              <span>Formulario de Datos del Contrato</span>\n            </span>\n            <span\n              className={`text-[11px] font-semibold px-2 py-0.5 rounded-full ${\n                isValid ? \'bg-emerald-50 text-emerald-700\' : \'bg-rose-50 text-rose-700\'\n              }`}\n            >\n              {isValid ? \'Listo para generar\' : `${Object.keys(validationErrors).length} campo(s) pendiente(s)`}\n            </span>\n          </div>\n\n          <div className=\"flex-1 p-6 overflow-y-auto space-y-4\">\n            {activeTemplate.variables.map((v) => renderField(v))}\n          </div>\n        </div>\n\n        {/* Right: Real-time Synchronized Legal Document Preview */}\n        <div className=\"hidden md:flex md:w-7/12 h-full flex-col bg-slate-100\">\n          <div className=\"p-3 bg-slate-200/80 border-b border-slate-300 flex items-center justify-between text-xs text-slate-600\">\n            <span className=\"font-semibold text-slate-800 flex items-center space-x-1.5\">\n              <Eye className=\"w-3.5 h-3.5 text-blue-600\" />\n              <span>Previsualizaci\303\263n Sincronizada del Documento Final</span>\n            </span>\n            <span className=\"text-[11px] text-slate-500\">Formato Legal Notarial \342\200\242 Tipograf\303\255a Serif</span>\n          </div>\n\n          <div className=\"flex-1 p-8 overflow-y-auto flex justify-center\">\n            <div className=\"bg-white rounded-lg shadow-lg border border-slate-200 p-12 max-w-2xl w-full text-slate-900 font-serif leading-relaxed text-sm whitespace-pre-wrap selection:bg-blue-100\">\n              {finalRenderedText}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
