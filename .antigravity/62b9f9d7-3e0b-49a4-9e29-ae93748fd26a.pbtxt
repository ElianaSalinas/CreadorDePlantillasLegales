  file_change {
    absolute_path_uri: "file:///src/components/DocumentEditor.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useRef } from \'react\';\nimport {\n  FileText,\n  Save,\n  Sparkles,\n  Eye,\n  Columns,\n  Layers,\n  BookOpen,\n  Settings,\n  ShieldCheck,\n  CheckCircle2,\n  AlertTriangle,\n  History,\n  Code2,\n  Copy,\n  ChevronDown,\n  Plus,\n  Play,\n} from \'lucide-react\';\nimport { useAppStore } from \'../store/useAppStore\';\nimport { substituteVariables, extractReferencedVariables } from \'../core/variableEngine\';\nimport { renderConditionalClauses } from \'../core/clauseEngine\';\nimport { runTemplateHealthCheck } from \'../core/healthCheck\';\nimport { detectVariablesLocally, detectVariablesWithAI } from \'../core/detectorEngine\';\nimport { TemplateStatus } from \'../types\';\n\ninterface DocumentEditorProps {\n  onOpenHealthModal: () => void;\n  onOpenVersionModal: () => void;\n}\n\nexport const DocumentEditor: React.FC<DocumentEditorProps> = ({\n  onOpenHealthModal,\n  onOpenVersionModal,\n}) => {\n  const {\n    activeTemplate,\n    updateTemplate,\n    changeTemplateStatus,\n    setView,\n    startHitlReview,\n    setAnalyzing,\n  } = useAppStore();\n\n  const [viewMode, setViewMode] = useState<\'SPLIT\' | \'EDITOR_ONLY\' | \'PREVIEW_ONLY\'>(\'SPLIT\');\n  const [showVariableDropdown, setShowVariableDropdown] = useState(false);\n  const [showClauseDropdown, setShowClauseDropdown] = useState(false);\n  const [showSaveVersionModal, setShowSaveVersionModal] = useState(false);\n  const [versionDescription, setVersionDescription] = useState(\'\');\n  const [aiLoading, setAiLoading] = useState(false);\n\n  const textareaRef = useRef<HTMLTextAreaElement | null>(null);\n\n  if (!activeTemplate) {\n    return (\n      <div className=\"max-w-4xl mx-auto py-16 text-center\">\n        <p className=\"text-slate-500\">Selecciona o crea una plantilla para comenzar a editar.</p>\n        <button\n          onClick={() => setView(\'TEMPLATES\')}\n          className=\"mt-4 px-4 py-2 bg-blue-600 text-white text-xs font-semibold rounded-lg\"\n        >\n          Ir al cat\303\241logo\n        </button>\n      </div>\n    );\n  }\n\n  const health = runTemplateHealthCheck(activeTemplate);\n\n  // Generate sample filled preview for the split view\n  const sampleValues: Record<string, any> = {};\n  activeTemplate.variables.forEach((v) => {\n    sampleValues[v.tag] = v.defaultValue || `[${v.label.toUpperCase()}]`;\n  });\n\n  const previewWithClauses = renderConditionalClauses(\n    activeTemplate.content,\n    activeTemplate.clauses,\n    sampleValues\n  );\n  const previewFinal = substituteVariables(previewWithClauses, sampleValues, true);\n\n  const insertTextAtCursor = (textToInsert: string) => {\n    const textarea = textareaRef.current;\n    if (!textarea) return;\n\n    const start = textarea.selectionStart;\n    const end = textarea.selectionEnd;\n    const current = activeTemplate.content;\n\n    const updated = current.substring(0, start) + textToInsert + current.substring(end);\n    updateTemplate(activeTemplate.id, { content: updated });\n\n    setTimeout(() => {\n      textarea.focus();\n      textarea.setSelectionRange(start + textToInsert.length, start + textToInsert.length);\n    }, 50);\n  };\n\n  const handleInsertNumbering = (prefix: string) => {\n    insertTextAtCursor(`\\n\\n${prefix}: `);\n  };\n\n  const handleTriggerAIAnalysis = async () => {\n    setAiLoading(true);\n    setAnalyzing(true);\n    try {\n      // Call hybrid detector (AI + Dominican Regex)\n      const res = await detectVariablesWithAI(activeTemplate.content);\n      startHitlReview(activeTemplate.content, res.detectedVariables, activeTemplate.id);\n    } catch (e: any) {\n      alert(`Error durante an\303\241lisis: ${e.message}`);\n    } finally {\n      setAiLoading(false);\n      setAnalyzing(false);\n    }\n  };\n\n  const handleStatusChange = (newStatus: TemplateStatus) => {\n    const res = changeTemplateStatus(activeTemplate.id, newStatus);\n    if (!res.success) {\n      alert(res.error);\n    }\n  };\n\n  return (\n    <div className=\"h-[calc(100vh-4rem)] flex flex-col bg-slate-100 overflow-hidden\">\n      {/* Top Editor Toolbar */}\n      <div className=\"bg-white border-b border-slate-200 px-4 py-2.5 flex flex-wrap items-center justify-between gap-2 shadow-xs shrink-0 z-20\">\n        <div className=\"flex items-center space-x-2\">\n          <input\n            type=\"text\"\n            value={activeTemplate.name}\n            onChange={(e) => updateTemplate(activeTemplate.id, { name: e.target.value })}\n            className=\"font-serif font-bold text-slate-800 text-base bg-transparent border-b border-transparent hover:border-slate-300 focus:border-blue-500 focus:outline-none px-1 py-0.5\"\n            placeholder=\"T\303\255tulo de la plantilla...\"\n          />\n\n          <span className=\"text-xs text-slate-400 font-mono\">v{activeTemplate.version}</span>\n\n          <select\n            value={activeTemplate.status}\n            onChange={(e) => handleStatusChange(e.target.value as TemplateStatus)}\n            className={`text-xs font-semibold px-2.5 py-1 rounded-md border focus:outline-none ${\n              activeTemplate.status === \'PUBLISHED\'\n                ? \'bg-emerald-50 text-emerald-700 border-emerald-200\'\n                : activeTemplate.status === \'REVIEW\'\n                ? \'bg-amber-50 text-amber-700 border-amber-200\'\n                : \'bg-slate-100 text-slate-700 border-slate-200\'\n            }`}\n          >\n            <option value=\"DRAFT\">Borrador (DRAFT)</option>\n            <option value=\"REVIEW\">En Revisi\303\263n (REVIEW)</option>\n            <option value=\"PUBLISHED\">Publicada (PUBLISHED)</option>\n            <option value=\"ARCHIVED\">Archivada (ARCHIVED)</option>\n          </select>\n        </div>\n\n        {/* Quick Insert & AI Actions */}\n        <div className=\"flex items-center space-x-2\">\n          {/* Insert Variable Dropdown */}\n          <div className=\"relative\">\n            <button\n              onClick={() => {\n                setShowVariableDropdown(!showVariableDropdown);\n                setShowClauseDropdown(false);\n              }}\n              className=\"flex items-center space-x-1 px-3 py-1.5 rounded-lg text-xs font-medium bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 transition-colors\"\n            >\n              <Layers className=\"w-3.5 h-3.5\" />\n              <span>Insertar Variable</span>\n              <ChevronDown className=\"w-3 h-3\" />\n            </button>\n\n            {showVariableDropdown && (\n              <div className=\"absolute right-0 mt-1 w-64 bg-white rounded-xl shadow-xl border border-slate-200 py-1.5 z-50 max-h-80 overflow-y-auto\">\n                <div className=\"px-3 py-1 text-[11px] font-semibold text-slate-400 uppercase tracking-wider\">\n                  Variables de la plantilla\n                </div>\n                {activeTemplate.variables.length === 0 ? (\n                  <div className=\"px-3 py-2 text-xs text-slate-500\">No hay variables creadas a\303\272n.</div>\n                ) : (\n                  activeTemplate.variables.map((v) => (\n                    <button\n                      key={v.id}\n                      onClick={() => {\n                        insertTextAtCursor(`{{${v.tag}}}`);\n                        setShowVariableDropdown(false);\n                      }}\n                      className=\"w-full text-left px-3 py-1.5 hover:bg-slate-50 text-xs flex flex-col transition-colors\"\n                    >\n                      <span className=\"font-mono font-medium text-blue-600\">{`{{${v.tag}}}`}</span>\n                      <span className=\"text-[10px] text-slate-400\">{v.label}</span>\n                    </button>\n                  ))\n                )}\n                <div className=\"border-t border-slate-100 mt-1 pt-1 px-2\">\n                  <button\n                    onClick={() => {\n                      setView(\'VARIABLES\');\n                      setShowVariableDropdown(false);\n                    }}\n                    className=\"w-full text-left px-2 py-1 text-xs text-blue-600 hover:bg-blue-50 rounded font-medium flex items-center space-x-1\"\n                  >\n                    <Plus className=\"w-3 h-3\" />\n                    <span>Crear nueva variable</span>\n                  </button>\n                </div>\n              </div>\n            )}\n          </div>\n\n          {/* Insert Clause Dropdown */}\n          <div className=\"relative\">\n            <button\n              onClick={() => {\n                setShowClauseDropdown(!showClauseDropdown);\n                setShowVariableDropdown(false);\n              }}\n              className=\"flex items-center space-x-1 px-3 py-1.5 rounded-lg text-xs font-medium bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 transition-colors\"\n            >\n              <BookOpen className=\"w-3.5 h-3.5\" />\n              <span>Insertar Cl\303\241usula</span>\n              <ChevronDown className=\"w-3 h-3\" />\n            </button>\n\n            {showClauseDropdown && (\n              <div className=\"absolute right-0 mt-1 w-72 bg-white rounded-xl shadow-xl border border-slate-200 py-1.5 z-50 max-h-80 overflow-y-auto\">\n                <div className=\"px-3 py-1 text-[11px] font-semibold text-slate-400 uppercase tracking-wider\">\n                  Biblioteca de Cl\303\241usulas\n                </div>\n                {activeTemplate.clauses.map((c) => (\n                  <button\n                    key={c.id}\n                    onClick={() => {\n                      insertTextAtCursor(`\\n\\n{{#clause:${c.id}}}\\n${c.content}\\n{{/clause:${c.id}}}\\n`);\n                      setShowClauseDropdown(false);\n                    }}\n                    className=\"w-full text-left px-3 py-1.5 hover:bg-slate-50 text-xs flex flex-col transition-colors\"\n                  >\n                    <span className=\"font-medium text-slate-800\">{c.title}</span>\n                    <span className=\"text-[10px] text-indigo-600\">{c.category}</span>\n                  </button>\n                ))}\n              </div>\n            )}\n          </div>\n\n          {/* AI NLP Extraction */}\n          <button\n            onClick={handleTriggerAIAnalysis}\n            disabled={aiLoading}\n            className=\"flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white shadow-xs transition-all disabled:opacity-50\"\n            title=\"Analizar texto y detectar variables con Regex e IA (US-16, US-42)\"\n          >\n            <Sparkles className=\"w-3.5 h-3.5\" />\n            <span>{aiLoading ? \'Analizando...\' : \'Detectar Variables\'}</span>\n          </button>\n\n          {/* Health check badge */}\n          <button\n            onClick={onOpenHealthModal}\n            className={`px-2.5 py-1.5 rounded-lg text-xs font-medium flex items-center space-x-1 border ${\n              health.status === \'HEALTHY\'\n                ? \'bg-emerald-50 text-emerald-700 border-emerald-200\'\n                : health.status === \'WARNING\'\n                ? \'bg-amber-50 text-amber-700 border-amber-200\'\n                : \'bg-rose-50 text-rose-700 border-rose-200\'\n            }`}\n          >\n            {health.status === \'HEALTHY\' ? (\n              <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-500\" />\n            ) : health.status === \'WARNING\' ? (\n              <AlertTriangle className=\"w-3.5 h-3.5 text-amber-500\" />\n            ) : (\n              <AlertTriangle className=\"w-3.5 h-3.5 text-rose-500\" />\n            )}\n            <span>Salud: {health.score}%</span>\n          </button>\n\n          {/* Test Form Generation */}\n          <button\n            onClick={() => setView(\'FORM_GEN\')}\n            className=\"flex items-center space-x-1 px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-900 hover:bg-slate-800 text-white shadow-xs transition-all\"\n          >\n            <Play className=\"w-3 h-3 fill-current text-blue-400\" />\n            <span>Generar</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Secondary Legal Numbering & Formatting Toolbar */}\n      <div className=\"bg-slate-50 border-b border-slate-200 px-4 py-1.5 flex items-center justify-between text-xs text-slate-600 shrink-0\">\n        <div className=\"flex items-center space-x-1.5 flex-wrap\">\n          <span className=\"text-[11px] text-slate-400 font-semibold mr-1\">Numeraci\303\263n Notarial RD:</span>\n          {[\'PRIMERO\', \'SEGUNDO\', \'TERCERO\', \'CUARTO\', \'QUINTO\', \'SEXTO\', \'S\303\211PTIMO\'].map((num) => (\n            <button\n              key={num}\n              onClick={() => handleInsertNumbering(num)}\n              className=\"px-2 py-0.5 bg-white hover:bg-slate-200 text-slate-700 rounded border border-slate-200 font-mono text-[11px]\"\n            >\n              {num}:\n            </button>\n          ))}\n        </div>\n\n        {/* View mode toggle */}\n        <div className=\"flex items-center space-x-1 bg-white rounded-lg border border-slate-200 p-0.5\">\n          <button\n            onClick={() => setViewMode(\'EDITOR_ONLY\')}\n            className={`px-2 py-1 rounded text-xs font-medium ${\n              viewMode === \'EDITOR_ONLY\' ? \'bg-slate-800 text-white\' : \'text-slate-600 hover:bg-slate-100\'\n            }`}\n          >\n            Solo Editor\n          </button>\n          <button\n            onClick={() => setViewMode(\'SPLIT\')}\n            className={`px-2 py-1 rounded text-xs font-medium ${\n              viewMode === \'SPLIT\' ? \'bg-slate-800 text-white\' : \'text-slate-600 hover:bg-slate-100\'\n            }`}\n          >\n            Vista Dividida\n          </button>\n          <button\n            onClick={() => setViewMode(\'PREVIEW_ONLY\')}\n            className={`px-2 py-1 rounded text-xs font-medium ${\n              viewMode === \'PREVIEW_ONLY\' ? \'bg-slate-800 text-white\' : \'text-slate-600 hover:bg-slate-100\'\n            }`}\n          >\n            Vista Previa\n          </button>\n        </div>\n      </div>\n\n      {/* Main Editor Work Area */}\n      <div className=\"flex-1 flex overflow-hidden\">\n        {/* Editor Area */}\n        {(viewMode === \'SPLIT\' || viewMode === \'EDITOR_ONLY\') && (\n          <div className={`h-full flex flex-col bg-white ${viewMode === \'SPLIT\' ? \'w-1/2 border-r border-slate-200\' : \'w-full\'}`}>\n            <div className=\"p-3 bg-slate-50 border-b border-slate-200 flex items-center justify-between text-xs text-slate-500 font-mono\">\n              <span>Contenido Documental (WordprocessingML / Tags)</span>\n              <span>{activeTemplate.content.length} caracteres</span>\n            </div>\n            <textarea\n              ref={textareaRef}\n              value={activeTemplate.content}\n              onChange={(e) => updateTemplate(activeTemplate.id, { content: e.target.value })}\n              className=\"flex-1 p-6 font-mono text-sm leading-relaxed text-slate-800 resize-none focus:outline-none selection:bg-blue-100 overflow-y-auto\"\n              placeholder=\"Escribe o pega aqu\303\255 el contrato legal. Usa {{variable}} para parametrizar...\"\n              spellCheck={false}\n            />\n          </div>\n        )}\n\n        {/* Live Preview Area */}\n        {(viewMode === \'SPLIT\' || viewMode === \'PREVIEW_ONLY\') && (\n          <div className={`h-full flex flex-col bg-slate-50 ${viewMode === \'SPLIT\' ? \'w-1/2\' : \'w-full\'}`}>\n            <div className=\"p-3 bg-slate-100 border-b border-slate-200 flex items-center justify-between text-xs text-slate-500\">\n              <span className=\"font-semibold text-slate-700 flex items-center space-x-1.5\">\n                <Eye className=\"w-3.5 h-3.5 text-blue-600\" />\n                <span>Previsualizaci\303\263n en Vivo con Datos de Muestra</span>\n              </span>\n              <span className=\"text-[11px] text-slate-400\">Jurisdicci\303\263n RD \342\200\242 Formato Notarial</span>\n            </div>\n            <div className=\"flex-1 p-8 overflow-y-auto bg-slate-200/50 flex justify-center\">\n              <div className=\"bg-white rounded-lg shadow-md border border-slate-200 p-10 max-w-2xl w-full min-h-[600px] text-slate-900 font-serif leading-relaxed text-sm whitespace-pre-wrap selection:bg-amber-100\">\n                {previewFinal || (\n                  <p className=\"text-slate-400 italic text-center py-20 font-sans\">\n                    El documento est\303\241 vac\303\255o. Escribe en el editor para previsualizar.\n                  </p>\n                )}\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
