  file_change {
    absolute_path_uri: "file:///src/components/TemplateList.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  FileText,\n  Search,\n  Filter,\n  Plus,\n  Upload,\n  Copy,\n  Trash2,\n  CheckCircle2,\n  Clock,\n  Archive,\n  ArrowRight,\n  ShieldCheck,\n  Building,\n  Scale,\n  Briefcase,\n  Layers,\n  Sparkles,\n  Play,\n  FileCheck,\n} from \'lucide-react\';\nimport { useAppStore } from \'../store/useAppStore\';\nimport { TemplateCategory, TemplateStatus, LegalTemplate } from \'../types\';\nimport { runTemplateHealthCheck } from \'../core/healthCheck\';\n\ninterface TemplateListProps {\n  onOpenNewTemplateModal: () => void;\n  onOpenDocxImportModal: () => void;\n}\n\nexport const TemplateList: React.FC<TemplateListProps> = ({\n  onOpenNewTemplateModal,\n  onOpenDocxImportModal,\n}) => {\n  const {\n    state,\n    setActiveTemplateId,\n    setView,\n    duplicateTemplate,\n    deleteTemplate,\n    changeTemplateStatus,\n  } = useAppStore();\n\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'ALL\');\n  const [selectedStatus, setSelectedStatus] = useState<string>(\'ALL\');\n\n  const filteredTemplates = state.templates.filter((tpl) => {\n    const matchesSearch =\n      tpl.name.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      tpl.description.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      tpl.variables.some((v) => v.tag.includes(searchQuery.toLowerCase()));\n\n    const matchesCat = selectedCategory === \'ALL\' || tpl.category === selectedCategory;\n    const matchesStat = selectedStatus === \'ALL\' || tpl.status === selectedStatus;\n\n    return matchesSearch && matchesCat && matchesStat;\n  });\n\n  const getCategoryIcon = (category: TemplateCategory) => {\n    switch (category) {\n      case \'Inmobiliario\':\n        return <Building className=\"w-4 h-4 text-[#C5A059]\" />;\n      case \'Civil\':\n        return <Scale className=\"w-4 h-4 text-[#0D2C24] dark:text-emerald-400\" />;\n      case \'Comercial\':\n        return <Briefcase className=\"w-4 h-4 text-emerald-600\" />;\n      default:\n        return <FileText className=\"w-4 h-4 text-[#0D2C24] dark:text-emerald-400\" />;\n    }\n  };\n\n  const handleSelectTemplate = (template: LegalTemplate, targetView: \'EDITOR\' | \'FORM_GEN\') => {\n    setActiveTemplateId(template.id);\n    setView(targetView);\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6\">\n      {/* Top Header & Metrics Banner with SAVE Branding */}\n      <div className=\"bg-[#0D2C24] dark:bg-slate-900 rounded-2xl p-6 text-white shadow-md border border-[#164E3E] dark:border-slate-800 relative overflow-hidden\">\n        <div className=\"relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-4\">\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"text-xs font-bold uppercase tracking-wider text-[#0D2C24] bg-[#FDE8B5] px-2.5 py-0.5 rounded-md shadow-2xs\">\n                Jurisdicci\303\263n Rep\303\272blica Dominicana (RD)\n              </span>\n              <span className=\"text-xs text-emerald-200/70 dark:text-slate-400\">Ley 140-15 \342\200\242 Ley 4314 \342\200\242 C\303\263digo Civil</span>\n            </div>\n            <h1 className=\"text-2xl sm:text-3xl font-bold tracking-tight font-serif mt-2 text-white\">\n              Cat\303\241logo de Plantillas Notariales\n            </h1>\n            <p className=\"text-emerald-100/80 dark:text-slate-300 text-xs sm:text-sm max-w-2xl mt-1 leading-relaxed\">\n              Crea, parametriza y genera documentos legales reutilizables con validaci\303\263n de C\303\251dula JCE, RNC, cifras notariales en letras y reglas condicionales.\n            </p>\n          </div>\n\n          <div className=\"flex items-center space-x-3 shrink-0\">\n            <button\n              onClick={onOpenDocxImportModal}\n              className=\"flex items-center space-x-2 px-4 py-2.5 rounded-xl text-xs font-semibold bg-[#164E3E] hover:bg-[#1C604D] text-white border border-[#2D7A64] transition-all shadow-xs cursor-pointer\"\n            >\n              <Upload className=\"w-4 h-4 text-[#FDE8B5]\" />\n              <span>Importar DOCX</span>\n            </button>\n\n            <button\n              onClick={onOpenNewTemplateModal}\n              className=\"flex items-center space-x-2 px-4 py-2.5 rounded-xl text-xs font-bold bg-[#FDE8B5] hover:bg-[#FCE19F] text-[#0D2C24] transition-all shadow-md cursor-pointer\"\n            >\n              <Plus className=\"w-4 h-4\" />\n              <span>Nueva Plantilla</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Mini stats */}\n        <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6 pt-6 border-t border-[#164E3E] dark:border-slate-800 text-xs\">\n          <div className=\"bg-[#08201A] dark:bg-slate-800/50 rounded-xl p-3 border border-[#164E3E] dark:border-slate-700/40\">\n            <div className=\"text-emerald-200/70 dark:text-slate-400\">Plantillas Registradas</div>\n            <div className=\"text-xl font-bold text-white mt-0.5 font-serif\">{state.templates.length}</div>\n          </div>\n          <div className=\"bg-[#08201A] dark:bg-slate-800/50 rounded-xl p-3 border border-[#164E3E] dark:border-slate-700/40\">\n            <div className=\"text-emerald-200/70 dark:text-slate-400\">Plantillas Publicadas</div>\n            <div className=\"text-xl font-bold text-[#FDE8B5] mt-0.5 font-serif\">\n              {state.templates.filter((t) => t.status === \'PUBLISHED\').length}\n            </div>\n          </div>\n          <div className=\"bg-[#08201A] dark:bg-slate-800/50 rounded-xl p-3 border border-[#164E3E] dark:border-slate-700/40\">\n            <div className=\"text-emerald-200/70 dark:text-slate-400\">Biblioteca de Cl\303\241usulas</div>\n            <div className=\"text-xl font-bold text-white mt-0.5 font-serif\">{state.globalClauses.length}</div>\n          </div>\n          <div className=\"bg-[#08201A] dark:bg-slate-800/50 rounded-xl p-3 border border-[#164E3E] dark:border-slate-700/40\">\n            <div className=\"text-emerald-200/70 dark:text-slate-400\">Documentos en B\303\263veda</div>\n            <div className=\"text-xl font-bold text-[#C5A059] mt-0.5 font-serif\">{state.generatedDocuments.length}</div>\n          </div>\n        </div>\n      </div>\n\n      {/* Filter & Search Bar */}\n      <div className=\"bg-white dark:bg-slate-900 rounded-xl p-4 shadow-2xs border border-[#E8E5DF] dark:border-slate-800 flex flex-col md:flex-row md:items-center justify-between gap-3\">\n        {/* Search */}\n        <div className=\"relative flex-1\">\n          <Search className=\"w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" />\n          <input\n            type=\"text\"\n            placeholder=\"Buscar por nombre, descripci\303\263n o variable (ej. \'inquilino_cedula\')...\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            className=\"w-full pl-9 pr-4 py-2 text-xs rounded-lg border border-[#D1CCC4] dark:border-slate-700 dark:bg-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#0D2C24]/20 focus:border-[#0D2C24]\"\n          />\n        </div>\n\n        {/* Filters */}\n        <div className=\"flex items-center space-x-2\">\n          <select\n            value={selectedCategory}\n            onChange={(e) => setSelectedCategory(e.target.value)}\n            className=\"text-xs bg-[#F5F2ED] dark:bg-slate-800 border border-[#D1CCC4] dark:border-slate-700 text-[#0D2C24] dark:text-slate-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#0D2C24] font-medium cursor-pointer\"\n          >\n            <option value=\"ALL\">Todas las Categor\303\255as</option>\n            <option value=\"Inmobiliario\">Inmobiliario</option>\n            <option value=\"Civil\">Civil</option>\n            <option value=\"Comercial\">Comercial</option>\n            <option value=\"Corporativo\">Corporativo</option>\n          </select>\n\n          <select\n            value={selectedStatus}\n            onChange={(e) => setSelectedStatus(e.target.value)}\n            className=\"text-xs bg-[#F5F2ED] dark:bg-slate-800 border border-[#D1CCC4] dark:border-slate-700 text-[#0D2C24] dark:text-slate-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#0D2C24] font-medium cursor-pointer\"\n          >\n            <option value=\"ALL\">Todos los Estados</option>\n            <option value=\"PUBLISHED\">Publicadas</option>\n            <option value=\"DRAFT\">Borrador</option>\n            <option value=\"REVIEW\">En Revisi\303\263n</option>\n            <option value=\"ARCHIVED\">Archivadas</option>\n          </select>\n        </div>\n      </div>\n\n      {/* Templates Grid */}\n      {filteredTemplates.length === 0 ? (\n        <div className=\"bg-white dark:bg-slate-900 rounded-xl p-12 text-center border border-dashed border-[#D1CCC4] dark:border-slate-800\">\n          <FileText className=\"w-12 h-12 text-slate-300 dark:text-slate-600 mx-auto mb-3\" />\n          <h3 className=\"text-base font-semibold text-slate-800 dark:text-slate-200 font-serif\">No se encontraron plantillas</h3>\n          <p className=\"text-xs text-slate-500 dark:text-slate-400 max-w-sm mx-auto mt-1\">\n            Intenta cambiar los filtros de b\303\272squeda o crea una nueva plantilla legal desde cero o importando un DOCX.\n          </p>\n          <div className=\"mt-4 flex justify-center space-x-2\">\n            <button\n              onClick={onOpenNewTemplateModal}\n              className=\"px-3.5 py-2 rounded-lg text-xs font-semibold bg-[#0D2C24] hover:bg-[#164E3E] text-white cursor-pointer\"\n            >\n              Crear Plantilla\n            </button>\n            <button\n              onClick={onOpenDocxImportModal}\n              className=\"px-3.5 py-2 rounded-lg text-xs font-semibold bg-[#F5F2ED] hover:bg-[#E8E5DF] text-[#0D2C24] cursor-pointer\"\n            >\n              Importar DOCX\n            </button>\n          </div>\n        </div>\n      ) : (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\">\n          {filteredTemplates.map((template) => {\n            const health = runTemplateHealthCheck(template);\n\n            return (\n              <div\n                key={template.id}\n                className=\"bg-white dark:bg-slate-900 rounded-xl border border-[#E8E5DF] dark:border-slate-800 hover:border-[#0D2C24] dark:hover:border-emerald-600 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between group overflow-hidden\"\n              >\n                <div className=\"p-5 space-y-3\">\n                  {/* Top metadata badge */}\n                  <div className=\"flex items-center justify-between\">\n                    <div className=\"flex items-center space-x-1.5 text-xs font-semibold text-[#0D2C24] dark:text-emerald-400 bg-[#F5F2ED] dark:bg-slate-800 px-2 py-0.5 rounded-md border border-[#E8E5DF] dark:border-slate-700\">\n                      {getCategoryIcon(template.category)}\n                      <span>{template.category}</span>\n                    </div>\n\n                    <div className=\"flex items-center space-x-1.5\">\n                      <span\n                        className={`text-[10px] px-2 py-0.5 rounded-full font-bold uppercase ${\n                          template.status === \'PUBLISHED\'\n                            ? \'bg-emerald-50 text-emerald-800 border border-emerald-200 dark:bg-emerald-950 dark:text-emerald-300\'\n                            : template.status === \'REVIEW\'\n                            ? \'bg-amber-50 text-amber-800 border border-amber-200 dark:bg-amber-950 dark:text-amber-300\'\n                            : \'bg-slate-100 text-slate-700 border border-slate-200 dark:bg-slate-800 dark:text-slate-300\'\n                        }`}\n                      >\n                        {template.status === \'PUBLISHED\'\n                          ? \'Publicada\'\n                          : template.status === \'REVIEW\'\n                          ? \'En Revisi\303\263n\'\n                          : template.status === \'ARCHIVED\'\n                          ? \'Archivada\'\n                          : \'Borrador\'}\n                      </span>\n                    </div>\n                  </div>\n\n                  {/* Title & Description */}\n                  <div>\n                    <h3 className=\"font-bold text-slate-900 dark:text-white text-base font-serif line-clamp-1 group-hover:text-[#0D2C24] dark:group-hover:text-emerald-400 transition-colors\">\n                      {template.name}\n                    </h3>\n                    <p className=\"text-xs text-slate-500 dark:text-slate-400 line-clamp-2 mt-1 leading-relaxed\">\n                      {template.description || \'Sin descripci\303\263n jur\303\255dica proporcionada.\'}\n                    </p>\n                  </div>\n\n                  {/* Statistics Pill badges */}\n                  <div className=\"grid grid-cols-3 gap-2 pt-2 border-t border-slate-100 dark:border-slate-800 text-[11px] text-slate-600 dark:text-slate-300 text-center\">\n                    <div className=\"bg-[#F5F2ED]/60 dark:bg-slate-800 rounded-lg p-1.5 border border-[#E8E5DF] dark:border-slate-700\">\n                      <span className=\"block font-bold text-slate-800 dark:text-white\">{template.variables.length}</span>\n                      <span className=\"text-[10px] text-slate-400\">Variables</span>\n                    </div>\n                    <div className=\"bg-[#F5F2ED]/60 dark:bg-slate-800 rounded-lg p-1.5 border border-[#E8E5DF] dark:border-slate-700\">\n                      <span className=\"block font-bold text-slate-800 dark:text-white\">{template.clauses.length}</span>\n                      <span className=\"text-[10px] text-slate-400\">Cl\303\241usulas</span>\n                    </div>\n                    <div className=\"bg-[#F5F2ED]/60 dark:bg-slate-800 rounded-lg p-1.5 border border-[#E8E5DF] dark:border-slate-700\">\n                      <span className=\"block font-bold text-slate-800 dark:text-white\">{template.rules.length}</span>\n                      <span className=\"text-[10px] text-slate-400\">Reglas</span>\n                    </div>\n                  </div>\n\n                  {/* Health check pill */}\n                  <div className=\"flex items-center justify-between text-[11px] px-2.5 py-1.5 rounded-lg bg-[#F5F2ED]/50 dark:bg-slate-800 border border-[#E8E5DF] dark:border-slate-700\">\n                    <span className=\"text-slate-500 dark:text-slate-400 flex items-center space-x-1\">\n                      <ShieldCheck className=\"w-3.5 h-3.5 text-[#C5A059]\" />\n                      <span>Salud Estructural</span>\n                    </span>\n                    <span\n                      className={`font-semibold ${\n                        health.status === \'HEALTHY\'\n                          ? \'text-emerald-700 dark:text-emerald-400\'\n                          : health.status === \'WARNING\'\n                          ? \'text-amber-700 dark:text-amber-400\'\n                          : \'text-rose-700 dark:text-rose-400\'\n                      }`}\n                    >\n                      {health.score}% ({health.status})\n                    </span>\n                  </div>\n                </div>\n\n                {/* Card Action Footer */}\n                <div className=\"p-3 bg-[#F5F2ED]/40 dark:bg-slate-800/60 border-t border-[#E8E5DF] dark:border-slate-800 flex items-center justify-between\">\n                  <div className=\"flex items-center space-x-1\">\n                    <button\n                      onClick={() => duplicateTemplate(template.id)}\n                      className=\"p-1.5 text-slate-400 hover:text-[#0D2C24] dark:hover:text-white hover:bg-slate-200/60 dark:hover:bg-slate-700 rounded-md transition-colors cursor-pointer\"\n                      title=\"Duplicar Plantilla\"\n                    >\n                      <Copy className=\"w-4 h-4\" />\n                    </button>\n\n                    <button\n                      onClick={() => {\n                        if (confirm(`\302\277Est\303\241s seguro de eliminar la plantilla \"${template.name}\"?`)) {\n                          deleteTemplate(template.id);\n                        }\n                      }}\n                      className=\"p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-md transition-colors cursor-pointer\"\n                      title=\"Eliminar Plantilla\"\n                    >\n                      <Trash2 className=\"w-4 h-4\" />\n                    </button>\n                  </div>\n\n                  <div className=\"flex items-center space-x-2\">\n                    <button\n                      onClick={() => handleSelectTemplate(template, \'EDITOR\')}\n                      className=\"px-3 py-1.5 rounded-lg text-xs font-semibold text-[#0D2C24] dark:text-slate-200 hover:bg-[#E8E5DF] dark:hover:bg-slate-700 transition-colors cursor-pointer\"\n                    >\n                      Editar\n                    </button>\n\n                    <button\n                      onClick={() => handleSelectTemplate(template, \'FORM_GEN\')}\n                      className=\"px-3.5 py-1.5 rounded-lg text-xs font-bold bg-[#0D2C24] hover:bg-[#164E3E] text-white shadow-xs flex items-center space-x-1 transition-all cursor-pointer\"\n                    >\n                      <Play className=\"w-3 h-3 fill-current text-[#FDE8B5]\" />\n                      <span>Generar</span>\n                    </button>\n                  </div>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
