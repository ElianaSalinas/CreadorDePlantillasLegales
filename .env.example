# ============================================================
# Supabase — requerido por src/middleware.ts y src/utils/supabase/*
# Supabase Dashboard > tu proyecto > Project Settings > API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave de servicio (bypass de RLS). SOLO se usa en el servidor:
# panel de Super Admin y gestión de miembros del despacho.
# NUNCA importarla desde un archivo 'use client'.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# URL pública del sitio
# Se usa para construir los enlaces que viajan por correo
# (verificación de cuenta y recuperación de contraseña).
# En producción: https://savedocumentos.com
# Si se deja vacía, se deduce de las cabeceras de la petición.
# ============================================================
NEXT_PUBLIC_SITE_URL=

# ============================================================
# Puerto de escucha. Railway lo inyecta automáticamente;
# se declara aquí para desarrollo local.
# ============================================================
PORT=3000

# ============================================================
# Gemini — pendiente. Necesaria cuando se implemente la ruta
# /api/analyze-gemini que referencia src/core/detectorEngine.ts.
# ============================================================
GEMINI_API_KEY=

# ============================================================
# Correo saliente (Hostinger)
# NO se configura aquí: va en Supabase Dashboard >
# Authentication > SMTP Settings. Se documenta como referencia.
#   Host .......... smtp.hostinger.com
#   Puerto ........ 587  (STARTTLS)
#   Usuario ....... la dirección completa del buzón
#   Remitente ..... no-reply@savedocumentos.com
# ============================================================
