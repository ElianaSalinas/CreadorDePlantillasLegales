# Supabase — requerido por src/middleware.ts, src/utils/supabase/server.ts y src/utils/supabase/client.ts
# Obtén estos valores en: Supabase Dashboard > tu proyecto > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo necesaria si se implementa una ruta de servidor (Route Handler / Server Action)
# que use privilegios de administrador (bypass de RLS). NUNCA exponerla en código
# 'use client'. Hoy no se usa en ningún archivo del proyecto.
SUPABASE_SERVICE_ROLE_KEY=

# Necesaria solo cuando se implemente la ruta /api/analyze-gemini referenciada en
# src/core/detectorEngine.ts (hoy esa ruta no existe; la llamada hace fallback local).
GEMINI_API_KEY=
